# Пакет «библия» — чтение, выборка стихов и поиск по корпусу Синодальной Библии.
# Поддерживает загрузку массива книг формата:
#   [{"id": "gen", "name": "Бытие", "chapters": [["В начале...", ...], ...]}]
# а также словаря {"книги": [...]}.

открой образ Библия
    поля: книги, индекс_id, индекс_имя

    слово создать(списокКниг)
        это.книги = списокКниг
        это.индекс_id = {}
        это.индекс_имя = {}
        измени i = 0
        доколе i < длина(списокКниг)
            пусть к = списокКниг[i]
            пусть ид = нижний(строка(получить(к, "id", строка(i))))
            пусть имя = нижний(строка(получить(к, "name", получить(к, "имя", ид))))
            это.индекс_id[ид] = i
            это.индекс_имя[имя] = i
            i = i + 1
        конец
    конец

    # Список всех загруженных книг (id, имя, число_глав).
    слово список_книг()
        измени итог = []
        для к в это.книги
            пусть гл = получить(к, "chapters", получить(к, "главы", []))
            добавить(итог, {
                "id": получить(к, "id", ""),
                "имя": получить(к, "name", получить(к, "имя", "")),
                "глав": длина(гл),
            })
        конец
        аминь итог
    конец

    # Находит объект книги по id или русскому названию (без учёта регистра).
    слово книга(ключ)
        пусть норм = нижний(обрезать(строка(ключ)))
        пусть idx1 = получить(это.индекс_id, норм, ничего)
        если idx1 != ничего
            аминь это.книги[idx1]
        конец
        пусть idx2 = получить(это.индекс_имя, норм, ничего)
        если idx2 != ничего
            аминь это.книги[idx2]
        конец
        # Поиск по префиксу названия
        для к в это.книги
            пусть имя = нижний(строка(получить(к, "name", получить(к, "имя", ""))))
            если начинается_с(имя, норм)
                аминь к
            конец
        конец
        аминь ничего
    конец

    # Возвращает главу (нумерация с 1): массив стихов.
    слово глава(книгаКлюч, номерГлавы)
        пусть к = это.книга(книгаКлюч)
        если к == ничего
            аминь ничего
        конец
        пусть гл = получить(к, "chapters", получить(к, "главы", []))
        если номерГлавы < 1 или номерГлавы > длина(гл)
            аминь ничего
        конец
        аминь гл[номерГлавы - 1]
    конец

    # Возвращает один стих (нумерация главы и стиха с 1).
    слово стих(книгаКлюч, номерГлавы, номерСтиха)
        пусть гл = это.глава(книгаКлюч, номерГлавы)
        если гл == ничего
            аминь ничего
        конец
        если номерСтиха < 1 или номерСтиха > длина(гл)
            аминь ничего
        конец
        аминь гл[номерСтиха - 1]
    конец

    # Возвращает диапазон стихов [{стих, текст}].
    слово диапазон(книгаКлюч, номерГлавы, отСтиха, доСтиха)
        пусть гл = это.глава(книгаКлюч, номерГлавы)
        если гл == ничего
            аминь []
        конец
        измени итог = []
        измени i = отСтиха
        доколе i <= доСтиха
            если i >= 1 и i <= длина(гл)
                добавить(итог, {"стих": i, "текст": гл[i - 1]})
            конец
            i = i + 1
        конец
        аминь итог
    конец

    # Поиск подстроки по всему корпусу (без учёта регистра).
    слово искать(запрос, лимит = 20)
        пусть q = нижний(обрезать(строка(запрос)))
        если q == ""
            аминь []
        конец
        измени итог = []
        для к в это.книги
            пусть имя = получить(к, "name", получить(к, "имя", ""))
            пусть ид = получить(к, "id", "")
            пусть главы = получить(к, "chapters", получить(к, "главы", []))
            измени g = 0
            доколе g < длина(главы)
                пусть стихи = главы[g]
                измени v = 0
                доколе v < длина(стихи)
                    пусть текст = стихи[v]
                    если содержит(нижний(текст), q)
                        добавить(итог, {
                            "id": ид,
                            "книга": имя,
                            "глава": g + 1,
                            "стих": v + 1,
                            "текст": текст,
                        })
                        если длина(итог) >= лимит
                            аминь итог
                        конец
                    конец
                    v = v + 1
                конец
                g = g + 1
            конец
        конец
        аминь итог
    конец

    # Детерминированный «стих дня» по номеру дня (например, время.сейчас() / 86400).
    слово стих_дня(зерно)
        измени все = []
        для к в это.книги
            пусть имя = получить(к, "name", получить(к, "имя", ""))
            пусть главы = получить(к, "chapters", получить(к, "главы", []))
            измени g = 0
            доколе g < длина(главы)
                пусть стихи = главы[g]
                измени v = 0
                доколе v < длина(стихи)
                    добавить(все, {"книга": имя, "глава": g + 1, "стих": v + 1, "текст": стихи[v]})
                    v = v + 1
                конец
                g = g + 1
            конец
        конец
        если длина(все) == 0
            аминь ничего
        конец
        пусть idx = абс(зерно) % длина(все)
        аминь все[idx]
    конец
конец

# Загружает корпус Библии из JSON-файла.
открой слово из_файла(путь)
    пусть текст = файлы.прочитать(путь)
    пусть данные = json.разобрать(текст)
    если тип(данные) == "СЛОВАРЬ"
        пусть сп = получить(данные, "книги", получить(данные, "books", []))
        аминь новый Библия(сп)
    конец
    аминь новый Библия(данные)
конец

# Создаёт объект Библия из массива книг в памяти.
открой слово из_списка(книги)
    аминь новый Библия(книги)
конец

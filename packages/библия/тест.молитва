приими биб из "./главный.молитва"

тест "чтение стихов, диапазонов, поиск и стих дня"
    пусть б = биб.из_списка([
        {
            "id": "gen",
            "name": "Бытие",
            "chapters": [
                [
                    "В начале сотворил Бог небо и землю.",
                    "Земля же была безвидна и пуста, и тьма над бездною.",
                    "И сказал Бог: да будет свет. И стал свет."
                ]
            ]
        },
        {
            "id": "jhn",
            "name": "От Иоанна",
            "chapters": [
                [
                    "В начале было Слово, и Слово было у Бога, и Слово было Бог."
                ]
            ]
        }
    ])

    проверить(длина(б.список_книг()) == 2)
    проверить(содержит(б.стих("gen", 1, 1), "сотворил Бог"))
    проверить(содержит(б.стих("Бытие", 1, 3), "да будет свет"))

    пусть диап = б.диапазон("gen", 1, 1, 2)
    проверить(длина(диап) == 2)

    пусть найд = б.искать("в начале")
    проверить(длина(найд) == 2)

    пусть д1 = б.стих_дня(100)
    пусть д2 = б.стих_дня(100)
    проверить(д1["текст"] == д2["текст"])
конец

приими сессии из "./главный.молитва"

тест "подпись куки и защита от подделки"
    пусть кука = сессии.подписать_ид("abc123", "тайна")
    проверить(сессии.проверить_подпись(кука, "тайна") == "abc123")
    проверить(сессии.проверить_подпись(кука, "другой") == ничего)
    проверить(сессии.проверить_подпись("abc123.подделка", "тайна") == ничего)
конец

тест "TTL, истечение и очистка в памяти"
    измени тик = 1000
    пусть м = сессии.создать({
        "секрет": "к1",
        "ttl": 60,
        "часы": слово(): тик,
    })
    пусть с = м.создать_сессию({"пользователь": "Иван"})
    проверить(м.загрузить(с["кука"])["данные"]["пользователь"] == "Иван")

    тик = 1070
    проверить(м.загрузить(с["кука"]) == ничего)
    проверить(м.очистить_просроченные() == 0)
конец

тест "хранилище SQLite и flash-сообщения"
    пусть хр = сессии.ХранилищеБд(":memory:")
    пусть м = сессии.создать({"секрет": "к2", "хранилище": хр, "ttl": 300})
    пусть с = м.создать_сессию({"роль": "админ"})
    м.добавить_флеш(с["данные"], "успех", "Сохранено")
    м.сохранить(с["sid"], с["данные"])

    пусть загр = м.загрузить(с["кука"])
    проверить(загр["данные"]["роль"] == "админ")
    пусть флеш = м.забрать_флеш(загр["данные"])
    проверить(длина(флеш) == 1)
    проверить(флеш[0]["текст"] == "Сохранено")
    проверить(длина(м.забрать_флеш(загр["данные"])) == 0)
    хр.закрыть()
конец

тест "middleware в веб.приложение"
    пусть app = веб.приложение()
    пусть м = сессии.создать({"секрет": "веб-ключ"})
    app.использовать(м.middleware())

    app.пост("/login", слово(запрос)
        запрос["сессия"]["user"] = "Аня"
        аминь веб.json({"ок": истина})
    конец)

    app.получить("/me", слово(запрос)
        аминь веб.json({"user": получить(запрос["сессия"], "user", ничего)})
    конец)

    пусть r1 = app.обработать("POST", "/login")
    пусть setCookie = r1["заголовки"]["Set-Cookie"]
    проверить(содержит(setCookie, "zavet_sid="))
    пусть параКуки = разделить(setCookie, ";")[0]

    пусть r2 = app.обработать("GET", "/me", "", {"Cookie": параКуки})
    проверить(json.разобрать(r2["тело"])["user"] == "Аня")

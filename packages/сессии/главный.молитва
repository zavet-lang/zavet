# Пакет «сессии» — cookie-сессии для веб-приложений Завета.
# Поддерживает подпись ID через HMAC-SHA256, хранение в памяти или SQLite (бд),
# скользящее продление TTL, flash-сообщения и middleware для модуля «веб».

# Разбирает заголовок Cookie в словарь {имя: значение}.
открой слово разобрать_куки(заголовокКуки)
    измени итог = {}
    если заголовокКуки == ничего
        аминь итог
    конец
    если обрезать(заголовокКуки) == ""
        аминь итог
    конец
    пусть пары = разделить(заголовокКуки, ";")
    для пара в пары
        пусть ч = обрезать(пара)
        пусть поз = найти(ч, "=")
        если поз > 0
            пусть к = обрезать(подстрока(ч, 0, поз))
            пусть з = обрезать(подстрока(ч, поз + 1, длина(ч)))
            итог[к] = з
        конец
    конец
    аминь итог
конец

# Генерирует идентификатор сессии (hex 32 символа).
слово новый_ид(счётчик)
    пусть основа = строка(время.метка()) + ":" + строка(счётчик) + ":" + строка(случайное.целое(100000, 999999)) + ":" + строка(случайное.целое(100000, 999999))
    аминь подстрока(крипто.sha256(основа), 0, 32)
конец

# Подписывает идентификатор: "<sid>.<hmac>".
открой слово подписать_ид(sid, секрет)
    пусть подпись = подстрока(крипто.hmac_sha256(sid, секрет), 0, 32)
    аминь sid + "." + подпись
конец

# Проверяет подписанную куку; возвращает sid или ничего.
открой слово проверить_подпись(значение, секрет)
    если значение == ничего
        аминь ничего
    конец
    если не содержит(значение, ".")
        аминь ничего
    конец
    пусть части = разделить(значение, ".")
    если длина(части) != 2
        аминь ничего
    конец
    пусть sid = части[0]
    пусть подпись = части[1]
    пусть ожидаемая = подстрока(крипто.hmac_sha256(sid, секрет), 0, 32)
    если подпись == ожидаемая
        аминь sid
    конец
    аминь ничего
конец

# Хранилище сессий в оперативной памяти.
открой образ ХранилищеПамяти
    слово создать()
        это._записи = {}
    конец

    слово получить(sid, сейчасСек)
        пусть зап = получить(это._записи, sid, ничего)
        если зап == ничего
            аминь ничего
        конец
        если зап["истекает"] <= сейчасСек
            это._записи[sid] = ничего
            аминь ничего
        конец
        аминь зап["данные"]
    конец

    слово сохранить(sid, данные, истекаетСек)
        это._записи[sid] = {"данные": данные, "истекает": истекаетСек}
    конец

    слово удалить(sid)
        это._записи[sid] = ничего
    конец

    слово очистить_просроченные(сейчасСек)
        измени удалено = 0
        измени новые = {}
        для к в ключи(это._записи)
            пусть зап = это._записи[к]
            если зап == ничего
                продолжи
            конец
            если зап["истекает"] <= сейчасСек
                удалено = удалено + 1
            иначе
                новые[к] = зап
            конец
        конец
        это._записи = новые
        аминь удалено
    конец

    слово всего()
        измени сч = 0
        для к в ключи(это._записи)
            если это._записи[к] != ничего
                сч = сч + 1
            конец
        конец
        аминь сч
    конец
конец

# Хранилище сессий в SQLite (передайте ":memory:" для тестов или путь к файлу).
открой образ ХранилищеБд
    слово создать(путьБд = ":memory:")
        это.соединение = бд.открыть(путьБд)
        это.соединение.выполнить("CREATE TABLE IF NOT EXISTS sessions (sid TEXT PRIMARY KEY, payload TEXT NOT NULL, expires_at INTEGER NOT NULL)")
    конец

    слово получить(sid, сейчасСек)
        пусть строки = это.соединение.запрос("SELECT payload, expires_at FROM sessions WHERE sid = ?", sid)
        если длина(строки) == 0
            аминь ничего
        конец
        пусть строкаБд = строки[0]
        если строкаБд["expires_at"] <= сейчасСек
            это.удалить(sid)
            аминь ничего
        конец
        аминь json.разобрать(строкаБд["payload"])
    конец

    слово сохранить(sid, данные, истекаетСек)
        пусть тело = json.создать(данные)
        это.соединение.выполнить("INSERT OR REPLACE INTO sessions (sid, payload, expires_at) VALUES (?, ?, ?)", sid, тело, истекаетСек)
    конец

    слово удалить(sid)
        это.соединение.выполнить("DELETE FROM sessions WHERE sid = ?", sid)
    конец

    слово очистить_просроченные(сейчасСек)
        пусть было = это.всего()
        это.соединение.выполнить("DELETE FROM sessions WHERE expires_at <= ?", сейчасСек)
        аминь было - это.всего()
    конец

    слово всего()
        пусть строки = это.соединение.запрос("SELECT COUNT(*) AS cnt FROM sessions")
        аминь строки[0]["cnt"]
    конец

    слово закрыть()
        это.соединение.закрыть()
    конец
конец

# Менеджер cookie-сессий.
открой образ МенеджерСессий
    слово создать(опции = ничего)
        пусть оп = опции ?? {}
        это.секрет = получить(оп, "секрет", "zavet-default-secret")
        это.имя_куки = получить(оп, "имя_куки", "zavet_sid")
        это.ttl = получить(оп, "ttl", 3600)
        это.продлевать = получить(оп, "продлевать", истина)
        это.путь = получить(оп, "путь", "/")
        это.http_only = получить(оп, "http_only", истина)
        это.хранилище = получить(оп, "хранилище", ничего)
        если это.хранилище == ничего
            это.хранилище = ХранилищеПамяти()
        конец
        это._часы = получить(оп, "часы", слово(): время.сейчас())
        это._счётчик = 0
    конец

    слово _сейчас()
        аминь это._часы()
    конец

    слово создать_сессию(начальныеДанные = ничего)
        это._счётчик = это._счётчик + 1
        пусть sid = новый_ид(это._счётчик)
        пусть данные = начальныеДанные ?? {}
        это.хранилище.сохранить(sid, данные, это._сейчас() + это.ttl)
        аминь {"sid": sid, "кука": подписать_ид(sid, это.секрет), "данные": данные}
    конец

    слово загрузить(значениеКуки)
        пусть sid = проверить_подпись(значениеКуки, это.секрет)
        если sid == ничего
            аминь ничего
        конец
        пусть данные = это.хранилище.получить(sid, это._сейчас())
        если данные == ничего
            аминь ничего
        конец
        аминь {"sid": sid, "данные": данные}
    конец

    слово сохранить(sid, данные)
        это.хранилище.сохранить(sid, данные, это._сейчас() + это.ttl)
    конец

    слово удалить(sid)
        это.хранилище.удалить(sid)
    конец

    слово очистить_просроченные()
        аминь это.хранилище.очистить_просроченные(это._сейчас())
    конец

    # Flash-сообщения (одноразовые уведомления в сессии).
    слово добавить_флеш(данныеСессии, типСооб, текст)
        пусть флеш = получить(данныеСессии, "_флеш", [])
        добавить(флеш, {"тип": типСооб, "текст": текст})
        данныеСессии["_флеш"] = флеш
    конец

    слово забрать_флеш(данныеСессии)
        пусть флеш = получить(данныеСессии, "_флеш", [])
        данныеСессии["_флеш"] = []
        аминь флеш
    конец

    # Middleware для веб.приложение().
    # Кладёт словарь сессии в запрос["сессия"] и флаг запрос["удалить_сессию"] = ложь.
    слово middleware()
        пусть менеджер = это
        аминь слово(запрос, далее)
            пусть заголовки = получить(запрос, "заголовки", {})
            пусть строкаКуки = получить(заголовки, "Cookie", получить(заголовки, "cookie", ""))
            пусть куки = разобрать_куки(строкаКуки)
            пусть сыроеЗнач = получить(куки, менеджер.имя_куки, ничего)

            измени текущая = менеджер.загрузить(сыроеЗнач)
            измени sid = если текущая != ничего: текущая["sid"] иначе: ничего
            измени данные = если текущая != ничего: текущая["данные"] иначе: {}
            пусть снимокДо = json.создать(данные)

            запрос["сессия"] = данные
            запрос["сессия_ид"] = sid
            запрос["удалить_сессию"] = ложь

            пусть ответ = далее()

            если запрос["удалить_сессию"] == истина
                если sid != ничего
                    менеджер.удалить(sid)
                конец
                веб.кука(ответ, менеджер.имя_куки, "", {"макс_возраст": 0, "путь": менеджер.путь})
                аминь ответ
            конец

            пусть снимокПосле = json.создать(запрос["сессия"])
            пусть изменилась = снимокДо != снимокПосле
            если изменилась или (sid != ничего и менеджер.продлевать)
                если sid == ничего
                    менеджер._счётчик = менеджер._счётчик + 1
                    sid = новый_ид(менеджер._счётчик)
                конец
                менеджер.сохранить(sid, запрос["сессия"])
                пусть подписанная = подписать_ид(sid, менеджер.секрет)
                веб.кука(ответ, менеджер.имя_куки, подписанная, {
                    "путь": менеджер.путь,
                    "макс_возраст": менеджер.ttl,
                    "http_only": менеджер.http_only,
                })
            конец

            аминь ответ
        конец
    конец
конец

открой слово создать(опции = ничего)
    аминь МенеджерСессий(опции)
конец

приими таблицы из "./главный.молитва"

тест "фильтрация, сортировка, группировка, join и CSV"
    пусть продажи = таблицы.создать([
        {"отдел": "Книги", "товар": "Псалтирь", "сумма": 500},
        {"отдел": "Книги", "товар": "Евангелие", "сумма": 700},
        {"отдел": "Свечи", "товар": "Восковая", "сумма": 100},
    ], ["отдел", "товар", "сумма"])

    пусть дорогие = продажи.фильтровать(слово(с): с["сумма"] >= 500).сортировать("сумма", истина)
    проверить(дорогие.количество() == 2)
    проверить(дорогие.строки[0]["товар"] == "Евангелие")
    проверить(дорогие.сумма("сумма") == 1200)

    пусть свод = продажи.группировать("отдел", {
        "всего": ["сумма", "сумма"],
        "шт": ["колво", "*"],
    })
    проверить(свод.количество() == 2)
    проверить(свод.строки[0]["всего"] == 1200)
    проверить(свод.строки[0]["шт"] == 2)

    пусть отделы = таблицы.создать([
        {"отдел": "Книги", "этаж": 1},
        {"отдел": "Свечи", "этаж": 2},
    ])
    пусть объед = свод.соединить(отделы, "отдел")
    проверить(объед.строки[0]["этаж"] == 1)

    пусть csvТекст = дорогие.в_csv()
    проверить(содержит(csvТекст, "Евангелие"))
    проверить(содержит(дорогие.форматировать(), "| отдел"))
конец

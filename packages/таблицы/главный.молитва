# Пакет «таблицы» — табличные данные в памяти (DataFrame-стиль):
# выбор колонок, фильтрация, сортировка, группировка, агрегации, join, экспорт в CSV и ASCII-таблицу.

слово дополнить_справа(текст, ширина)
    измени s = строка(текст)
    доколе длина(s) < ширина
        s = s + " "
    конец
    аминь s
конец

открой образ Таблица
    слово создать(строки, колонки = ничего)
        это.строки = строки ?? []
        если колонки != ничего
            это.колонки = колонки
        иначеесли длина(это.строки) > 0
            это.колонки = ключи(это.строки[0])
        иначе
            это.колонки = []
        конец
    конец

    слово количество()
        аминь длина(это.строки)
    конец

    слово выбрать(списокКолонок)
        измени новые = []
        для с в это.строки
            измени зап = {}
            для к в списокКолонок
                зап[к] = получить(с, к, ничего)
            конец
            добавить(новые, зап)
        конец
        аминь Таблица(новые, списокКолонок)
    конец

    слово фильтровать(предикат)
        измени новые = []
        для с в это.строки
            если предикат(с)
                добавить(новые, с)
            конец
        конец
        аминь Таблица(новые, это.колонки)
    конец

    слово сортировать(колонка, убывание = ложь)
        пусть отсорт = сортировать(это.строки, слово(а, б)
            пусть ва = получить(а, колонка, 0)
            пусть вб = получить(б, колонка, 0)
            аминь если убывание: ва < вб иначе: ва > вб
        конец)
        аминь Таблица(отсорт, это.колонки)
    конец

    слово сумма(колонка)
        измени s = 0
        для с в это.строки
            пусть з = получить(с, колонка, ничего)
            если з != ничего
                s = s + з
            конец
        конец
        аминь s
    конец

    слово среднее(колонка)
        если длина(это.строки) == 0
            аминь 0
        конец
        аминь (это.сумма(колонка) * 1.0) / (длина(это.строки) * 1.0)
    конец

    # Группирует строки по колонке и считает агрегаты:
    # агрегаты = {"сумма_продаж": ["сумма", "цена"], "колво": ["колво", "*"], "ср": ["среднее", "цена"]}
    слово группировать(колонка, агрегаты)
        измени группы = {}
        измени порядокКлючей = []
        для с в это.строки
            пусть к = строка(получить(с, колонка, ""))
            если получить(группы, к, ничего) == ничего
                группы[к] = []
                добавить(порядокКлючей, к)
            конец
            добавить(группы[к], с)
        конец

        измени резСтроки = []
        измени резКол = [колонка]
        для имяАг в ключи(агрегаты)
            добавить(резКол, имяАг)
        конец

        для к в порядокКлючей
            пусть подТабл = Таблица(группы[к], это.колонки)
            измени зап = {}
            зап[колонка] = к
            для имяАг в ключи(агрегаты)
                пусть оп = агрегаты[имяАг][0]
                пусть поле = агрегаты[имяАг][1]
                если оп == "колво"
                    зап[имяАг] = подТабл.количество()
                иначеесли оп == "сумма"
                    зап[имяАг] = подТабл.сумма(поле)
                иначеесли оп == "среднее"
                    зап[имяАг] = подТабл.среднее(поле)
                иначеесли оп == "мин"
                    измени м = получить(группы[к][0], поле, 0)
                    для с в группы[к]
                        если получить(с, поле, 0) < м
                            м = получить(с, поле, 0)
                        конец
                    конец
                    зап[имяАг] = м
                иначеесли оп == "макс"
                    измени м = получить(группы[к][0], поле, 0)
                    для с в группы[к]
                        если получить(с, поле, 0) > м
                            м = получить(с, поле, 0)
                        конец
                    конец
                    зап[имяАг] = м
                конец
            конец
            добавить(резСтроки, зап)
        конец
        аминь Таблица(резСтроки, резКол)
    конец

    # Внутреннее соединение (inner join) с другой таблицей по ключу.
    слово соединить(другая, ключЛево, ключПраво = ничего)
        пусть кПрав = ключПраво ?? ключЛево
        измени индексПрав = {}
        для п в другая.строки
            пусть к = строка(получить(п, кПрав, ""))
            пусть список = получить(индексПрав, к, [])
            добавить(список, п)
            индексПрав[к] = список
        конец

        измени новые = []
        для л в это.строки
            пусть к = строка(получить(л, ключЛево, ""))
            пусть совп = получить(индексПрав, к, [])
            для п в совп
                измени зап = {}
                для кол в ключи(л)
                    зап[кол] = л[кол]
                конец
                для кол в ключи(п)
                    если получить(зап, кол, ничего) == ничего
                        зап[кол] = п[кол]
                    конец
                конец
                добавить(новые, зап)
            конец
        конец
        аминь Таблица(новые)
    конец

    слово в_csv()
        измени мас = [это.колонки]
        для с в это.строки
            измени р = []
            для к в это.колонки
                пусть з = получить(с, к, "")
                добавить(р, если з == ничего: "" иначе: строка(з))
            конец
            добавить(мас, р)
        конец
        аминь csv.строка(мас)
    конец

    слово форматировать()
        измени ширины = {}
        для к в это.колонки
            ширины[к] = длина(строка(к))
        конец
        для с в это.строки
            для к в это.колонки
                пусть д = длина(строка(получить(с, к, "")))
                если д > ширины[к]
                    ширины[к] = д
                конец
            конец
        конец

        измени шапка = []
        измени разд = []
        для к в это.колонки
            добавить(шапка, дополнить_справа(к, ширины[к]))
            добавить(разд, повторить("-", ширины[к]))
        конец

        измени линии = [
            "| " + соединить(шапка, " | ") + " |",
            "|-" + соединить(разд, "-|-") + "-|",
        ]
        для с в это.строки
            измени яч = []
            для к в это.колонки
                добавить(яч, дополнить_справа(получить(с, к, ""), ширины[к]))
            конец
            добавить(линии, "| " + соединить(яч, " | ") + " |")
        конец
        аминь соединить(линии, "\n")
    конец
конец

открой слово создать(строки, колонки = ничего)
    аминь Таблица(строки, колонки)
конец

открой слово из_csv(текст)
    пусть строки = csv.с_заголовками(текст)
    аминь Таблица(строки)
конец

приими рис из "./главный.молитва"

тест "генерация SVG-холста с фигурами и экранированным текстом"
    пусть х = рис.холст(200, 100, "#ffffff")
    х.прямоугольник(10, 10, 80, 40, "#2563eb", "none", 6)
    х.круг(150, 50, 25, "#10b981")
    х.линия(0, 90, 200, 90, "#000000", 2)
    х.текст(100, 25, "Завет <SVG>", 14, "#111", "middle")

    пусть svg = х.в_svg()
    проверить(начинается_с(svg, "<svg "))
    проверить(содержит(svg, "<circle cx=\"150\""))
    проверить(содержит(svg, "Завет &lt;SVG&gt;"))
    проверить(заканчивается_на(svg, "</svg>"))
конец

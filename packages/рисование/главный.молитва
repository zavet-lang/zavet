# Пакет «рисование» — декларативный генератор SVG-графики (примитивы, текст, столбиковые диаграммы).

открой образ Холст
    поля: ширина, высота, элементы

    слово создать(ширина = 400, высота = 300, фон = ничего)
        это.ширина = ширина
        это.высота = высота
        это.элементы = []
        если фон != ничего
            это.прямоугольник(0, 0, ширина, высота, фон)
        конец
    конец

    слово прямоугольник(x, y, w, h, заливка = "#2563eb", обводка = "none", радиус = 0)
        пусть rx = если радиус > 0: " rx=\"" + строка(радиус) + "\"" иначе: ""
        добавить(это.элементы, "<rect x=\"" + строка(x) + "\" y=\"" + строка(y) + "\" width=\"" + строка(w) + "\" height=\"" + строка(h) + "\" fill=\"" + заливка + "\" stroke=\"" + обводка + "\"" + rx + "/>")
        аминь это
    конец

    слово круг(cx, cy, r, заливка = "#ef4444", обводка = "none")
        добавить(это.элементы, "<circle cx=\"" + строка(cx) + "\" cy=\"" + строка(cy) + "\" r=\"" + строка(r) + "\" fill=\"" + заливка + "\" stroke=\"" + обводка + "\"/>")
        аминь это
    конец

    слово линия(x1, y1, x2, y2, цвет = "#111827", толщина = 2)
        добавить(это.элементы, "<line x1=\"" + строка(x1) + "\" y1=\"" + строка(y1) + "\" x2=\"" + строка(x2) + "\" y2=\"" + строка(y2) + "\" stroke=\"" + цвет + "\" stroke-width=\"" + строка(толщина) + "\"/>")
        аминь это
    конец

    слово текст(x, y, содерж, размер = 16, цвет = "#111827", якорь = "start")
        пусть безоп = шаблон.экранировать(строка(содерж))
        добавить(это.элементы, "<text x=\"" + строка(x) + "\" y=\"" + строка(y) + "\" font-size=\"" + строка(размер) + "\" fill=\"" + цвет + "\" text-anchor=\"" + якорь + "\" font-family=\"sans-serif\">" + безоп + "</text>")
        аминь это
    конец

    слово в_svg()
        аминь "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + строка(это.ширина) + "\" height=\"" + строка(это.высота) + "\" viewBox=\"0 0 " + строка(это.ширина) + " " + строка(это.высота) + "\">\n" +
            соединить(это.элементы, "\n") + "\n</svg>"
    конец
конец

открой слово холст(ширина = 400, высота = 300, фон = ничего)
    аминь новый Холст(ширина, высота, фон)
конец

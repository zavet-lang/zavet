# Пакет «часовые-пояса» — смещения поясов РФ/мира, перевод Unix-времени в календарь и ISO-8601.

пусть ПОЯСА = {
    "UTC": 0, "GMT": 0, "Europe/London": 0,
    "CET": 60, "Europe/Berlin": 60, "Europe/Paris": 60,
    "КЛД": 120, "Europe/Kaliningrad": 120,
    "МСК": 180, "MSK": 180, "Europe/Moscow": 180,
    "САМ": 240, "Europe/Samara": 240,
    "ЕКБ": 300, "Asia/Yekaterinburg": 300,
    "ОМСК": 360, "Asia/Omsk": 360,
    "НСК": 420, "Asia/Novosibirsk": 420, "Asia/Krasnoyarsk": 420,
    "ИРК": 480, "Asia/Irkutsk": 480,
    "ЯКТ": 540, "Asia/Yakutsk": 540, "Asia/Tokyo": 540, "JST": 540,
    "ВЛД": 600, "Asia/Vladivostok": 600,
    "МАГ": 660, "Asia/Magadan": 660,
    "КАМ": 720, "Asia/Kamchatka": 720,
    "EST": -300, "America/New_York": -300,
    "PST": -480, "America/Los_Angeles": -480,
}

# Возвращает смещение пояса в минутах относительно UTC.
открой слово смещение_минут(пояс)
    пусть v = получить(ПОЯСА, пояс, ничего)
    если v == ничего
        бросить("неизвестный часовой пояс: " + строка(пояс))
    конец
    аминь v
конец

слово ц2(n)
    аминь если n < 10: "0" + строка(n) иначе: строка(n)
конец

# Переводит Unix-время (секунды) в календарные компоненты по алгоритму Говарда Хиннанта.
открой слово из_unix(секунды, пояс = "МСК")
    пусть смещ = смещение_минут(пояс)
    пусть лок = секунды + смещ * 60
    измени ост = лок % 86400
    если ост < 0
        ост = ост + 86400
    конец
    пусть дней = (лок - ост) / 86400

    пусть час = (ост - (ост % 3600)) / 3600
    пусть остЧ = ост % 3600
    пусть мин = (остЧ - (остЧ % 60)) / 60
    пусть сек = остЧ % 60

    # Civil from days (1970-01-01 = 0)
    пусть z = дней + 719468
    пусть z2 = если z >= 0: z иначе: z - 146096
    пусть era = (z2 - (z2 % 146097)) / 146097
    пусть doe = z - era * 146097
    пусть yoe = (doe - (doe - (doe % 1460)) / 1460 + (doe - (doe % 36524)) / 36524 - (doe - (doe % 146096)) / 146096)
    пусть yoe2 = (yoe - (yoe % 365)) / 365
    измени год = yoe2 + era * 400
    пусть doy = doe - (365 * yoe2 + (yoe2 - (yoe2 % 4)) / 4 - (yoe2 - (yoe2 % 100)) / 100)
    пусть mp = ((5 * doy + 2) - ((5 * doy + 2) % 153)) / 153
    пусть день = doy - ((153 * mp + 2) - ((153 * mp + 2) % 5)) / 5 + 1
    пусть месяц = если mp < 10: mp + 3 иначе: mp - 9
    если месяц <= 2
        год = год + 1
    конец

    аминь {
        "год": год, "месяц": месяц, "день": день,
        "час": час, "минута": мин, "секунда": сек,
        "смещение_мин": смещ, "пояс": пояс,
    }
конец

# Форматирует Unix-время в ISO-8601 с учётом смещения пояса ("2026-01-01T03:00:00+03:00").
открой слово в_iso(секунды, пояс = "МСК")
    пусть д = из_unix(секунды, пояс)
    пусть см = д["смещение_мин"]
    пусть знак = если см < 0: "-" иначе: "+"
    пусть абсСм = абс(см)
    пусть оЧ = (абсСм - (абсСм % 60)) / 60
    пусть оМ = абсСм % 60
    пусть хвост = если см == 0: "Z" иначе: знак + ц2(оЧ) + ":" + ц2(оМ)
    аминь строка(д["год"]) + "-" + ц2(д["месяц"]) + "-" + ц2(д["день"]) + "T" +
        ц2(д["час"]) + ":" + ц2(д["минута"]) + ":" + ц2(д["секунда"]) + хвост
конец

приими слова из "./главный.молитва"

тест "подсчёт слов, предложений, обрезка и частотность"
    пусть т = "В начале было Слово. И Слово было у Бога! И Слово было Бог."
    пусть ст = слова.статистика(т)
    проверить(ст["слов"] == 13)
    проверить(ст["предложений"] == 3)
    проверить(ст["минут_чтения"] == 1)

    пусть обр = слова.обрезать_по_словам("Язык программирования Завет на русском", 25)
    проверить(длина(обр) <= 25)
    проверить(заканчивается_на(обр, "…"))

    пусть топ = слова.частотный_словарь(т, 2)
    проверить(топ[0]["слово"] == "слово" или топ[0]["слово"] == "было")
    проверить(топ[0]["колво"] == 3)
конец

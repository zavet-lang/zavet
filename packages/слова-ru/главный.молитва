# Пакет «слова-ru» — статистика и обработка русского текста.

# Схлопывает подряд идущие пробелы и переводы строк в один пробел.
открой слово нормализовать_пробелы(текст)
    если текст == ничего
        аминь ""
    конец
    аминь обрезать(регвыр.заменить(строка(текст), '\s+', " "))
конец

# Возвращает массив слов текста (без знаков препинания).
открой слово слова(текст)
    если текст == ничего
        аминь []
    конец
    пусть чист = нормализовать_пробелы(регвыр.заменить(строка(текст), '[^a-zA-Zа-яА-ЯёЁ0-9-]+', " "))
    если чист == ""
        аминь []
    конец
    аминь разделить(чист, " ")
конец

открой слово количество_слов(текст)
    аминь длина(слова(текст))
конец

# Подсчёт предложений по знакам . ! ? …
открой слово количество_предложений(текст)
    если текст == ничего
        аминь 0
    конец
    пусть части = разделить(регвыр.заменить(строка(текст), '[.!?…]+', "|"), "|")
    измени сч = 0
    для ч в части
        если обрезать(ч) != ""
            сч = сч + 1
        конец
    конец
    аминь сч
конец

# Оценка времени чтения в минутах (по умолчанию 180 слов/мин для русского языка).
открой слово время_чтения_мин(текст, словВМинуту = 180)
    пусть n = количество_слов(текст)
    если n == 0
        аминь 0
    конец
    пусть м = мат.потолок((n * 1.0) / (словВМинуту * 1.0))
    аминь если м < 1: 1 иначе: м
конец

# Аккуратная обрезка текста до maxДлина символов по границе слова.
открой слово обрезать_по_словам(текст, максДлина, окончание = "…")
    пусть s = нормализовать_пробелы(текст)
    если длина(s) <= максДлина
        аминь s
    конец
    пусть список = разделить(s, " ")
    измени рез = ""
    для с в список
        пусть канд = если рез == "": с иначе: рез + " " + с
        если длина(канд) + длина(окончание) > максДлина
            прерви
        конец
        рез = канд
    конец
    если рез == ""
        аминь подстрока(s, 0, макс(1, максДлина - длина(окончание))) + окончание
    конец
    аминь рез + окончание
конец

# Топ-N самых частых слов в тексте (массив {"слово", "раз"}).
открой слово частотный_словарь(текст, лимит = 10)
    пусть список = слова(текст)
    измени счёт = {}
    для w в список
        пусть н = нижний(w)
        если длина(н) < 2
            продолжи
        конец
        счёт[н] = получить(счёт, н, 0) + 1
    конец
    измени пары = []
    для к в ключи(счёт)
        добавить(пары, {"слово": к, "колво": счёт[к]})
    конец
    пусть отсорт = сортировать(пары, слово(а, б): а["колво"] < б["колво"])
    если длина(отсорт) > лимит
        измени итог = []
        измени i = 0
        доколе i < лимит
            добавить(итог, отсорт[i])
            i = i + 1
        конец
        аминь итог
    конец
    аминь отсорт
конец

# Полная сводка по тексту.
открой слово статистика(текст)
    пусть s = строка(текст ?? "")
    аминь {
        "символов": длина(s),
        "символов_без_пробелов": длина(регвыр.заменить(s, '\s+', "")),
        "слов": количество_слов(s),
        "предложений": количество_предложений(s),
        "минут_чтения": время_чтения_мин(s),
    }
конец

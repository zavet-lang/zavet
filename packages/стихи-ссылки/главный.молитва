# Находит книгу по сокращению или названию.
открой слово найти_книгу(название)
    если название == ничего
        аминь ничего
    конец
    пусть норм = обрезать(регвыр.заменить(нижний(заменить(строка(название), ".", "")), '\s+', " "))
    для к в КНИГИ
        для син в к["синонимы"]
            если норм == син
                аминь {"код": к["код"], "имя": к["имя"]}
            конец
        конец
    конец
    аминь ничего
конец

# Разбирает строку ссылки вида "Ин 3:16", "Быт 1:1-5", "1 Кор 13:4-7", "Пс 22".
открой слово разобрать(ссылка)
    если ссылка == ничего
        аминь {"ок": ложь, "ошибка": "пустая ссылка"}
    конец
    пусть s = обрезать(регвыр.заменить(строка(ссылка), '\s+', " "))
    пусть части = разделить(s, " ")
    если длина(части) < 2
        аминь {"ок": ложь, "ошибка": "неверный формат ссылки"}
    конец

    пусть номерЧасть = части[длина(части) - 1]
    измени книгаЧасти = []
    измени i = 0
    доколе i < длина(части) - 1
        добавить(книгаЧасти, части[i])
        i = i + 1
    конец
    пусть книгаСтрока = соединить(книгаЧасти, " ")
    пусть книга = найти_книгу(книгаСтрока)
    если книга == ничего
        аминь {"ок": ложь, "ошибка": "неизвестная книга: " + книгаСтрока}
    конец

    # Разбор глава[:стих[-конец]]
    пусть разд = разделить(номерЧасть, ":")
    если не регвыр.совпадает(разд[0], '^[0-9]+$')
        аминь {"ок": ложь, "ошибка": "некорректный номер главы"}
    конец
    пусть глава = число(разд[0])
    измени стихНач = ничего
    измени стихКон = ничего

    если длина(разд) == 2
        пусть диап = разделить(разд[1], "-")
        если not_digits(диап[0])
            аминь {"ок": ложь, "ошибка": "некорректный номер стиха"}
        конец
        стихНач = число(диап[0])
        если длина(диап) == 2
            если not_digits(диап[1])
                аминь {"ок": ложь, "ошибка": "некорректный конец диапазона стихов"}
            конец
            стихКон = число(диап[1])
        иначе
            стихКон = стихНач
        конец
    конец

    аминь {
        "ок": истина,
        "код": книга["код"],
        "книга": книга["имя"],
        "глава": глава,
        "стих_от": стихНач,
        "стих_до": стихКон,
    }
конец

слово not_digits(s)
    аминь не регвыр.совпадает(s, '^[0-9]+$')
конец

# Форматирует разобранную ссылку в канонический вид ("От Иоанна 3:16" или "Ин 3:16-18").
открой слово форматировать(разбор, коротко = ложь)
    пусть назв = если коротко: разбор["код"] иначе: разбор["книга"]
    измени итог = назв + " " + строка(разбор["глава"])
    если разбор["стих_от"] != ничего
        итог = итог + ":" + строка(разбор["стих_от"])
        если разбор["стих_до"] != ничего
            если разбор["стих_до"] != разбор["стих_от"]
                итог = итог + "-" + строка(разбор["стих_до"])
            конец
        конец
    конец
    аминь итог
конец

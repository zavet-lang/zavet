приими ссылки из "./главный.молитва"

тест "разбор и форматирование библейских ссылок"
    пусть р1 = ссылки.разобрать("Ин 3:16")
    проверить(р1["ок"] == истина)
    проверить(р1["код"] == "Ин")
    проверить(р1["книга"] == "От Иоанна")
    проверить(р1["глава"] == 3)
    проверить(р1["стих_от"] == 16)
    проверить(ссылки.форматировать(р1) == "От Иоанна 3:16")

    пусть р2 = ссылки.разобрать("1 Кор. 13:4-7")
    проверить(р2["ок"] == истина)
    проверить(р2["код"] == "1Кор")
    проверить(р2["стих_от"] == 4)
    проверить(р2["стих_до"] == 7)
    проверить(ссылки.форматировать(р2, истина) == "1Кор 13:4-7")

    пусть р3 = ссылки.разобрать("Пс 22")
    проверить(р3["ок"] == истина)
    проверить(р3["стих_от"] == ничего)
    проверить(ссылки.форматировать(р3) == "Псалтирь 22")

    проверить(ссылки.разобрать("Неизвестная 1:1")["ок"] == ложь)

приими транслит из "./главный.молитва"

тест "транслитерация ГОСТ, ICAO, slug и обратная"
    проверить(транслит.в_латиницу("Привет, Завет!") == "Privet, Zavet!")
    проверить(транслит.в_латиницу("Щука", "icao") == "Shchuka")
    проверить(транслит.slug("Язык программирования Завет 1.1!") == "yazyk-programmirovaniya-zavet-1-1")
    проверить(транслит.в_кириллицу("Privet, mir!") == "Привет, мир!")
    проверить(транслит.в_кириллицу("Shchuka") == "Щука")
конец

# Пакет «транслит» — транслитерация кириллицы, обратная транслитерация и генератор URL-slug.

пусть ТАБЛИЦА_ICAO = {
    "а": "a", "б": "b", "в": "v", "г": "g", "д": "d", "е": "e", "ё": "e",
    "ж": "zh", "з": "z", "и": "i", "й": "i", "к": "k", "л": "l", "м": "m",
    "н": "n", "о": "o", "п": "p", "р": "r", "с": "s", "т": "t", "у": "u",
    "ф": "f", "х": "kh", "ц": "ts", "ч": "ch", "ш": "sh", "щ": "shch",
    "ъ": "ie", "ы": "y", "ь": "", "э": "e", "ю": "iu", "я": "ia",
}

пусть ТАБЛИЦА_ГОСТ = {
    "а": "a", "б": "b", "в": "v", "г": "g", "д": "d", "е": "e", "ё": "yo",
    "ж": "zh", "з": "z", "и": "i", "й": "j", "к": "k", "л": "l", "м": "m",
    "н": "n", "о": "o", "п": "p", "р": "r", "с": "s", "т": "t", "у": "u",
    "ф": "f", "х": "h", "ц": "c", "ч": "ch", "ш": "sh", "щ": "shh",
    "ъ": "", "ы": "y", "ь": "", "э": "e", "ю": "yu", "я": "ya",
}

слово заглавить(s)
    если длина(s) == 0
        аминь ""
    конец
    аминь верхний(подстрока(s, 0, 1)) + подстрока(s, 1, длина(s))
конец

# Транслитерирует кириллицу в латиницу. Схема: "гост" (по умолчанию) или "icao".
открой слово в_латиницу(текст, схема = "гост")
    если текст == ничего
        аминь ""
    конец
    пусть табл = если нижний(схема) == "icao": ТАБЛИЦА_ICAO иначе: ТАБЛИЦА_ГОСТ
    пусть s = строка(текст)
    измени итог = ""
    измени i = 0
    доколе i < длина(s)
        пусть ch = подстрока(s, i, i + 1)
        пусть низ = нижний(ch)
        пусть перев = получить(табл, низ, ничего)
        если перев != ничего
            если ch != низ
                итог = итог + заглавить(перев)
            иначе
                итог = итог + перев
            конец
        иначе
            итог = итог + ch
        конец
        i = i + 1
    конец
    аминь итог
конец

# Превращает строку в чистый URL-slug (нижний регистр, дефисы, без спецсимволов).
открой слово slug(текст, разделитель = "-")
    пусть лат = нижний(в_латиницу(текст, "гост"))
    пусть чист = регвыр.заменить(лат, '[^a-z0-9]+', разделитель)
    измени s = чист
    доколе длина(s) > 0 и начинается_с(s, разделитель)
        s = подстрока(s, длина(разделитель), длина(s))
    конец
    доколе длина(s) > 0 и заканчивается_на(s, разделитель)
        s = подстрока(s, 0, длина(s) - длина(разделитель))
    конец
    аминь s
конец

# Обратная транслитерация (латиница -> кириллица, базовый разбор диграфов).
открой слово в_кириллицу(текст)
    если текст == ничего
        аминь ""
    конец
    пусть пары = [
        ["shch", "щ"], ["shh", "щ"], ["zh", "ж"], ["ch", "ч"], ["sh", "ш"],
        ["kh", "х"], ["ts", "ц"], ["yo", "ё"], ["yu", "ю"], ["ya", "я"],
        ["a", "а"], ["b", "б"], ["v", "в"], ["g", "г"], ["d", "д"], ["e", "е"],
        ["z", "з"], ["i", "и"], ["j", "й"], ["k", "к"], ["l", "л"], ["m", "м"],
        ["n", "н"], ["o", "о"], ["p", "п"], ["r", "р"], ["s", "с"], ["t", "т"],
        ["u", "у"], ["f", "ф"], ["h", "х"], ["c", "ц"], ["y", "ы"],
    ]
    пусть s = строка(текст)
    измени итог = ""
    измени i = 0
    пусть дл = длина(s)
    доколе i < дл
        измени совпало = ложь
        для п в пары
            пусть лат = п[0]
            пусть кир = п[1]
            пусть шаг = длина(лат)
            если i + шаг <= дл
                пусть кусок = подстрока(s, i, i + шаг)
                если нижний(кусок) == лат
                    пусть первая = подстрока(кусок, 0, 1)
                    если первая != нижний(первая)
                        итог = итог + верхний(кир)
                    иначе
                        итог = итог + кир
                    конец
                    i = i + шаг
                    совпало = истина
                    прерви
                конец
            конец
        конец
        если не совпало
            итог = итог + подстрока(s, i, i + 1)
            i = i + 1
        конец
    конец
    аминь итог
конец

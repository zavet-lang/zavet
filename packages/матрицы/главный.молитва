# Пакет «матрицы» — операции линейной алгебры (матрицы как массив строк чисел).

открой слово нули(строк, столбцов)
    измени m = []
    измени i = 0
    доколе i < строк
        измени ряд = []
        измени j = 0
        доколе j < столбцов
            добавить(ряд, 0.0)
            j = j + 1
        конец
        добавить(m, ряд)
        i = i + 1
    конец
    аминь m
конец

открой слово единичная(размер)
    измени m = нули(размер, размер)
    измени i = 0
    доколе i < размер
        m[i][i] = 1.0
        i = i + 1
    конец
    аминь m
конец

открой слово форма(m)
    пусть r = длина(m)
    пусть c = если r > 0: длина(m[0]) иначе: 0
    аминь [r, c]
конец

открой слово сложить(а, б)
    пусть r = длина(а)
    пусть c = длина(а[0])
    измени m = нули(r, c)
    измени i = 0
    доколе i < r
        измени j = 0
        доколе j < c
            m[i][j] = (а[i][j] * 1.0) + (б[i][j] * 1.0)
            j = j + 1
        конец
        i = i + 1
    конец
    аминь m
конец

открой слово умножить_на_число(а, k)
    пусть r = длина(а)
    пусть c = длина(а[0])
    измени m = нули(r, c)
    измени i = 0
    доколе i < r
        измени j = 0
        доколе j < c
            m[i][j] = (а[i][j] * 1.0) * (k * 1.0)
            j = j + 1
        конец
        i = i + 1
    конец
    аминь m
конец

открой слово умножить(а, б)
    пусть ra = длина(а)
    пусть ca = длина(а[0])
    пусть rb = длина(б)
    пусть cb = длина(б[0])
    если ca != rb
        бросить("несовместимые размеры матриц для умножения")
    конец
    измени m = нули(ra, cb)
    измени i = 0
    доколе i < ra
        измени j = 0
        доколе j < cb
            измени s = 0.0
            измени k = 0
            доколе k < ca
                s = s + (а[i][k] * 1.0) * (б[k][j] * 1.0)
                k = k + 1
            конец
            m[i][j] = s
            j = j + 1
        конец
        i = i + 1
    конец
    аминь m
конец

открой слово транспонировать(а)
    пусть r = длина(а)
    пусть c = длина(а[0])
    измени m = нули(c, r)
    измени i = 0
    доколе i < r
        измени j = 0
        доколе j < c
            m[j][i] = а[i][j] * 1.0
            j = j + 1
        конец
        i = i + 1
    конец
    аминь m
конец

# Определитель квадратной матрицы методом Гаусса.
открой слово определитель(а)
    пусть n = длина(а)
    если n == 0 или длина(а[0]) != n
        бросить("определитель определён только для квадратной матрицы")
    конец
    # Копия
    измени m = нули(n, n)
    измени i = 0
    доколе i < n
        измени j = 0
        доколе j < n
            m[i][j] = а[i][j] * 1.0
            j = j + 1
        конец
        i = i + 1
    конец

    измени det = 1.0
    измени col = 0
    доколе col < n
        измени piv = col
        измени r = col + 1
        доколе r < n
            если абс(m[r][col]) > абс(m[piv][col])
                piv = r
            конец
            r = r + 1
        конец
        если абс(m[piv][col]) < 0.000000000001
            аминь 0.0
        конец
        если piv != col
            пусть tmp = m[col]
            m[col] = m[piv]
            m[piv] = tmp
            det = -det
        конец
        det = det * m[col][col]
        измени r2 = col + 1
        доколе r2 < n
            пусть f = m[r2][col] / m[col][col]
            измени c2 = col
            доколе c2 < n
                m[r2][c2] = m[r2][c2] - f * m[col][c2]
                c2 = c2 + 1
            конец
            r2 = r2 + 1
        конец
        col = col + 1
    конец
    аминь det
конец

# Обратная матрица методом Гаусса-Жордана.
открой слово обратная(а)
    пусть n = длина(а)
    если n == 0 или длина(а[0]) != n
        бросить("обратная матрица определена только для квадратной матрицы")
    конец
    измени лев = нули(n, n)
    измени прав = единичная(n)
    измени i = 0
    доколе i < n
        измени j = 0
        доколе j < n
            лев[i][j] = а[i][j] * 1.0
            j = j + 1
        конец
        i = i + 1
    конец

    измени col = 0
    доколе col < n
        измени piv = col
        измени r = col + 1
        доколе r < n
            если абс(лев[r][col]) > абс(лев[piv][col])
                piv = r
            конец
            r = r + 1
        конец
        если абс(лев[piv][col]) < 0.000000000001
            бросить("матрица вырождена и не имеет обратной")
        конец
        если piv != col
            пусть t1 = лев[col]
            лев[col] = лев[piv]
            лев[piv] = t1
            пусть t2 = прав[col]
            прав[col] = прав[piv]
            прав[piv] = t2
        конец
        пусть d = лев[col][col]
        измени c2 = 0
        доколе c2 < n
            лев[col][c2] = лев[col][c2] / d
            прав[col][c2] = прав[col][c2] / d
            c2 = c2 + 1
        конец
        измени r2 = 0
        доколе r2 < n
            если r2 != col
                пусть f = лев[r2][col]
                измени c3 = 0
                доколе c3 < n
                    лев[r2][c3] = лев[r2][c3] - f * лев[col][c3]
                    прав[r2][c3] = прав[r2][c3] - f * прав[col][c3]
                    c3 = c3 + 1
                конец
            конец
            r2 = r2 + 1
        конец
        col = col + 1
    конец
    аминь прав
конец

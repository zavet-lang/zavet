приими м из "./главный.молитва"

тест "умножение, транспонирование, определитель и обратная матрица"
    пусть а = [[1, 2], [3, 4]]
    пусть б = [[2, 0], [1, 2]]
    пусть п = м.умножить(а, б)
    проверить(абс(п[0][0] - 4.0) < 0.0001)
    проверить(абс(п[1][1] - 8.0) < 0.0001)

    пусть т = м.транспонировать(а)
    проверить(абс(т[0][1] - 3.0) < 0.0001)

    проверить(абс(м.определитель(а) - (-2.0)) < 0.0001)

    пусть обр = м.обратная(а)
    пусть ед = м.умножить(а, обр)
    проверить(абс(ед[0][0] - 1.0) < 0.0001)
    проверить(абс(ед[0][1]) < 0.0001)
    проверить(абс(ед[1][1] - 1.0) < 0.0001)
конец

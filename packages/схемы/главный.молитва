# Пакет «схемы» — декларативная проверка и нормализация данных (аналог zod/pydantic).

открой образ Схема
    слово создать(вид)
        это.вид = вид
        это._необязательно = ложь
        это._умолч = ничего
        это._есть_умолч = ложь
        это._мин = ничего
        это._макс = ничего
        это._шаблон = ничего
        это._варианты = ничего
        это._элемент = ничего
        это._поля = ничего
        это._обрезка = ложь
    конец

    слово необязательно()
        это._необязательно = истина
        аминь это
    конец

    слово по_умолчанию(значение)
        это._необязательно = истина
        это._умолч = значение
        это._есть_умолч = истина
        аминь это
    конец

    слово мин(n)
        это._мин = n
        аминь это
    конец

    слово макс(n)
        это._макс = n
        аминь это
    конец

    слово шаблон(регулярка)
        это._шаблон = регулярка
        аминь это
    конец

    слово email()
        это._шаблон = '^[^@\s]+@[^@\s]+\.[^@\s]+$'
        аминь это
    конец

    слово обрезать()
        это._обрезка = истина
        аминь это
    конец

    # Проверяет значение и возвращает {"ок": истина/ложь, "значение": ..., "ошибки": [...]}.
    слово разобрать(значение, путьПоля = "")
        измени ошибки = []
        пусть преф = если путьПоля != "": путьПоля + ": " иначе: ""

        если значение == ничего
            если это._есть_умолч
                аминь {"ок": истина, "значение": это._умолч, "ошибки": []}
            конец
            если это._необязательно
                аминь {"ок": истина, "значение": ничего, "ошибки": []}
            конец
            аминь {"ок": ложь, "значение": ничего, "ошибки": [преф + "обязательное поле"]}
        конец

        пусть т = тип(значение)

        если это.вид == "строка"
            если т != "STRING"
                аминь {"ок": ложь, "значение": ничего, "ошибки": [преф + "ожидалась строка"]}
            конец
            пусть s = если это._обрезка: обрезать(значение) иначе: значение
            если это._мин != ничего
                если длина(s) < это._мин
                    добавить(ошибки, преф + "длина меньше " + строка(это._мин))
                конец
            конец
            если это._макс != ничего
                если длина(s) > это._макс
                    добавить(ошибки, преф + "длина больше " + строка(это._макс))
                конец
            конец
            если это._шаблон != ничего
                если не регвыр.совпадает(s, это._шаблон)
                    добавить(ошибки, преф + "не соответствует формату")
                конец
            конец
            аминь {"ок": длина(ошибки) == 0, "значение": s, "ошибки": ошибки}
        конец

        если это.вид == "целое"
            если т != "INTEGER"
                аминь {"ок": ложь, "значение": ничего, "ошибки": [преф + "ожидалось целое число"]}
            конец
            если это._мин != ничего
                если значение < это._мин
                    добавить(ошибки, преф + "меньше " + строка(это._мин))
                конец
            конец
            если это._макс != ничего
                если значение > это._макс
                    добавить(ошибки, преф + "больше " + строка(это._макс))
                конец
            конец
            аминь {"ок": длина(ошибки) == 0, "значение": значение, "ошибки": ошибки}
        конец

        если это.вид == "число"
            если т != "INTEGER" и т != "FLOAT"
                аминь {"ок": ложь, "значение": ничего, "ошибки": [преф + "ожидалось число"]}
            конец
            если это._мин != ничего
                если значение < это._мин
                    добавить(ошибки, преф + "меньше " + строка(это._мин))
                конец
            конец
            если это._макс != ничего
                если значение > это._макс
                    добавить(ошибки, преф + "больше " + строка(это._макс))
                конец
            конец
            аминь {"ок": длина(ошибки) == 0, "значение": значение, "ошибки": ошибки}
        конец

        если это.вид == "булево"
            если т != "BOOLEAN"
                аминь {"ок": ложь, "значение": ничего, "ошибки": [преф + "ожидалось булево значение"]}
            конец
            аминь {"ок": истина, "значение": значение, "ошибки": []}
        конец

        если это.вид == "перечисление"
            измени нашлось = ложь
            для вар в это._варианты
                если значение == вар
                    нашлось = истина
                    прерви
                конец
            конец
            если не нашлось
                аминь {"ок": ложь, "значение": ничего, "ошибки": [преф + "недопустимое значение"]}
            конец
            аминь {"ок": истина, "значение": значение, "ошибки": []}
        конец

        если это.вид == "массив"
            если т != "ARRAY"
                аминь {"ок": ложь, "значение": ничего, "ошибки": [преф + "ожидался массив"]}
            конец
            если это._мин != ничего
                если длина(значение) < это._мин
                    добавить(ошибки, преф + "элементов меньше " + строка(это._мин))
                конец
            конец
            если это._макс != ничего
                если длина(значение) > это._макс
                    добавить(ошибки, преф + "элементов больше " + строка(это._макс))
                конец
            конец
            измени итогМас = []
            измени idx = 0
            для эл в значение
                пусть подпуть = путьПоля + "[" + строка(idx) + "]"
                пусть р = это._элемент.разобрать(эл, подпуть)
                если р["ок"]
                    добавить(итогМас, р["значение"])
                иначе
                    для ош в р["ошибки"]
                        добавить(ошибки, ош)
                    конец
                конец
                idx = idx + 1
            конец
            аминь {"ок": длина(ошибки) == 0, "значение": итогМас, "ошибки": ошибки}
        конец

        если это.вид == "объект"
            если т != "HASH"
                аминь {"ок": ложь, "значение": ничего, "ошибки": [преф + "ожидался словарь"]}
            конец
            измени итогОб = {}
            для ключ в ключи(это._поля)
                пусть схемаПоля = это._поля[ключ]
                пусть подпуть = если путьПоля != "": путьПоля + "." + ключ иначе: ключ
                пусть р = схемаПоля.разобрать(получить(значение, ключ, ничего), подпуть)
                если р["ок"]
                    итогОб[ключ] = р["значение"]
                иначе
                    для ош в р["ошибки"]
                        добавить(ошибки, ош)
                    конец
                конец
            конец
            аминь {"ок": длина(ошибки) == 0, "значение": итогОб, "ошибки": ошибки}
        конец

        аминь {"ок": истина, "значение": значение, "ошибки": []}
    конец
конец

открой слово строка_тип()
    аминь Схема("строка")
конец

открой слово целое_тип()
    аминь Схема("целое")
конец

открой слово число_тип()
    аминь Схема("число")
конец

открой слово булево_тип()
    аминь Схема("булево")
конец

открой слово один_из(варианты)
    пусть s = Схема("перечисление")
    s._варианты = варианты
    аминь s
конец

открой слово массив_тип(схемаЭлемента)
    пусть s = Схема("массив")
    s._элемент = схемаЭлемента
    аминь s
конец

открой слово объект_тип(поля)
    пусть s = Схема("объект")
    s._поля = поля
    аминь s
конец

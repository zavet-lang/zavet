# Прибавляет N рабочих дней к указанной дате.
открой слово прибавить_рабочих_дней(год, месяц, день, n)
    измени тек = {"год": год, "месяц": месяц, "день": день}
    измени ост = n
    доколе ост > 0
        тек = следующий_день(тек["год"], тек["месяц"], тек["день"])
        если рабочий_день(тек["год"], тек["месяц"], тек["день"])
            ост = ост - 1
        конец
    конец
    аминь тек
конец

# Расчёт даты Православной Пасхи по григорианскому календарю (алгоритм Миуса).
открой слово православная_пасха(год)
    пусть a = год % 4
    пусть b = год % 7
    пусть c = год % 19
    пусть d = (19 * c + 15) % 30
    пусть e = (2 * a + 4 * b - d + 34) % 7
    пусть сумма = d + e + 114
    пусть юлМесяц = (сумма - (сумма % 31)) / 31
    пусть юлДень = (сумма % 31) + 1

    # Сдвиг юлианского -> григорианского календаря (+13 дней для 1900..2099)
    измени тек = {"год": год, "месяц": юлМесяц, "день": юлДень}
    измени i = 0
    доколе i < 13
        тек = следующий_день(тек["год"], тек["месяц"], тек["день"])
        i = i + 1
    конец
    аминь тек
конец

# День недели по алгоритму Сакамото: 1=Пн .. 7=Вс.
открой слово день_недели(год, месяц, день)
    пусть t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    измени y = год
    если месяц < 3
        y = y - 1
    конец
    пусть d = (y + (y - (y % 4)) / 4 - (y - (y % 100)) / 100 + (y - (y % 400)) / 400 + t[месяц - 1] + день) % 7
    аминь если d == 0: 7 иначе: d
конец


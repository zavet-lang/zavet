# Пакет «клиент-api» — HTTP API-клиент с базовым URL, авторизацией, повторами и перехватчиками.
# Поддерживает подмену транспорта (для модульных тестов без реальной сети).

слово склеить_url(база, путьЗапроса, query)
    измени b = обрезать(база ?? "")
    доколе длина(b) > 0 и заканчивается_на(b, "/")
        b = подстрока(b, 0, длина(b) - 1)
    конец
    измени p = обрезать(путьЗапроса ?? "")
    если начинается_с(p, "http://") или начинается_с(p, "https://")
        b = ""
    иначеесли p != "" и не начинается_с(p, "/")
        p = "/" + p
    конец
    измени q = ""
    если query != ничего
        если длина(ключи(query)) > 0
            измени пары = []
            для к в ключи(query)
                добавить(пары, строка(к) + "=" + строка(query[к]))
            конец
            q = "?" + соединить(пары, "&")
        конец
    конец
    аминь b + p + q
конец

слово объединить_словари(а, б)
    измени итог = {}
    если а != ничего
        для к в ключи(а)
            итог[к] = а[к]
        конец
    конец
    если б != ничего
        для к в ключи(б)
            итог[к] = б[к]
        конец
    конец
    аминь итог
конец

слово транспорт_по_умолчанию(метод, url, тело, заголовки)
    аминь http.отправить(метод, url, тело, заголовки)
конец

слово нужно_повторить(статус, статусыПовтора)
    для с в статусыПовтора
        если статус == с
            аминь истина
        конец
    конец
    аминь ложь
конец

# Основной образ API-клиента.
открой образ Клиент
    слово создать(опции = ничего)
        пусть оп = опции ?? {}
        это.база = получить(оп, "база", "")
        это.заголовки = получить(оп, "заголовки", {"Accept": "application/json"})
        это.повторы = получить(оп, "повторы", 2)
        это.пауза_мс = получить(оп, "пауза_мс", 200)
        это.статусы_повтора = получить(оп, "статусы_повтора", [429, 500, 502, 503, 504])
        это.транспорт = получить(оп, "транспорт", транспорт_по_умолчанию)
        это.сон = получить(оп, "сон", слово(мс): время.спать(мс))
        это._перед = []
        это._после = []
    конец

    # Устанавливает Bearer-токен в заголовок Authorization.
    слово с_токеном(токен)
        это.заголовки["Authorization"] = "Bearer " + токен
        аминь это
    конец

    # Устанавливает произвольный API-ключ в заголовок.
    слово с_ключом(имяЗаголовка, значение)
        это.заголовки[имяЗаголовка] = значение
        аминь это
    конец

    # Добавляет перехватчик до отправки (получает и возвращает словарь запроса).
    слово перед_запросом(фн)
        добавить(это._перед, фн)
        аминь это
    конец

    # Добавляет перехватчик после ответа (получает и возвращает словарь ответа).
    слово после_ответа(фн)
        добавить(это._после, фн)
        аминь это
    конец

    # Выполняет запрос с повторами и разбором JSON.
    слово запрос(метод, путьЗапроса, опции = ничего)
        пусть оп = опции ?? {}
        пусть url = склеить_url(это.база, путьЗапроса, получить(оп, "query", ничего))
        пусть заголовки = объединить_словари(это.заголовки, получить(оп, "заголовки", {}))
        пусть тело = получить(оп, "тело", ничего)
        пусть максПопыток = получить(оп, "повторы", это.повторы) + 1

        измени контекст = {
            "метод": верхний(метод),
            "url": url,
            "тело": тело,
            "заголовки": заголовки,
        }
        для фн в это._перед
            контекст = фн(контекст)
        конец

        измени попыткаНом = 0
        измени последнийОтвет = ничего
        измени последняяОшибка = ничего

        доколе попыткаНом < максПопыток
            попыткаНом = попыткаНом + 1
            последняяОшибка = ничего
            попытка
                последнийОтвет = это.транспорт(
                    контекст["метод"],
                    контекст["url"],
                    контекст["тело"],
                    контекст["заголовки"]
                )
            поймать ош
                последняяОшибка = строка(ош)
                последнийОтвет = ничего
            конец

            пусть сбойСтатуса = последнийОтвет != ничего и нужно_повторить(получить(последнийОтвет, "статус", 0), это.статусы_повтора)
            если последняяОшибка == ничего и не сбойСтатуса
                прерви
            конец

            если попыткаНом < максПопыток и это.пауза_мс > 0
                пусть задержка = это.пауза_мс * степень(2, попыткаНом - 1)
                это.сон(задержка)
            конец
        конец

        если последняяОшибка != ничего
            брось "Ошибка API-запроса " + контекст["метод"] + " " + контекст["url"] + ": " + последняяОшибка
        конец

        пусть статус = получить(последнийОтвет, "статус", 0)
        пусть телоОтвета = получить(последнийОтвет, "тело", "")
        измени разобранный = ничего
        если тип(телоОтвета) == "STRING" и обрезать(телоОтвета) != ""
            попытка
                разобранный = json.разобрать(телоОтвета)
            поймать _
                разобранный = ничего
            конец
        конец

        измени итог = {
            "ок": статус >= 200 и статус < 300,
            "статус": статус,
            "тело": телоОтвета,
            "json": разобранный,
            "заголовки": получить(последнийОтвет, "заголовки", {}),
            "попыток": попыткаНом,
        }

        для фн в это._после
            итог = фн(итог)
        конец

        аминь итог
    конец

    слово получить(путьЗапроса, query = ничего, заголовки = ничего)
        аминь это.запрос("GET", путьЗапроса, {"query": query, "заголовки": заголовки})
    конец

    слово пост(путьЗапроса, тело = ничего, заголовки = ничего)
        аминь это.запрос("POST", путьЗапроса, {"тело": тело, "заголовки": заголовки})
    конец

    слово положить(путьЗапроса, тело = ничего, заголовки = ничего)
        аминь это.запрос("PUT", путьЗапроса, {"тело": тело, "заголовки": заголовки})
    конец

    слово патч(путьЗапроса, тело = ничего, заголовки = ничего)
        аминь это.запрос("PATCH", путьЗапроса, {"тело": тело, "заголовки": заголовки})
    конец

    слово удалить(путьЗапроса, заголовки = ничего)
        аминь это.запрос("DELETE", путьЗапроса, {"заголовки": заголовки})
    конец
конец

открой слово создать(опции = ничего)
    аминь Клиент(опции)
конец

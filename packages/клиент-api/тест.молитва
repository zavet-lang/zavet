приими клиент из "./главный.молитва"

тест "базовый URL, Bearer, query и автоматический разбор JSON"
    измени вызовы = []
    пусть мок = слово(метод, url, тело, заголовки)
        добавить(вызовы, {"метод": метод, "url": url, "заголовки": заголовки})
        аминь {"статус": 200, "тело": '{"имя":"Завет","версия":1}', "заголовки": {}}
    конец

    пусть кл = клиент.создать({"база": "https://api.example.com/", "транспорт": мок, "пауза_мс": 0})
    кл.с_токеном("секрет123")

    пусть отв = кл.получить("/info", {"lang": "ru"})
    проверить(отв["ок"] == истина)
    проверить(отв["json"]["имя"] == "Завет")
    проверить(вызовы[0]["url"] == "https://api.example.com/info?lang=ru")
    проверить(вызовы[0]["заголовки"]["Authorization"] == "Bearer секрет123")
конец

тест "повторы при 503 и экспоненциальная пауза"
    измени счёт = 0
    измени паузы = []
    пусть мок = слово(метод, url, тело, заголовки)
        счёт = счёт + 1
        если счёт < 3
            аминь {"статус": 503, "тело": "временно недоступен", "заголовки": {}}
        конец
        аминь {"статус": 200, "тело": '{"готово":true}', "заголовки": {}}
    конец

    пусть кл = клиент.создать({
        "база": "https://api.test",
        "повторы": 3,
        "пауза_мс": 100,
        "транспорт": мок,
        "сон": слово(мс): добавить(паузы, мс),
    })

    пусть отв = кл.получить("/jobs")
    проверить(отв["ок"] == истина)
    проверить(отв["попыток"] == 3)
    проверить(длина(паузы) == 2)
    проверить(паузы[0] == 100)
    проверить(паузы[1] == 200)
конец

тест "перехватчики перед запросом и после ответа"
    пусть мок = слово(м, u, т, з): {"статус": 201, "тело": '{"id":9}', "заголовки": {"X-Req": получить(з, "X-Trace", "")}}
    пусть кл = клиент.создать({"база": "https://api.test", "транспорт": мок, "пауза_мс": 0})
    кл.перед_запросом(слово(ctx)
        ctx["заголовки"]["X-Trace"] = "tr-1"
        аминь ctx
    конец)
    кл.после_ответа(слово(res)
        res["отметка"] = "проверено"
        аминь res
    конец)

    пусть отв = кл.пост("/items", {"name": "A"})
    проверить(отв["статус"] == 201)
    проверить(отв["заголовки"]["X-Req"] == "tr-1")
    проверить(отв["отметка"] == "проверено")
конец

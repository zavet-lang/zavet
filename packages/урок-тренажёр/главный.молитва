# Пакет «урок-тренажёр» — карточки интервального повторения по алгоритму SM-2.

# Пересчитывает состояние карточки после оценки качества ответа (0..5).
открой слово обновить_sm2(карточка, качество, сейчасДней = 0)
    измени повторов = получить(карточка, "повторов", 0)
    измени интервал = получить(карточка, "интервал", 0)
    измени лёгкость = получить(карточка, "лёгкость", 2.5) * 1.0

    если качество < 3
        повторов = 0
        интервал = 1
    иначе
        если повторов == 0
            интервал = 1
        иначеесли повторов == 1
            интервал = 6
        иначе
            пусть расч = (интервал * 1.0) * лёгкость + 0.5
            пусть целСтр = разделить(строка(мат.пол(расч)), ".")[0]
            интервал = число(целСтр)
        конец
        повторов = повторов + 1
    конец

    пусть dq = 5.0 - (качество * 1.0)
    лёгкость = лёгкость + (0.1 - dq * (0.08 + dq * 0.02))
    если лёгкость < 1.3
        лёгкость = 1.3
    конец

    аминь {
        "ид": получить(карточка, "ид", ""),
        "вопрос": получить(карточка, "вопрос", ""),
        "ответ": получить(карточка, "ответ", ""),
        "повторов": повторов,
        "интервал": интервал,
        "лёгкость": лёгкость,
        "следующий_день": сейчасДней + интервал,
    }
конец

открой образ Колода
    поля: название, карточки

    слово создать(название)
        это.название = название
        это.карточки = []
    конец

    слово добавить(ид, вопрос, ответ)
        добавить(это.карточки, {
            "ид": ид,
            "вопрос": вопрос,
            "ответ": ответ,
            "повторов": 0,
            "интервал": 0,
            "лёгкость": 2.5,
            "следующий_день": 0,
        })
        аминь это
    конец

    # Возвращает карточки, которые пора повторить к указанному дню.
    слово к_повторению(день)
        измени вых = []
        для к в это.карточки
            если к["следующий_день"] <= день
                добавить(вых, к)
            конец
        конец
        аминь вых
    конец

    слово оценить(ид, качество, день = 0)
        измени i = 0
        доколе i < длина(это.карточки)
            если это.карточки[i]["ид"] == ид
                это.карточки[i] = обновить_sm2(это.карточки[i], качество, день)
                аминь это.карточки[i]
            конец
            i = i + 1
        конец
        аминь ничего
    конец
конец

открой слово колода(название)
    аминь новый Колода(название)
конец

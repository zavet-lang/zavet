приими трен из "./главный.молитва"

тест "интервальное повторение SM-2 и планирование карточек"
    пусть к = трен.колода("Ключевые слова Завета")
    к.добавить("1", "return", "аминь")
    к.добавить("2", "while", "доколе")

    проверить(длина(к.к_повторению(0)) == 2)

    пусть к1 = к.оценить("1", 5, 0)
    проверить(к1["интервал"] == 1)
    проверить(к1["следующий_день"] == 1)
    проверить(длина(к.к_повторению(0)) == 1)

    пусть к2 = к.оценить("1", 5, 1)
    проверить(к2["интервал"] == 6)
    проверить(к2["следующий_день"] == 7)

    # Ошибка (качество < 3) сбрасывает интервал до 1 дня
    пусть к3 = к.оценить("1", 1, 7)
    проверить(к3["интервал"] == 1)
    проверить(к3["повторов"] == 0)
конец

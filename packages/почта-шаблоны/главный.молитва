# Пакет «почта-шаблоны» — генерация HTML и plain-text писем с безопасным экранированием.

открой слово собрать(опции)
    пусть тема = строка(получить(опции, "тема", "Уведомление"))
    пусть бренд = шаблон.экранировать(строка(получить(опции, "бренд", "Завет")))
    пусть заголовок = шаблон.экранировать(строка(получить(опции, "заголовок", тема)))
    пусть абзацы = получить(опции, "абзацы", [])
    пусть кнопкаТекст = получить(опции, "кнопка_текст", ничего)
    пусть кнопкаUrl = получить(опции, "кнопка_url", ничего)
    пусть подвал = шаблон.экранировать(строка(получить(опции, "подвал", "Письмо отправлено автоматически.")))
    пусть акцент = строка(получить(опции, "цвет", "#2563eb"))

    измени htmlАбз = []
    измени текстАбз = []
    для п в абзацы
        пусть s = строка(п)
        добавить(htmlАбз, "<p style=\"margin:0 0 14px;line-height:1.6;color:#1f2937;\">" + шаблон.экранировать(s) + "</p>")
        добавить(текстАбз, s)
    конец

    измени htmlКнопка = ""
    если кнопкаТекст != ничего и кнопкаUrl != ничего
        пусть кт = шаблон.экранировать(строка(кнопкаТекст))
        пусть ку = шаблон.экранировать(строка(кнопкаUrl))
        htmlКнопка = "<div style=\"margin:24px 0;\"><a href=\"" + ку + "\" style=\"display:inline-block;padding:12px 24px;background:" + акцент + ";color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;\">" + кт + "</a></div>"
        добавить(текстАбз, строка(кнопкаТекст) + ": " + строка(кнопкаUrl))
    конец

    пусть html = "<!doctype html><html><body style=\"margin:0;padding:24px;background:#f3f4f6;font-family:Arial,sans-serif;\">" +
        "<div style=\"max-width:560px;margin:0 auto;background:#ffffff;border-radius:12px;padding:32px;border:1px solid #e5e7eb;\">" +
        "<div style=\"font-size:13px;font-weight:700;color:" + акцент + ";margin-bottom:12px;\">" + бренд + "</div>" +
        "<h1 style=\"margin:0 0 16px;font-size:22px;color:#111827;\">" + заголовок + "</h1>" +
        соединить(htmlАбз, "") + htmlКнопка +
        "<hr style=\"border:none;border-top:1px solid #e5e7eb;margin:24px 0 16px;\">" +
        "<div style=\"font-size:12px;color:#6b7280;\">" + подвал + "</div>" +
        "</div></body></html>"

    пусть текст = тема + "\n\n" + соединить(текстАбз, "\n\n") + "\n\n--\n" + строка(получить(опции, "подвал", ""))
    аминь {"тема": тема, "html": html, "текст": текст}
конец

открой слово приветствие(имя, бренд = "Завет", ссылка = ничего)
    аминь собрать({
        "тема": "Добро пожаловать в " + бренд + "!",
        "бренд": бренд,
        "заголовок": "Здравствуйте, " + строка(имя) + "!",
        "абзацы": [
            "Рады приветствовать вас в " + бренд + ".",
            "Ваш аккаунт готов к работе.",
        ],
        "кнопка_текст": если ссылка != ничего: "Открыть кабинет" иначе: ничего,
        "кнопка_url": ссылка,
    })
конец

открой слово подтверждение(имя, кодИлиСсылка, бренд = "Завет")
    пусть этоСсылка = начинается_с(строка(кодИлиСсылка), "http")
    аминь собрать({
        "тема": "Подтверждение почты — " + бренд,
        "бренд": бренд,
        "заголовок": "Подтвердите адрес почты",
        "абзацы": если этоСсылка:
            ["Здравствуйте, " + строка(имя) + "! Нажмите на кнопку ниже для подтверждения."]
        иначе:
            ["Здравствуйте, " + строка(имя) + "! Ваш код подтверждения: " + строка(кодИлиСсылка)],
        "кнопка_текст": если этоСсылка: "Подтвердить почту" иначе: ничего,
        "кнопка_url": если этоСсылка: кодИлиСсылка иначе: ничего,
    })
конец

открой слово сброс_пароля(ссылка, минут = 30, бренд = "Завет")
    аминь собрать({
        "тема": "Сброс пароля — " + бренд,
        "бренд": бренд,
        "заголовок": "Запрос на смену пароля",
        "абзацы": [
            "Вы запросили сброс пароля. Ссылка действует " + строка(минут) + " мин.",
            "Если вы не отправляли запрос, просто проигнорируйте это письмо.",
        ],
        "кнопка_текст": "Сбросить пароль",
        "кнопка_url": ссылка,
    })
конец

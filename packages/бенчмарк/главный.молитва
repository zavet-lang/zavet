# Пакет «бенчмарк» — замер времени и сравнение производительности функций.

# Выполняет функцию заданное число раз и возвращает метрики (всего_мс, среднее_мс, оп_в_сек).
открой слово замерить(имя, итераций, действие)
    пусть старт = время.метка()
    измени i = 0
    доколе i < итераций
        действие(i)
        i = i + 1
    конец
    пусть всегоМс = время.метка() - старт
    пусть безопМс = если всегоМс <= 0: 1.0 иначе: всегоМс * 1.0
    пусть среднее = (всегоМс * 1.0) / (итераций * 1.0)
    пусть опСек = (итераций * 1000.0) / безопМс
    аминь {
        "имя": имя,
        "итераций": итераций,
        "всего_мс": всегоМс,
        "среднее_мс": среднее,
        "оп_в_сек": опСек,
    }
конец

# Запускает набор бенчмарков [{"имя": ..., "функция": ...}] и формирует текстовую таблицу.
открой слово сравнить(набор, итераций = 100)
    измени результаты = []
    измени линии = []
    для эл в набор
        пусть р = замерить(эл["имя"], итераций, эл["функция"])
        добавить(результаты, р)
        добавить(линии, р["имя"] + ": " + строка(р["всего_мс"]) + " мс (" + строка(итераций) + " итер.)")
    конец
    аминь {"результаты": результаты, "отчёт": соединить(линии, "\n")}
конец

приими бенч из "./главный.молитва"

тест "замер и сравнение функций"
    пусть р = бенч.замерить("сложение", 200, слово(i) пусть x = i + i конец)
    проверить(р["имя"] == "сложение")
    проверить(р["итераций"] == 200)
    проверить(р["всего_мс"] >= 0)
    проверить(р["оп_в_сек"] > 0.0)

    пусть ср = бенч.сравнить([
        {"имя": "а", "функция": слово(i) пусть x = i * 2 конец},
        {"имя": "б", "функция": слово(i) пусть x = i + i конец},
    ], 50)
    проверить(длина(ср["результаты"]) == 2)
    проверить(содержит(ср["отчёт"], "а:"))
конец

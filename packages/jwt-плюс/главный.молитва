# Пакет «jwt-плюс» — access/refresh токены HS256, отзыв (blacklist) и проверка прав.

слово b64url_кодировать(текст)
    измени s = крипто.base64_кодировать(текст)
    s = заменить(s, "+", "-")
    s = заменить(s, "/", "_")
    s = заменить(s, "=", "")
    аминь s
конец

слово b64url_декодировать(текст)
    измени s = заменить(заменить(текст, "-", "+"), "_", "/")
    доколе (длина(s) % 4) != 0
        s = s + "="
    конец
    аминь крипто.base64_декодировать(s)
конец

открой слово подписать(данные, секрет, ttlСек = 900)
    пусть заголовок = b64url_кодировать(json.создать({"alg": "HS256", "typ": "JWT"}))
    измени полезная = {}
    для к в ключи(данные)
        полезная[к] = данные[к]
    конец
    пусть сейчас = время.сейчас()
    полезная["iat"] = сейчас
    полезная["exp"] = сейчас + ttlСек
    если получить(полезная, "jti", ничего) == ничего
        пусть зерно = строка(время.метка()) + ":" + строка(случайное.целое(100000, 999999)) + ":" + строка(случайное.целое(100000, 999999))
        полезная["jti"] = подстрока(крипто.sha256(зерно), 0, 16)
    конец
    пусть тело = b64url_кодировать(json.создать(полезная))
    пусть подпись = b64url_кодировать(крипто.hmac_sha256(заголовок + "." + тело, секрет))
    аминь заголовок + "." + тело + "." + подпись
конец

открой слово разобрать_и_проверить(токен, секрет)
    если токен == ничего
        аминь {"ок": ложь, "ошибка": "пустой токен"}
    конец
    пусть части = разделить(строка(токен), ".")
    если длина(части) != 3
        аминь {"ок": ложь, "ошибка": "неверный формат JWT"}
    конец
    пусть ожид = b64url_кодировать(крипто.hmac_sha256(части[0] + "." + части[1], секрет))
    если ожид != части[2]
        аминь {"ок": ложь, "ошибка": "неверная подпись"}
    конец
    пусть полезная = json.разобрать(b64url_декодировать(части[1]))
    пусть exp = получить(полезная, "exp", 0)
    если exp < время.сейчас()
        аминь {"ок": ложь, "ошибка": "срок действия токена истёк"}
    конец
    аминь {"ок": истина, "данные": полезная}
конец

открой образ МенеджерТокенов
    поля: секрет_доступа, секрет_обновления, ttl_доступа, ttl_обновления, отозванные

    слово создать(секретДоступа, секретОбновления, ttlДоступа = 900, ttlОбновления = 604800)
        это.секрет_доступа = секретДоступа
        это.секрет_обновления = секретОбновления
        это.ttl_доступа = ttlДоступа
        это.ttl_обновления = ttlОбновления
        это.отозванные = {}
    конец

    слово выпустить_пару(субъект, роли = [])
        пусть access = подписать({"sub": субъект, "roles": роли, "kind": "access"}, это.секрет_доступа, это.ttl_доступа)
        пусть refresh = подписать({"sub": субъект, "roles": роли, "kind": "refresh"}, это.секрет_обновления, это.ttl_обновления)
        аминь {"access": access, "refresh": refresh}
    конец

    слово отозвать(jti)
        это.отозванные[jti] = время.сейчас()
        аминь истина
    конец

    слово проверка_доступа(токен, требуемаяРоль = ничего)
        пусть р = разобрать_и_проверить(токен, это.секрет_доступа)
        если не р["ок"]
            аминь р
        конец
        пусть д = р["данные"]
        если получить(это.отозванные, получить(д, "jti", ""), ничего) != ничего
            аминь {"ок": ложь, "ошибка": "токен отозван"}
        конец
        если требуемаяРоль != ничего
            пусть роли = получить(д, "roles", [])
            измени есть = ложь
            для рл в роли
                если рл == требуемаяРоль
                    есть = истина
                конец
            конец
            если не есть
                аминь {"ок": ложь, "ошибка": "недостаточно прав: требуется роль " + требуемаяРоль}
            конец
        конец
        аминь р
    конец

    # Ротация: отзывает старый refresh-токен и выдаёт новую пару.
    слово обновить(refreshТокен)
        пусть р = разобрать_и_проверить(refreshТокен, это.секрет_обновления)
        если не р["ок"]
            аминь р
        конец
        пусть д = р["данные"]
        пусть jti = получить(д, "jti", "")
        если получить(это.отозванные, jti, ничего) != ничего
            аминь {"ок": ложь, "ошибка": "refresh-токен уже использован или отозван"}
        конец
        это.отозвать(jti)
        пусть новаяПара = это.выпустить_пару(д["sub"], получить(д, "roles", []))
        аминь {"ок": истина, "access": новаяПара["access"], "refresh": новаяПара["refresh"]}
    конец
конец

открой слово менеджер(секретДоступа, секретОбновления, ttlДоступа = 900, ttlОбновления = 604800)
    аминь новый МенеджерТокенов(секретДоступа, секретОбновления, ttlДоступа, ttlОбновления)
конец

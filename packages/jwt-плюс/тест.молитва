приими jwt из "./главный.молитва"

тест "выпуск пары, проверка ролей, ротация refresh и отзыв"
    пусть м = jwt.менеджер("access-secret", "refresh-secret", 60, 3600)
    пусть пара = м.выпустить_пару("user-42", ["user", "editor"])

    пусть п1 = м.проверка_доступа(пара["access"], "editor")
    проверить(п1["ок"] == истина)
    проверить(п1["данные"]["sub"] == "user-42")

    проверить(м.проверка_доступа(пара["access"], "admin")["ок"] == ложь)

    пусть обн = м.обновить(пара["refresh"])
    проверить(обн["ок"] == истина)
    # Повторное использование старого refresh-токена запрещено
    проверить(м.обновить(пара["refresh"])["ок"] == ложь)

    # Отзыв access-токена
    м.отозвать(п1["данные"]["jti"])
    проверить(м.проверка_доступа(пара["access"])["ок"] == ложь)

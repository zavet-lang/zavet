# Пакет «секреты» — зашифрованное хранилище секретов (потоковый ключ на HMAC-SHA256 + MAC-тег).

пусть HEX = "0123456789abcdef"

слово hex_в_байт(h2)
    аминь найти(HEX, подстрока(h2, 0, 1)) * 16 + найти(HEX, подстрока(h2, 1, 2))
конец

слово байт_в_hex(b)
    пусть hi = (b - (b % 16)) / 16
    пусть lo = b % 16
    аминь подстрока(HEX, hi, hi + 1) + подстрока(HEX, lo, lo + 1)
конец

слово xor_байт(а, б)
    измени res = 0
    измени bit = 1
    измени x = а
    измени y = б
    доколе x > 0 или y > 0
        если (x % 2) != (y % 2)
            res = res + bit
        конец
        x = (x - (x % 2)) / 2
        y = (y - (y % 2)) / 2
        bit = bit * 2
    конец
    аминь res
конец

# Преобразует base64-строку (ASCII) в массив кодов через таблицу ASCII и обратно.
пусть B64_АЛФ = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/="

слово b64_в_индексы(s)
    измени вых = []
    измени i = 0
    доколе i < длина(s)
        добавить(вых, найти(B64_АЛФ, подстрока(s, i, i + 1)))
        i = i + 1
    конец
    аминь вых
конец

# Шифрует строку мастер-ключом, возвращая JSON-конверт {nonce, data, mac}.
открой слово зашифровать(текст, мастерКлюч)
    пусть зерно = строка(время.метка()) + ":" + строка(случайное.целое(100000, 999999)) + ":" + строка(случайное.целое(100000, 999999))
    пусть nonce = подстрока(крипто.sha256(зерно), 0, 24)
    пусть b64 = крипто.base64_кодировать(строка(текст))
    пусть индексы = b64_в_индексы(b64)
    измени поток = ""
    измени блок = 0
    доколе длина(поток) < длина(индексы) * 2
        поток = поток + крипто.hmac_sha256(nonce + ":" + строка(блок), мастерКлюч)
        блок = блок + 1
    конец
    измени шифрHex = ""
    измени i = 0
    доколе i < длина(индексы)
        пусть kБайт = hex_в_байт(подстрока(поток, i * 2, i * 2 + 2))
        шифрHex = шифрHex + байт_в_hex(xor_байт(индексы[i], kБайт))
        i = i + 1
    конец
    пусть mac = крипто.hmac_sha256(nonce + ":" + шифрHex, мастерКлюч)
    аминь {"nonce": nonce, "data": шифрHex, "mac": mac}
конец

# Расшифровывает конверт; при неверном ключе или подмене бросает ошибку.
открой слово расшифровать(конверт, мастерКлюч)
    пусть nonce = конверт["nonce"]
    пусть шифрHex = конверт["data"]
    пусть ожидMac = крипто.hmac_sha256(nonce + ":" + шифрHex, мастерКлюч)
    если ожидMac != конверт["mac"]
        бросить("ошибка целостности или неверный мастер-ключ")
    конец
    пусть n = (длина(шифрHex) - (длина(шифрHex) % 2)) / 2
    измени поток = ""
    измени блок = 0
    доколе длина(поток) < n * 2
        поток = поток + крипто.hmac_sha256(nonce + ":" + строка(блок), мастерКлюч)
        блок = блок + 1
    конец
    измени b64 = ""
    измени i = 0
    доколе i < n
        пусть cБайт = hex_в_байт(подстрока(шифрHex, i * 2, i * 2 + 2))
        пусть kБайт = hex_в_байт(подстрока(поток, i * 2, i * 2 + 2))
        пусть idx = xor_байт(cБайт, kБайт)
        b64 = b64 + подстрока(B64_АЛФ, idx, idx + 1)
        i = i + 1
    конец
    аминь крипто.base64_декодировать(b64)
конец

открой образ Сейф
    поля: ключ, записи

    слово создать(мастерКлюч)
        это.ключ = мастерКлюч
        это.записи = {}
    конец

    слово положить(имя, значение)
        это.записи[имя] = зашифровать(строка(значение), это.ключ)
        аминь это
    конец

    слово взять(имя, умолч = ничего)
        пусть конв = получить(это.записи, имя, ничего)
        если конв == ничего
            аминь умолч
        конец
        аминь расшифровать(конв, это.ключ)
    конец

    слово в_json()
        аминь json.создать(это.записи)
    конец

    слово из_json(текст)
        это.записи = json.разобрать(текст)
        аминь это
    конец
конец

открой слово сейф(мастерКлюч)
    аминь новый Сейф(мастерКлюч)
конец

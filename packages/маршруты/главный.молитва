# Пакет «маршруты» — расширенная маршрутизация поверх стандартного модуля «веб».
# Поддерживает типизированные параметры ({id:int}, {id:uuid}, {slug:slug}),
# именованные маршруты с обратной генерацией URL, версионирование API и REST-ресурсы.

пусть ПРОВЕРКИ_ТИПОВ = {
    "int": слово(зн)
        если не регвыр.совпадает(зн, '^-?[0-9]+$')
            аминь {"ок": ложь, "ошибка": "ожидалось целое число"}
        конец
        аминь {"ок": истина, "значение": число(зн)}
    конец,
    "uint": слово(зн)
        если не регвыр.совпадает(зн, '^[0-9]+$')
            аминь {"ок": ложь, "ошибка": "ожидалось неотрицательное целое число"}
        конец
        аминь {"ок": истина, "значение": число(зн)}
    конец,
    "float": слово(зн)
        если не регвыр.совпадает(зн, '^-?[0-9]+(\.[0-9]+)?$')
            аминь {"ок": ложь, "ошибка": "ожидалось число"}
        конец
        аминь {"ок": истина, "значение": число(зн)}
    конец,
    "uuid": слово(зн)
        если не регвыр.совпадает(нижний(зн), '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
            аминь {"ок": ложь, "ошибка": "ожидался UUID"}
        конец
        аминь {"ок": истина, "значение": нижний(зн)}
    конец,
    "slug": слово(зн)
        если не регвыр.совпадает(зн, '^[a-zA-Z0-9а-яА-ЯёЁ_-]+$')
            аминь {"ок": ложь, "ошибка": "ожидался корректный slug"}
        конец
        аминь {"ок": истина, "значение": зн}
    конец,
    "str": слово(зн)
        аминь {"ок": истина, "значение": зн}
    конец,
}

# Нормализует склейку префикса и пути.
открой слово склеить_путь(префикс, путьМаршрута)
    измени p = обрезать(префикс ?? "")
    измени r = обрезать(путьМаршрута ?? "")
    если p == "/"
        p = ""
    конец
    доколе длина(p) > 0 и заканчивается_на(p, "/")
        p = подстрока(p, 0, длина(p) - 1)
    конец
    если r == "" или r == "/"
        если p == ""
            аминь "/"
        конец
        аминь p
    конец
    если не начинается_с(r, "/")
        r = "/" + r
    конец
    аминь p + r
конец

# Преобразует шаблон вида "/users/{id:int}/posts/{slug:slug}" в путь для веб ("/users/:id/posts/:slug")
# и список правил проверки типов параметров.
открой слово разобрать_шаблон(шаблон)
    пусть части = разделить(шаблон, "/")
    измени сегментыВеб = []
    измени параметры = []

    для ч в части
        если начинается_с(ч, '{') и заканчивается_на(ч, '}')
            пусть внутри = подстрока(ч, 1, длина(ч) - 1)
            пусть пары = разделить(внутри, ":")
            пусть имяПарам = обрезать(пары[0])
            пусть типПарам = если длина(пары) > 1: обрезать(пары[1]) иначе: "str"
            добавить(сегментыВеб, ":" + имяПарам)
            добавить(параметры, {"имя": имяПарам, "тип": типПарам})
        иначе
            добавить(сегментыВеб, ч)
        конец
    конец

    аминь {
        "путь_веб": соединить(сегментыВеб, "/"),
        "параметры": параметры,
    }
конец

# Формирует query-строку из словаря.
слово собрать_query(словарьЗапроса)
    если словарьЗапроса == ничего
        аминь ""
    конец
    если длина(ключи(словарьЗапроса)) == 0
        аминь ""
    конец
    измени части = []
    для к в ключи(словарьЗапроса)
        добавить(части, строка(к) + "=" + строка(словарьЗапроса[к]))
    конец
    аминь "?" + соединить(части, "&")
конец

# Расширенный маршрутизатор поверх веб.приложение().
открой образ Маршрутизатор
    слово создать(app, префикс = "", общийРеестр = ничего)
        это.app = app
        это.префикс = префикс
        если общийРеестр == ничего
            это._реестр = {"маршруты": [], "имена": {}, "типы": {}}
        иначе
            это._реестр = общийРеестр
        конец
    конец

    # Регистрация пользовательского типа параметра.
    слово добавить_тип(название, проверщик)
        это._реестр["типы"][название] = проверщик
        аминь это
    конец

    # Внутренний поиск проверщика типа.
    слово _найти_тип(название)
        пусть свой = получить(это._реестр["типы"], название, ничего)
        если свой != ничего
            аминь свой
        конец
        аминь получить(ПРОВЕРКИ_ТИПОВ, название, ПРОВЕРКИ_ТИПОВ["str"])
    конец

    # Регистрирует маршрут с проверкой типов параметров и опциональным именем.
    слово маршрут(метод, шаблон, обработчик, опции = ничего)
        пусть оп = опции ?? {}
        пусть полныйШаблон = склеить_путь(это.префикс, шаблон)
        пусть разбор = разобрать_шаблон(полныйШаблон)
        пусть путьВеб = разбор["путь_веб"]
        пусть парамСписок = разбор["параметры"]
        пусть методВерх = верхний(метод)
        пусть имяМаршрута = получить(оп, "имя", ничего)
        пусть описание = получить(оп, "описание", "")

        пусть запись = {
            "метод": методВерх,
            "шаблон": полныйШаблон,
            "путь": путьВеб,
            "параметры": парамСписок,
            "имя": имяМаршрута,
            "описание": описание,
        }
        добавить(это._реестр["маршруты"], запись)
        если имяМаршрута != ничего и имяМаршрута != ""
            это._реестр["имена"][имяМаршрута] = запись
        конец

        пусть роутер = это
        пусть обёртка = слово(запрос)
            измени типизированные = {}
            для п в парамСписок
                пусть сырое = запрос.парам(п["имя"])
                пусть проверщик = роутер._найти_тип(п["тип"])
                пусть рез = проверщик(сырое ?? "")
                если не рез["ок"]
                    аминь веб.json({
                        "ошибка": "Некорректный параметр маршрута «" + п["имя"] + "»: " + рез["ошибка"],
                        "параметр": п["имя"],
                        "тип": п["тип"],
                    }, 400)
                конец
                типизированные[п["имя"]] = рез["значение"]
            конец
            запрос["типы"] = типизированные
            аминь обработчик(запрос)
        конец

        это.app.маршрут(методВерх, путьВеб, обёртка)
        аминь это
    конец

    слово получить(шаблон, обработчик, опции = ничего)
        аминь это.маршрут("GET", шаблон, обработчик, опции)
    конец

    слово пост(шаблон, обработчик, опции = ничего)
        аминь это.маршрут("POST", шаблон, обработчик, опции)
    конец

    слово положить(шаблон, обработчик, опции = ничего)
        аминь это.маршрут("PUT", шаблон, обработчик, опции)
    конец

    слово патч(шаблон, обработчик, опции = ничего)
        аминь это.маршрут("PATCH", шаблон, обработчик, опции)
    конец

    слово удалить(шаблон, обработчик, опции = ничего)
        аминь это.маршрут("DELETE", шаблон, обработчик, опции)
    конец

    # Создаёт дочерний маршрутизатор с добавленным префиксом.
    слово группа(подпрефикс)
        пусть новыйПрефикс = склеить_путь(это.префикс, подпрефикс)
        аминь Маршрутизатор(это.app, новыйПрефикс, это._реестр)
    конец

    # Создаёт версионированную группу: версия(1) -> "/v1", версия("v2") -> "/v2".
    слово версия(номер)
        пусть s = строка(номер)
        пусть преф = если начинается_с(s, "v") или начинается_с(s, "/v"): s иначе: "/v" + s
        аминь это.группа(преф)
    конец

    # Регистрирует REST-ресурс (CRUD) по словарю обработчиков:
    # список (GET /база), создать (POST /база), получить (GET /база/{id:тип}),
    # обновить (PUT /база/{id:тип}), изменить (PATCH /база/{id:тип}), удалить (DELETE /база/{id:тип}).
    слово ресурс(база, контроллер, типИд = "int")
        пусть имяРесурса = заменить(обрезать(база), "/", "")
        пусть путьЭлемента = склеить_путь(база, '{id:' + типИд + '}')

        если получить(контроллер, "список", ничего) != ничего
            это.получить(база, контроллер["список"], {"имя": имяРесурса + ".список"})
        конец
        если получить(контроллер, "создать", ничего) != ничего
            это.пост(база, контроллер["создать"], {"имя": имяРесурса + ".создать"})
        конец
        если получить(контроллер, "получить", ничего) != ничего
            это.получить(путьЭлемента, контроллер["получить"], {"имя": имяРесурса + ".получить"})
        конец
        если получить(контроллер, "обновить", ничего) != ничего
            это.положить(путьЭлемента, контроллер["обновить"], {"имя": имяРесурса + ".обновить"})
        конец
        если получить(контроллер, "изменить", ничего) != ничего
            это.патч(путьЭлемента, контроллер["изменить"], {"имя": имяРесурса + ".изменить"})
        конец
        если получить(контроллер, "удалить", ничего) != ничего
            это.удалить(путьЭлемента, контроллер["удалить"], {"имя": имяРесурса + ".удалить"})
        конец
        аминь это
    конец

    # Обратная генерация URL по имени маршрута.
    слово url_для(имяМаршрута, параметры = ничего, query = ничего)
        пусть запись = получить(это._реестр["имена"], имяМаршрута, ничего)
        если запись == ничего
            брось "Маршрут с именем «" + имяМаршрута + "» не найден"
        конец
        пусть пар = параметры ?? {}
        пусть части = разделить(запись["путь"], "/")
        измени итоговые = []
        для ч в части
            если начинается_с(ч, ":")
                пусть к = подстрока(ч, 1, длина(ч))
                если получить(пар, к, ничего) == ничего
                    брось "Не передан параметр «" + к + "» для маршрута «" + имяМаршрута + "»"
                конец
                добавить(итоговые, строка(пар[к]))
            иначе
                добавить(итоговые, ч)
            конец
        конец
        аминь соединить(итоговые, "/") + собрать_query(query)
    конец

    # Возвращает список всех зарегистрированных маршрутов.
    слово список_маршрутов()
        аминь это._реестр["маршруты"]
    конец
конец

открой слово создать(app, префикс = "")
    аминь Маршрутизатор(app, префикс)
конец

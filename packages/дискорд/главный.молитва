# Пакет «дискорд» — клиент Discord Webhook с конструктором Embed-карточек.

открой образ Карточка
    поля: данные

    слово создать(заголовок = "", описание = "")
        это.данные = {"fields": []}
        если заголовок != ""
            это.данные["title"] = заголовок
        конец
        если описание != ""
            это.данные["description"] = описание
        конец
    конец

    слово цвет(числоЦвета)
        это.данные["color"] = числоЦвета
        аминь это
    конец

    слово ссылка(url)
        это.данные["url"] = url
        аминь это
    конец

    слово поле(имя, значение, вСтроку = ложь)
        добавить(это.данные["fields"], {"name": строка(имя), "value": строка(значение), "inline": вСтроку})
        аминь это
    конец

    слово подвал(текст)
        это.данные["footer"] = {"text": строка(текст)}
        аминь это
    конец

    слово собрать()
        аминь это.данные
    конец
конец

открой слово карточка(заголовок = "", описание = "")
    аминь новый Карточка(заголовок, описание)
конец

открой образ Вебхук
    поля: url, имя, аватар, транспорт

    слово создать(url, опции = {})
        это.url = url
        это.имя = получить(опции, "имя", ничего)
        это.аватар = получить(опции, "аватар", ничего)
        это.транспорт = получить(опции, "транспорт", ничего)
    конец

    слово отправить(текст = "", карточки = [])
        измени тело = {}
        если текст != ""
            тело["content"] = строка(текст)
        конец
        если это.имя != ничего
            тело["username"] = это.имя
        конец
        если это.аватар != ничего
            тело["avatar_url"] = это.аватар
        конец
        если длина(карточки) > 0
            измени embeds = []
            для к в карточки
                если тип(к) == "СЛОВАРЬ"
                    добавить(embeds, к)
                иначе
                    добавить(embeds, к.собрать())
                конец
            конец
            тело["embeds"] = embeds
        конец
        пусть jsonТело = json.создать(тело)
        пусть заг = {"Content-Type": "application/json"}
        если это.транспорт != ничего
            аминь это.транспорт("POST", это.url, jsonТело, заг)
        конец
        аминь http.запрос("POST", это.url, jsonТело, заг)
    конец
конец

открой слово вебхук(url, опции = {})
    аминь новый Вебхук(url, опции)
конец

# Пакет «шаблоны-проекта» — генерация структуры и стартовых файлов проектов на Завете.

открой слово список_шаблонов()
    аминь ["cli", "web", "bot", "pkg"]
конец

# Возвращает словарь {"имя_файла": "содержимое"} для выбранного типа проекта.
открой слово сгенерировать(типПроекта, имяПроекта)
    пусть т = нижний(обрезать(строка(типПроекта)))
    пусть манифест = json.создать({
        "имя": имяПроекта,
        "версия": "0.1.0",
        "описание": "Проект " + имяПроекта + " на языке Завет",
        "точка_входа": "главный.молитва",
        "зависимости": {},
    })
    пусть readme = "# " + имяПроекта + "\n\nПроект создан по шаблону `" + т + "` на языке Завет.\n\n```bash\nzavet главный.молитва\n```\n"

    измени код = "возгласи(\"Привет из " + имяПроекта + "!\")\n"
    измени тестКод = "тест \"базовая проверка\"\n    проверить(1 + 1 == 2)\nконец\n"

    если т == "web"
        код = "пусть app = веб.приложение()\napp.получить(\"/\", слово(з) аминь веб.json_ответ({\"сервис\": \"" + имяПроекта + "\", \"ок\": истина}) конец)\napp.слушать(8080)\n"
        тестКод = "тест \"веб-маршрут\"\n    пусть app = веб.приложение()\n    app.получить(\"/ping\", слово(з) аминь веб.текст(\"pong\") конец)\n    проверить(app.обработать(\"GET\", \"/ping\")[\"тело\"] == \"pong\")\nконец\n"
    иначеесли т == "bot"
        код = "приими тг из \"тг\"\nпусть токен = ос.переменная(\"TG_TOKEN\", \"\")\nвозгласи(\"Бот " + имяПроекта + " готов к запуску\")\n"
    иначеесли т == "pkg"
        код = "открой слово привет(имя)\n    аминь \"Мир тебе, \" + строка(имя) + \"!\"\nконец\n"
        тестКод = "приими м из \"./главный.молитва\"\n\nтест \"приветствие\"\n    проверить(м.привет(\"Завет\") == \"Мир тебе, Завет!\")\nконец\n"
    иначеесли т != "cli"
        бросить("неизвестный шаблон проекта: " + т)
    конец

    аминь {
        "пакет.json": манифест,
        "главный.молитва": код,
        "тест.молитва": тестКод,
        "README.md": readme,
    }
конец

# Создаёт каталог проекта и записывает сгенерированные файлы на диск.
открой слово создать_на_диске(типПроекта, папка, имяПроекта)
    пусть файлыКарта = сгенерировать(типПроекта, имяПроекта)
    файлы.создать_папку(папка)
    измени записано = []
    для имяФ в ключи(файлыКарта)
        пусть путь = файлы.соединить(папка, имяФ)
        файлы.записать(путь, файлыКарта[имяФ])
        добавить(записано, путь)
    конец
    аминь записано
конец

приими шаб из "./главный.молитва"

тест "генерация шаблонов web, pkg и cli"
    проверить(длина(шаб.список_шаблонов()) == 4)

    пусть вебП = шаб.сгенерировать("web", "мой-сайт")
    проверить(содержит(вебП["главный.молитва"], "веб.приложение()"))
    проверить(содержит(вебП["пакет.json"], "мой-сайт"))

    пусть п = шаб.сгенерировать("pkg", "моя-либа")
    проверить(содержит(п["главный.молитва"], "открой слово привет"))
    проверить(содержит(п["тест.молитва"], "приими м"))

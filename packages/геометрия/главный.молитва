# Пакет «геометрия» — 2D-векторы, расстояния, пересечения, многоугольники и геодистанция.

открой слово точка(x, y)
    аминь {"x": x * 1.0, "y": y * 1.0}
конец

открой слово расстояние(а, б)
    пусть dx = б["x"] - а["x"]
    пусть dy = б["y"] - а["y"]
    аминь корень(dx * dx + dy * dy)
конец

открой слово скалярное(а, б)
    аминь а["x"] * б["x"] + а["y"] * б["y"]
конец

открой слово векторное_2d(а, б)
    аминь а["x"] * б["y"] - а["y"] * б["x"]
конец

открой слово длина_вектора(век)
    аминь корень(век["x"] * век["x"] + век["y"] * век["y"])
конец

открой слово нормализовать(век)
    пусть д = длина_вектора(век)
    если д == 0.0
        аминь {"x": 0.0, "y": 0.0}
    конец
    аминь {"x": век["x"] / д, "y": век["y"] / д}
конец

открой слово прямоугольник(x, y, ширина, высота)
    аминь {"x": x * 1.0, "y": y * 1.0, "w": ширина * 1.0, "h": высота * 1.0}
конец

открой слово точка_в_прямоугольнике(т, п)
    аминь т["x"] >= п["x"] и т["x"] <= п["x"] + п["w"] и т["y"] >= п["y"] и т["y"] <= п["y"] + п["h"]
конец

открой слово пересекаются_прямоугольники(а, б)
    аминь а["x"] < б["x"] + б["w"] и а["x"] + а["w"] > б["x"] и а["y"] < б["y"] + б["h"] и а["y"] + а["h"] > б["y"]
конец

# Площадь простого многоугольника (формула шнурования Гаусса).
открой слово площадь_многоугольника(вершины)
    пусть n = длина(вершины)
    если n < 3
        аминь 0.0
    конец
    измени s = 0.0
    измени i = 0
    доколе i < n
        пусть p1 = вершины[i]
        пусть p2 = вершины[(i + 1) % n]
        s = s + (p1["x"] * p2["y"] - p2["x"] * p1["y"])
        i = i + 1
    конец
    аминь абс(s) / 2.0
конец

# Проверка принадлежности точки многоугольнику (ray casting).
открой слово точка_в_многоугольнике(т, вершины)
    пусть n = длина(вершины)
    измени внутри = ложь
    измени j = n - 1
    измени i = 0
    доколе i < n
        пусть xi = вершины[i]["x"]
        пусть yi = вершины[i]["y"]
        пусть xj = вершины[j]["x"]
        пусть yj = вершины[j]["y"]
        пусть пересек = ((yi > т["y"]) != (yj > т["y"]))
        если пересек
            пусть xПерес = (xj - xi) * (т["y"] - yi) / (yj - yi) + xi
            если т["x"] < xПерес
                внутри = не внутри
            конец
        конец
        j = i
        i = i + 1
    конец
    аминь внутри
конец

слово арктангенс(z)
    # Приведение к [-1, 1] и разложение в ряд с преобразованием Эйлера
    если z < 0.0
        аминь -арктангенс(-z)
    конец
    если z > 1.0
        аминь мат.пи / 2.0 - арктангенс(1.0 / z)
    конец
    пусть u = z / (1.0 + корень(1.0 + z * z))
    пусть u2 = u * u
    измени терм = u
    измени сумма = u
    измени k = 1
    доколе k <= 12
        терм = -терм * u2
        сумма = сумма + терм / ((2 * k + 1) * 1.0)
        k = k + 1
    конец
    аминь 2.0 * сумма
конец

# Расстояние между двумя географическими координатами (широта/долгота в градусах) в километрах.
открой слово гео_расстояние_км(шир1, долг1, шир2, долг2)
    пусть рад = мат.пи / 180.0
    пусть dLat = (шир2 - шир1) * рад
    пусть dLon = (долг2 - долг1) * рад
    пусть a = степень(мат.sin(dLat / 2.0), 2) + мат.cos(шир1 * рад) * мат.cos(шир2 * рад) * степень(мат.sin(dLon / 2.0), 2)
    пусть c = если a >= 1.0: мат.пи иначе: 2.0 * арктангенс(корень(a) / корень(1.0 - a))
    аминь 6371.0 * c
конец

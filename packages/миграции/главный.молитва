# Пакет «миграции» — управление версиями схемы базы данных (SQLite через модуль «бд»).
# Поддерживает применение (вверх), откат (вниз), таблицу истории _migrations и проверку контрольных сумм.

открой образ Мигратор
    слово создать(соединение, таблицаИстории = "_migrations")
        это.соед = соединение
        это.таблица = таблицаИстории
        это._список = []
        это._подготовить()
    конец

    слово _подготовить()
        это.соед.выполнить(
            "CREATE TABLE IF NOT EXISTS " + это.таблица + " (" +
            "version TEXT PRIMARY KEY, " +
            "name TEXT NOT NULL, " +
            "checksum TEXT NOT NULL, " +
            "applied_at INTEGER NOT NULL)"
        )
    конец

    # Регистрирует миграцию: версия ("001"), название, sqlВверх (строка или массив SQL), sqlВниз (опционально).
    слово добавить(версия, название, sqlВверх, sqlВниз = ничего)
        пусть вверх = если тип(sqlВверх) == "ARRAY": sqlВверх иначе: [sqlВверх]
        измени вниз = []
        если sqlВниз != ничего
            вниз = если тип(sqlВниз) == "ARRAY": sqlВниз иначе: [sqlВниз]
        конец
        пусть сумма = подстрока(крипто.sha256(соединить(вверх, ";")), 0, 16)
        добавить(это._список, {
            "версия": строка(версия),
            "название": название,
            "вверх": вверх,
            "вниз": вниз,
            "сумма": сумма,
        })
        аминь это
    конец

    # Возвращает словарь {версия: запись} применённых миграций.
    слово _применённые_словарь()
        пусть строки = это.соед.запрос("SELECT version, name, checksum, applied_at FROM " + это.таблица + " ORDER BY version ASC")
        измени рез = {}
        для с в строки
            рез[с["version"]] = с
        конец
        аминь рез
    конец

    # Применяет все неприменённые миграции по порядку.
    слово применить()
        пусть уже = это._применённые_словарь()
        измени выполнено = []

        для м в это._список
            пусть вер = м["версия"]
            пусть зап = получить(уже, вер, ничего)
            если зап != ничего
                если зап["checksum"] != м["сумма"]
                    брось "Миграция " + вер + " (" + м["название"] + ") была изменена после применения!"
                конец
                продолжи
            конец

            для sql в м["вверх"]
                если обрезать(sql) != ""
                    это.соед.выполнить(sql)
                конец
            конец

            это.соед.выполнить(
                "INSERT INTO " + это.таблица + " (version, name, checksum, applied_at) VALUES (?, ?, ?, ?)",
                вер, м["название"], м["сумма"], время.сейчас()
            )
            добавить(выполнено, вер)
        конец

        аминь выполнено
    конец

    # Откатывает последние N применённых миграций (по умолчанию 1).
    слово откатить(шагов = 1)
        пусть уже = это._применённые_словарь()
        измени откатано = []
        измени индекс = длина(это._список) - 1

        доколе индекс >= 0 и длина(откатано) < шагов
            пусть м = это._список[индекс]
            пусть вер = м["версия"]
            если получить(уже, вер, ничего) != ничего
                если длина(м["вниз"]) == 0
                    брось "У миграции " + вер + " не задан SQL для отката"
                конец
                для sql в м["вниз"]
                    если обрезать(sql) != ""
                        это.соед.выполнить(sql)
                    конец
                конец
                это.соед.выполнить("DELETE FROM " + это.таблица + " WHERE version = ?", вер)
                добавить(откатано, вер)
            конец
            индекс = индекс - 1
        конец

        аминь откатано
    конец

    # Возвращает статус всех зарегистрированных миграций.
    слово статус()
        пусть уже = это._применённые_словарь()
        измени отчёт = []
        для м в это._список
            пусть зап = получить(уже, м["версия"], ничего)
            добавить(отчёт, {
                "версия": м["версия"],
                "название": м["название"],
                "применена": зап != ничего,
                "время": если зап != ничего: зап["applied_at"] иначе: ничего,
            })
        конец
        аминь отчёт
    конец
конец

открой слово создать(соединение, таблицаИстории = "_migrations")
    аминь Мигратор(соединение, таблицаИстории)
конец

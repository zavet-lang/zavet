приими миграции из "./главный.молитва"

тест "применение, повторный запуск, статус и откат миграций"
    пусть соед = бд.открыть(":memory:")
    пусть м = миграции.создать(соед)

    м.добавить("001", "таблица пользователей",
        "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL)",
        "DROP TABLE users")
    м.добавить("002", "таблица заметок",
        ["CREATE TABLE notes (id INTEGER PRIMARY KEY, user_id INTEGER, body TEXT)",
         "CREATE INDEX idx_notes_user ON notes(user_id)"],
        ["DROP INDEX idx_notes_user", "DROP TABLE notes"])

    пусть шаги1 = м.применить()
    проверить(длина(шаги1) == 2)
    # Повторный запуск ничего не применяет
    проверить(длина(м.применить()) == 0)

    соед.выполнить("INSERT INTO users (name) VALUES (?)", "Аня")
    проверить(длина(соед.запрос("SELECT * FROM users")) == 1)

    пусть отк = м.откатить(1)
    проверить(длина(отк) == 1)
    проверить(отк[0] == "002")

    пусть ст = м.статус()
    проверить(ст[0]["применена"] == истина)
    проверить(ст[1]["применена"] == ложь)
    соед.закрыть()
конец

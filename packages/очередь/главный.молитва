# Пакет «очередь» — постоянная очередь фоновых задач поверх SQLite («бд»).
# Поддерживает приоритеты, отложенный запуск, автоматические повторы с задержкой и воркер.

открой образ Очередь
    слово создать(путьБд = ":memory:", часы = ничего)
        это.соед = бд.открыть(путьБд)
        это._часы = часы ?? слово(): время.сейчас()
        это.соед.выполнить(
            "CREATE TABLE IF NOT EXISTS jobs (" +
            "id INTEGER PRIMARY KEY AUTOINCREMENT, " +
            "kind TEXT NOT NULL, " +
            "payload TEXT NOT NULL, " +
            "status TEXT NOT NULL DEFAULT 'pending', " +
            "priority INTEGER NOT NULL DEFAULT 0, " +
            "attempts INTEGER NOT NULL DEFAULT 0, " +
            "max_attempts INTEGER NOT NULL DEFAULT 3, " +
            "run_at INTEGER NOT NULL, " +
            "last_error TEXT NOT NULL DEFAULT '', " +
            "created_at INTEGER NOT NULL)"
        )
    конец

    # Ставит задачу в очередь. Опции: приоритет (больше = раньше), задержка_сек, макс_попыток.
    слово поставить(типЗадачи, данные, опции = ничего)
        пусть оп = опции ?? {}
        пусть сейчас = это._часы()
        пусть приор = получить(оп, "приоритет", 0)
        пусть задержка = получить(оп, "задержка_сек", 0)
        пусть максПоп = получить(оп, "макс_попыток", 3)
        пусть тело = json.создать(данные)

        это.соед.выполнить(
            "INSERT INTO jobs (kind, payload, status, priority, attempts, max_attempts, run_at, created_at) VALUES (?, ?, 'pending', ?, 0, ?, ?, ?)",
            типЗадачи, тело, приор, максПоп, сейчас + задержка, сейчас
        )
        пусть р = это.соед.запрос("SELECT last_insert_rowid() AS id")
        аминь р[0]["id"]
    конец

    # Забирает самую приоритетную готовую задачу и переводит её в статус 'running'.
    слово забрать(типЗадачи = ничего)
        пусть сейчас = это._часы()
        измени строки = []
        если типЗадачи == ничего
            строки = это.соед.запрос(
                "SELECT * FROM jobs WHERE status = 'pending' AND run_at <= ? ORDER BY priority DESC, id ASC LIMIT 1",
                сейчас
            )
        иначе
            строки = это.соед.запрос(
                "SELECT * FROM jobs WHERE status = 'pending' AND kind = ? AND run_at <= ? ORDER BY priority DESC, id ASC LIMIT 1",
                типЗадачи, сейчас
            )
        конец
        если длина(строки) == 0
            аминь ничего
        конец
        пусть з = строки[0]
        пусть новаяПоп = з["attempts"] + 1
        это.соед.выполнить("UPDATE jobs SET status = 'running', attempts = ? WHERE id = ?", новаяПоп, з["id"])
        аминь {
            "id": з["id"],
            "тип": з["kind"],
            "данные": json.разобрать(з["payload"]),
            "попытка": новаяПоп,
            "макс_попыток": з["max_attempts"],
            "приоритет": з["priority"],
        }
    конец

    слово завершить(ид)
        это.соед.выполнить("UPDATE jobs SET status = 'done', last_error = '' WHERE id = ?", ид)
    конец

    # Фиксирует ошибку; если попытки остались — возвращает задачу в 'pending' с задержкой.
    слово провалить(ид, ошибкаСтр, задержкаПовтора = 10)
        пусть строки = это.соед.запрос("SELECT attempts, max_attempts FROM jobs WHERE id = ?", ид)
        если длина(строки) == 0
            аминь ложь
        конец
        пусть з = строки[0]
        если з["attempts"] < з["max_attempts"]
            пусть следВремя = это._часы() + задержкаПовтора
            это.соед.выполнить(
                "UPDATE jobs SET status = 'pending', run_at = ?, last_error = ? WHERE id = ?",
                следВремя, строка(ошибкаСтр), ид
            )
            аминь истина
        конец
        это.соед.выполнить("UPDATE jobs SET status = 'failed', last_error = ? WHERE id = ?", строка(ошибкаСтр), ид)
        аминь ложь
    конец

    # Обрабатывает все готовые задачи с помощью словаря {типЗадачи: слово(данные, задача)}.
    слово обработать_все(обработчики, задержкаПовтора = 10)
        измени выполнено = 0
        измени ошибок = 0
        доколе истина
            пусть задача = это.забрать()
            если задача == ничего
                прерви
            конец
            пусть фн = получить(обработчики, задача["тип"], ничего)
            если фн == ничего
                это.провалить(задача["id"], "Неизвестный тип задачи: " + задача["тип"], 0)
                ошибок = ошибок + 1
                продолжи
            конец
            попытка
                фн(задача["данные"], задача)
                это.завершить(задача["id"])
                выполнено = выполнено + 1
            поймать ош
                это.провалить(задача["id"], строка(ош), задержкаПовтора)
                ошибок = ошибок + 1
            конец
        конец
        аминь {"выполнено": выполнено, "ошибок": ошибок}
    конец

    слово статистика()
        пусть строки = это.соед.запрос("SELECT status, COUNT(*) AS cnt FROM jobs GROUP BY status")
        измени рез = {"pending": 0, "running": 0, "done": 0, "failed": 0}
        для с в строки
            рез[с["status"]] = с["cnt"]
        конец
        аминь рез
    конец

    слово закрыть()
        это.соед.закрыть()
    конец
конец

открой слово создать(путьБд = ":memory:", часы = ничего)
    аминь Очередь(путьБд, часы)
конец

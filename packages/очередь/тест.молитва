приими очередь из "./главный.молитва"

тест "приоритеты, отложенный запуск и повторы при ошибке"
    измени тик = 1000
    пусть оч = очередь.создать(":memory:", слово(): тик)

    оч.поставить("письмо", {"кому": "обычный"}, {"приоритет": 1})
    оч.поставить("письмо", {"кому": "срочный"}, {"приоритет": 10})
    оч.поставить("письмо", {"кому": "отложенный"}, {"задержка_сек": 60})

    измени порядок = []
    пусть р1 = оч.обработать_все({
        "письмо": слово(д, з): добавить(порядок, д["кому"]),
    })
    проверить(р1["выполнено"] == 2)
    проверить(порядок[0] == "срочный")
    проверить(порядок[1] == "обычный")

    # Перематываем время — отложенная задача готова
    тик = 1100
    пусть р2 = оч.обработать_все({
        "письмо": слово(д, з): добавить(порядок, д["кому"]),
    })
    проверить(р2["выполнено"] == 1)
    проверить(порядок[2] == "отложенный")

    # Задача с ошибкой на 1-й попытке и успехом на 2-й
    оч.поставить("флаки", {"x": 1}, {"макс_попыток": 2})
    измени шаг = 0
    пусть р3 = оч.обработать_все({
        "флаки": слово(д, з)
            шаг = шаг + 1
            если шаг == 1
                брось "временный сбой"
            конец
        конец,
    }, 5)
    проверить(р3["ошибок"] == 1)
    проверить(оч.статистика()["pending"] == 1)

    тик = 1110
    пусть р4 = оч.обработать_все({
        "флаки": слово(д, з): 0,
    }, 5)
    проверить(р4["выполнено"] == 1)
    проверить(оч.статистика()["done"] == 4)
    оч.закрыть()
конец

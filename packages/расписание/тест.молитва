приими расп из "./главный.молитва"

тест "проверка cron-выражений и тик планировщика"
    проверить(расп.совпадает("*/15 * * * *", 30, 12, 1, 1, 1) == истина)
    проверить(расп.совпадает("*/15 * * * *", 31, 12, 1, 1, 1) == ложь)
    проверить(расп.совпадает("0 9 * * 1-5", 0, 9, 10, 5, 3) == истина)
    проверить(расп.совпадает("0 9 * * 1-5", 0, 9, 10, 5, 0) == ложь)

    измени счет = 0
    пусть пл = расп.планировщик()
    пл.добавить("бэкап", "0 3 * * *", слово() счет = счет + 1 конец)
    пл.добавить("пинг", "*/5 * * * *", слово() счет = счет + 10 конец)

    пусть вып = пл.тик(0, 3, 15, 6, 2)
    проверить(длина(вып) == 2)
    проверить(счет == 11)
конец

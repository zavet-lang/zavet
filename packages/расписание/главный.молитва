# Пакет «расписание» — cron-выражения ("мин час день месяц деньНедели") и планировщик.

слово поле_совпадает(поле, значение, минЗ, максЗ)
    пусть части = разделить(обрезать(поле), ",")
    для ч в части
        если ч == "*"
            аминь истина
        конец
        если начинается_с(ч, "*/")
            пусть шаг = число(подстрока(ч, 2, длина(ч)))
            если шаг > 0 и ((значение - минЗ) % шаг) == 0
                аминь истина
            конец
            продолжи
        конец
        если содержит(ч, "-")
            пусть гр = разделить(ч, "-")
            пусть нач = число(гр[0])
            пусть кон = число(гр[1])
            если значение >= нач и значение <= кон
                аминь истина
            конец
            продолжи
        конец
        если число(ч) == значение
            аминь истина
        конец
    конец
    аминь ложь
конец

# Проверяет, подходит ли дата/время под 5-польное cron-выражение.
# деньНедели: 0=Вс, 1=Пн .. 6=Сб.
открой слово совпадает(cron, минута, час, день, месяц, деньНедели = 1)
    пусть поля = разделить(обрезать(регвыр.заменить(cron, '\\s+', " ")), " ")
    если длина(поля) != 5
        бросить("cron-выражение должно содержать 5 полей")
    конец
    аминь поле_совпадает(поля[0], минута, 0, 59) и
        поле_совпадает(поля[1], час, 0, 23) и
        поле_совпадает(поля[2], день, 1, 31) и
        поле_совпадает(поля[3], месяц, 1, 12) и
        поле_совпадает(поля[4], деньНедели, 0, 6)
конец

# Планировщик именованных задач по cron-выражениям.
открой образ Планировщик
    поля: задачи

    слово создать()
        это.задачи = []
    конец

    слово добавить(имя, cron, действие)
        добавить(это.задачи, {"имя": имя, "cron": cron, "действие": действие})
        аминь это
    конец

    # Запускает все задачи, подходящие под момент времени, возвращает список имён выполненных.
    слово тик(минута, час, день, месяц, деньНедели = 1)
        измени выполнено = []
        для з в это.задачи
            если совпадает(з["cron"], минута, час, день, месяц, деньНедели)
                з["действие"]()
                добавить(выполнено, з["имя"])
            конец
        конец
        аминь выполнено
    конец
конец

открой слово планировщик()
    аминь новый Планировщик()
конец

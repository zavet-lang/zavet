# Пакет «cors-правила» — гибкая настройка CORS для модуля «веб».
# Поддерживает белые списки источников, маски поддоменов ("https://*.example.com"),
# пользовательские функции проверки, credentials, Expose-Headers, Max-Age и preflight OPTIONS.

# Проверяет, подходит ли origin под один шаблон ("*", точное совпадение, "https://*.site.ru").
слово совпадает_шаблон(origin, шаблон)
    если шаблон == "*"
        аминь истина
    конец
    если нижний(origin) == нижний(шаблон)
        аминь истина
    конец
    если содержит(шаблон, "*.")
        пусть части = разделить(шаблон, "*.")
        если длина(части) == 2
            пусть префикс = нижний(части[0])
            пусть суффикс = "." + нижний(части[1])
            пусть о = нижний(origin)
            если начинается_с(о, префикс) и заканчивается_на(о, суффикс)
                пусть середина = подстрока(о, длина(префикс), длина(о) - длина(суффикс))
                если длина(середина) > 0 и не содержит(середина, "/")
                    аминь истина
                конец
            конец
        конец
    конец
    аминь ложь
конец

# Проверяет, разрешён ли переданный Origin правилами (строка, массив шаблонов или слово-предикат).
открой слово источник_разрешён(origin, источники)
    если origin == ничего или обрезать(origin) == ""
        аминь ложь
    конец
    если тип(источники) == "FUNCTION"
        аминь источники(origin) == истина
    конец
    если тип(источники) == "STRING"
        аминь совпадает_шаблон(origin, источники)
    конец
    если тип(источники) == "ARRAY"
        для ш в источники
            если совпадает_шаблон(origin, ш)
                аминь истина
            конец
        конец
    конец
    аминь ложь
конец

# Извлекает заголовок без учёта регистра.
слово заголовок_без_регистра(заголовки, имя)
    если заголовки == ничего
        аминь ничего
    конец
    пусть искомое = нижний(имя)
    для к в ключи(заголовки)
        если нижний(к) == искомое
            аминь заголовки[к]
        конец
    конец
    аминь ничего
конец

# Создаёт CORS middleware для веб.приложение().
открой слово middleware(опции = ничего)
    пусть оп = опции ?? {}
    пусть источники = получить(оп, "источники", ["*"])
    пусть методы = получить(оп, "методы", ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"])
    пусть заголовки = получить(оп, "заголовки", ["Content-Type", "Authorization", "X-Requested-With"])
    пусть открытые = получить(оп, "открытые_заголовки", [])
    пусть учётныеДанные = получить(оп, "учётные_данные", ложь)
    пусть максВозраст = получить(оп, "макс_возраст", 600)

    пусть методыСтр = соединить(методы, ", ")
    пусть заголовкиСтр = соединить(заголовки, ", ")
    пусть открытыеСтр = соединить(открытые, ", ")

    аминь слово(запрос, далее)
        пусть загЗапроса = получить(запрос, "заголовки", {})
        пусть origin = заголовок_без_регистра(загЗапроса, "Origin")
        пусть разрешён = источник_разрешён(origin, источники)
        пусть метод = верхний(получить(запрос, "метод", "GET"))

        # Preflight-запрос OPTIONS
        если метод == "OPTIONS"
            если не разрешён
                аминь {"статус": 403, "тело": "CORS: источник запрещён", "заголовки": {"Content-Type": "text/plain; charset=utf-8"}}
            конец
            пусть значOrigin = если источники == "*" и не учётныеДанные: "*" иначе: origin
            измени загОтвета = {
                "Access-Control-Allow-Origin": значOrigin,
                "Access-Control-Allow-Methods": методыСтр,
                "Access-Control-Allow-Headers": заголовкиСтр,
                "Access-Control-Max-Age": строка(максВозраст),
                "Vary": "Origin",
            }
            если учётныеДанные
                загОтвета["Access-Control-Allow-Credentials"] = "true"
            конец
            аминь {"статус": 204, "тело": "", "заголовки": загОтвета}
        конец

        пусть ответ = далее()
        если не разрешён
            аминь ответ
        конец

        если получить(ответ, "заголовки", ничего) == ничего
            ответ["заголовки"] = {}
        конец
        пусть загОтв = ответ["заголовки"]
        пусть значOrigin = если источники == "*" и не учётныеДанные: "*" иначе: origin
        загОтв["Access-Control-Allow-Origin"] = значOrigin
        загОтв["Vary"] = "Origin"
        если учётныеДанные
            загОтв["Access-Control-Allow-Credentials"] = "true"
        конец
        если открытыеСтр != ""
            загОтв["Access-Control-Expose-Headers"] = открытыеСтр
        конец

        аминь ответ
    конец
конец

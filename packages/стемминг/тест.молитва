приими стем из "./главный.молитва"

тест "приведение разных словоформ к единой основе"
    проверить(стем.основа("книга") == стем.основа("книги"))
    проверить(стем.основа("книгами") == стем.основа("книгах"))
    проверить(стем.основа("красивый") == стем.основа("красивого"))
    проверить(стем.основа("программирование") == стем.основа("программирования"))

    пусть о = стем.основы_текста("Книги и красивого программирования")
    проверить(длина(о) == 4)
    проверить(о[0] == "книг")
конец

# Пакет «стемминг» — русский стеммер (алгоритм Портера / Snowball) для приведения слов к основе.

пусть ГЛАСНЫЕ = "аеиоуыэюя"

слово это_гласная(буква)
    аминь содержит(ГЛАСНЫЕ, буква)
конец

# Находит индекс RV (область после первой гласной).
слово найти_rv(словоНиз)
    измени i = 0
    пусть дл = длина(словоНиз)
    доколе i < дл
        если это_гласная(подстрока(словоНиз, i, i + 1))
            аминь i + 1
        конец
        i = i + 1
    конец
    аминь дл
конец

# Убирает самое длинное подходящее окончание из списка в пределах хвоста.
слово обрезать_окончание(хвост, окончания)
    измени лучшее = ""
    для ок в окончания
        если заканчивается_на(хвост, ок)
            если длина(ок) > длина(лучшее)
                лучшее = ок
            конец
        конец
    конец
    если длина(лучшее) > 0
        аминь {"изм": истина, "хвост": подстрока(хвост, 0, длина(хвост) - длина(лучшее))}
    конец
    аминь {"изм": ложь, "хвост": хвост}
конец

пусть ПРИЧАСТИЯ_ДЕЕПР = ["ившись", "ывшись", "вшись", "ивши", "ывши", "вши", "ив", "ыв", "в"]
пусть ВОЗВРАТНЫЕ = ["ся", "сь"]
пусть ПРИЛАГАТЕЛЬНЫЕ = [
    "ими", "ыми", "его", "ого", "ему", "ому", "ее", "ие", "ые", "ое",
    "ей", "ий", "ый", "ой", "ем", "им", "ым", "ом", "их", "ых",
    "ую", "юю", "ая", "яя", "ою", "ею",
]
пусть ГЛАГОЛЫ = [
    "ейте", "уйте", "ила", "ыла", "ена", "ите", "или", "ыли", "ило", "ыло",
    "ено", "ует", "уют", "ены", "ить", "ыть", "ишь", "ую", "ла", "на",
    "ете", "йте", "ли", "й", "л", "ем", "н", "ло", "но", "ет", "ют",
    "ны", "ть", "ешь", "нно",
]
пусть СУЩЕСТВИТЕЛЬНЫЕ = [
    "иями", "ями", "ами", "ией", "иям", "ием", "иях", "ев", "ов", "ие",
    "ье", "еи", "ии", "ей", "ой", "ий", "ям", "ем", "ам", "ом", "о",
    "у", "ах", "иях", "ях", "ы", "ь", "ию", "ью", "ю", "ия", "ья", "я", "а", "е", "и", "й",
]

# Приводит одно русское слово к основе (стему).
открой слово основа(словоВход)
    если словоВход == ничего
        аминь ""
    конец
    пусть s = заменить(нижний(обрезать(строка(словоВход))), "ё", "е")
    пусть rv = найти_rv(s)
    если rv >= длина(s)
        аминь s
    конец

    пусть начало = подстрока(s, 0, rv)
    измени хвост = подстрока(s, rv, длина(s))

    # Шаг 1: деепричастия -> возвратные -> прилагательные / глаголы / существительные
    пусть р1 = обрезать_окончание(хвост, ПРИЧАСТИЯ_ДЕЕПР)
    если р1["изм"]
        хвост = р1["хвост"]
    иначе
        пусть рВозвр = обрезать_окончание(хвост, ВОЗВРАТНЫЕ)
        хвост = рВозвр["хвост"]

        пусть рПрил = обрезать_окончание(хвост, ПРИЛАГАТЕЛЬНЫЕ)
        если рПрил["изм"]
            хвост = рПрил["хвост"]
        иначе
            пусть рГлаг = обрезать_окончание(хвост, ГЛАГОЛЫ)
            если рГлаг["изм"]
                хвост = рГлаг["хвост"]
            иначе
                пусть рСущ = обрезать_окончание(хвост, СУЩЕСТВИТЕЛЬНЫЕ)
                хвост = рСущ["хвост"]
            конец
        конец
    конец

    # Шаг 2: убрать конечное «и»
    если заканчивается_на(хвост, "и")
        хвост = подстрока(хвост, 0, длина(хвост) - 1)
    конец

    # Шаг 3: двойное «нн» -> «н» или конечный «ь»
    если заканчивается_на(хвост, "нн")
        хвост = подстрока(хвост, 0, длина(хвост) - 1)
    иначеесли заканчивается_на(хвост, "ь")
        хвост = подстрока(хвост, 0, длина(хвост) - 1)
    конец

    аминь начало + хвост
конец

# Приводит все слова текста к основам (возвращает массив основ).
открой слово основы_текста(текст)
    если текст == ничего
        аминь []
    конец
    пусть чист = обрезать(регвыр.заменить(нижний(строка(текст)), '[^а-яёa-z0-9]+', " "))
    если чист == ""
        аминь []
    конец
    измени итог = []
    для w в разделить(чист, " ")
        если длина(w) > 0
            добавить(итог, основа(w))
        конец
    конец
    аминь итог
конец

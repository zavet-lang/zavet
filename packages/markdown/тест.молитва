приими md из "./главный.молитва"

тест "заголовки, списки, код, ссылки и защита от XSS"
    пусть текст = "# Завет\n\nЯзык с **русскими** *словами* и `кодом`.\n\n- первый\n- второй\n\n> Цитата\n\n```\n<script>alert(1)</script>\n```\n\n[Сайт](https://zavet.ru) и [плохая](javascript:alert(1))"
    пусть html = md.в_html(текст)

    проверить(содержит(html, "<h1>Завет</h1>"))
    проверить(содержит(html, "<strong>русскими</strong>"))
    проверить(содержит(html, "<em>словами</em>"))
    проверить(содержит(html, "<code>кодом</code>"))
    проверить(содержит(html, "<ul>\n<li>первый</li>\n<li>второй</li>\n</ul>"))
    проверить(содержит(html, "<blockquote><p>Цитата</p></blockquote>"))
    проверить(содержит(html, "&lt;script&gt;alert(1)&lt;/script&gt;"))
    проверить(содержит(html, '<a href="https://zavet.ru">Сайт</a>'))
    проверить(не содержит(html, 'href="javascript:'))

# Пакет «markdown» — рендеринг Markdown в безопасный HTML (с экранированием HTML-тегов).
# Поддерживает: заголовки h1–h6, блоки кода ```, цитаты >, списки - / * / 1.,
# горизонтальные линии ---, абзацы, инлайн-код `...`, **жирный**, *курсив* и [ссылки](url).

# Разбирает инлайн-разметку в экранированной строке.
открой слово рендер_инлайн(текст)
    измени s = шаблон.экранировать(текст)
    # Инлайн-код `...`
    s = регвыр.заменить(s, '`([^`]+)`', "<code>$1</code>")
    # Ссылки [текст](url) — разрешаем только http(s), / и #
    s = регвыр.заменить(s, '\\[([^\\]]+)\\]\\((https?://[^)\\s]+|/[^)\\s]*|#[^)\\s]*)\\)', '<a href="$2">$1</a>')
    # Жирный **...**
    s = регвыр.заменить(s, '\\*\\*([^*]+)\\*\\*', "<strong>$1</strong>")
    # Курсив *...*
    s = регвыр.заменить(s, '\\*([^*]+)\\*', "<em>$1</em>")
    аминь s
конец

# Преобразует Markdown-документ в HTML.
открой слово в_html(текст)
    если текст == ничего
        аминь ""
    конец
    пусть строки = разделить(заменить(строка(текст), "\r\n", "\n"), "\n")
    измени вых = []
    измени вКоде = ложь
    измени буферКода = []
    измени типСписка = ""
    измени абзац = []

    слово сбросить_абзац()
        если длина(абзац) > 0
            добавить(вых, "<p>" + рендер_инлайн(соединить(абзац, " ")) + "</p>")
            абзац = []
        конец
    конец

    слово закрыть_список()
        если типСписка != ""
            добавить(вых, "</" + типСписка + ">")
            типСписка = ""
        конец
    конец

    для строкаТ в строки
        пусть обр = обрезать(строкаТ)

        # Ограждённый блок кода ```
        если начинается_с(обр, "```")
            сбросить_абзац()
            закрыть_список()
            если не вКоде
                вКоде = истина
                буферКода = []
            иначе
                добавить(вых, "<pre><code>" + шаблон.экранировать(соединить(буферКода, "\n")) + "</code></pre>")
                вКоде = ложь
                буферКода = []
            конец
            продолжи
        конец

        если вКоде
            добавить(буферКода, строкаТ)
            продолжи
        конец

        # Пустая строка
        если обр == ""
            сбросить_абзац()
            закрыть_список()
            продолжи
        конец

        # Горизонтальная линия
        если обр == "---" или обр == "***"
            сбросить_абзац()
            закрыть_список()
            добавить(вых, "<hr>")
            продолжи
        конец

        # Заголовки # .. ######
        если начинается_с(обр, "#")
            измени уровень = 0
            доколе уровень < длина(обр) и уровень < 6
                если подстрока(обр, уровень, уровень + 1) == "#"
                    уровень = уровень + 1
                иначе
                    прерви
                конец
            конец
            если уровень > 0 и уровень < длина(обр)
                если подстрока(обр, уровень, уровень + 1) == " "
                    сбросить_абзац()
                    закрыть_список()
                    пусть заг = обрезать(подстрока(обр, уровень + 1, длина(обр)))
                    добавить(вых, "<h" + строка(уровень) + ">" + рендер_инлайн(заг) + "</h" + строка(уровень) + ">")
                    продолжи
                конец
            конец
        конец

        # Цитата >
        если начинается_с(обр, "> ")
            сбросить_абзац()
            закрыть_список()
            добавить(вых, "<blockquote><p>" + рендер_инлайн(обрезать(подстрока(обр, 2, длина(обр)))) + "</p></blockquote>")
            продолжи
        конец

        # Маркированный список (- или *)
        если начинается_с(обр, "- ") или начинается_с(обр, "* ")
            сбросить_абзац()
            если типСписка != "ul"
                закрыть_список()
                добавить(вых, "<ul>")
                типСписка = "ul"
            конец
            добавить(вых, "<li>" + рендер_инлайн(обрезать(подстрока(обр, 2, длина(обр)))) + "</li>")
            продолжи
        конец

        # Нумерованный список (1. 2. ...)
        если регвыр.совпадает(обр, '^[0-9]+\\.\\s+')
            сбросить_абзац()
            если типСписка != "ol"
                закрыть_список()
                добавить(вых, "<ol>")
                типСписка = "ol"
            конец
            пусть пункт = регвыр.заменить(обр, '^[0-9]+\\.\\s+', "")
            добавить(вых, "<li>" + рендер_инлайн(пункт) + "</li>")
            продолжи
        конец

        # Обычная строка абзаца
        закрыть_список()
        добавить(абзац, обр)
    конец

    если вКоде
        добавить(вых, "<pre><code>" + шаблон.экранировать(соединить(буферКода, "\n")) + "</code></pre>")
    конец
    сбросить_абзац()
    закрыть_список()
    аминь соединить(вых, "\n")
конец

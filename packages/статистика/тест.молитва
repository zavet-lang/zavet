приими стат из "./главный.молитва"

тест "среднее, медиана, мода, перцентили, корреляция и регрессия"
    пусть д = [2, 4, 4, 4, 5, 5, 7, 9]
    проверить(абс(стат.среднее(д) - 5.0) < 0.0001)
    проверить(абс(стат.медиана(д) - 4.5) < 0.0001)
    проверить(стат.мода(д) == 4)
    проверить(абс(стат.отклонение(д) - 2.0) < 0.0001)
    проверить(абс(стат.перцентиль([10, 20, 30, 40, 50], 50) - 30.0) < 0.0001)

    пусть рег = стат.регрессия([1, 2, 3, 4], [3, 5, 7, 9])
    проверить(абс(рег["наклон"] - 2.0) < 0.0001)
    проверить(абс(рег["смещение"] - 1.0) < 0.0001)
    проверить(абс(рег["r"] - 1.0) < 0.0001)
конец

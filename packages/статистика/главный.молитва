# Пакет «статистика» — описательная статистика, квантили, корреляция и линейная регрессия.

открой слово сумма(массив)
    измени s = 0.0
    для x в массив
        s = s + (x * 1.0)
    конец
    аминь s
конец

открой слово среднее(массив)
    если длина(массив) == 0
        бросить("пустой массив для среднего")
    конец
    аминь сумма(массив) / (длина(массив) * 1.0)
конец

слово сортировать_числа(массив)
    измени к = []
    для x в массив
        добавить(к, x * 1.0)
    конец
    пусть n = длина(к)
    измени i = 0
    доколе i < n
        измени j = 0
        доколе j < n - 1 - i
            если к[j] > к[j + 1]
                пусть t = к[j]
                к[j] = к[j + 1]
                к[j + 1] = t
            конец
            j = j + 1
        конец
        i = i + 1
    конец
    аминь к
конец

открой слово медиана(массив)
    если длина(массив) == 0
        бросить("пустой массив для медианы")
    конец
    пусть с = сортировать_числа(массив)
    пусть n = длина(с)
    пусть пол = (n - (n % 2)) / 2
    если n % 2 == 1
        аминь с[пол]
    конец
    аминь (с[пол - 1] + с[пол]) / 2.0
конец

# Наиболее часто встречающееся значение.
открой слово мода(массив)
    если длина(массив) == 0
        бросить("пустой массив для моды")
    конец
    измени счет = {}
    измени лучшее = массив[0]
    измени максЧ = 0
    для x в массив
        пусть к = строка(x)
        пусть n = получить(счет, к, 0) + 1
        счет[к] = n
        если n > максЧ
            максЧ = n
            лучшее = x
        конец
    конец
    аминь лучшее
конец

# Дисперсия (генеральная по умолчанию, выборочная при выборочная=истина).
открой слово дисперсия(массив, выборочная = ложь)
    пусть n = длина(массив)
    если n == 0
        бросить("пустой массив для дисперсии")
    конец
    если выборочная и n < 2
        бросить("нужно минимум 2 элемента для выборочной дисперсии")
    конец
    пусть м = среднее(массив)
    измени s = 0.0
    для x в массив
        пусть d = (x * 1.0) - м
        s = s + (d * d)
    конец
    пусть дел = если выборочная: (n - 1) * 1.0 иначе: n * 1.0
    аминь s / дел
конец

открой слово отклонение(массив, выборочная = ложь)
    аминь корень(дисперсия(массив, выборочная))
конец

# Перцентиль p в [0..100] с линейной интерполяцией.
открой слово перцентиль(массив, p)
    если длина(массив) == 0
        бросить("пустой массив для перцентиля")
    конец
    пусть с = сортировать_числа(массив)
    пусть n = длина(с)
    если n == 1
        аминь с[0]
    конец
    пусть поз = (p / 100.0) * ((n - 1) * 1.0)
    измени низ = 0
    доколе (низ + 1) * 1.0 <= поз
        низ = низ + 1
    конец
    пусть верх = если низ + 1 < n: низ + 1 иначе: n - 1
    пусть вес = поз - (низ * 1.0)
    аминь с[низ] * (1.0 - вес) + с[верх] * вес
конец

# Коэффициент корреляции Пирсона двух рядов одинаковой длины.
открой слово корреляция(xs, ys)
    пусть n = длина(xs)
    если n == 0 или n != длина(ys)
        бросить("ряды должны быть непустыми и равной длины")
    конец
    пусть mx = среднее(xs)
    пусть my = среднее(ys)
    измени числ = 0.0
    измени sx = 0.0
    измени sy = 0.0
    измени i = 0
    доколе i < n
        пусть dx = (xs[i] * 1.0) - mx
        пусть dy = (ys[i] * 1.0) - my
        числ = числ + dx * dy
        sx = sx + dx * dx
        sy = sy + dy * dy
        i = i + 1
    конец
    пусть знам = корень(sx * sy)
    если знам == 0.0
        аминь 0.0
    конец
    аминь числ / знам
конец

# Линейная регрессия y = наклон * x + смещение.
открой слово регрессия(xs, ys)
    пусть n = длина(xs)
    если n < 2 или n != длина(ys)
        бросить("для регрессии нужно минимум 2 пары точек")
    конец
    пусть mx = среднее(xs)
    пусть my = среднее(ys)
    измени числ = 0.0
    измени знам = 0.0
    измени i = 0
    доколе i < n
        пусть dx = (xs[i] * 1.0) - mx
        числ = числ + dx * ((ys[i] * 1.0) - my)
        знам = знам + dx * dx
        i = i + 1
    конец
    пусть наклон = если знам == 0.0: 0.0 иначе: числ / знам
    пусть смещение = my - наклон * mx
    аминь {"наклон": наклон, "смещение": смещение, "r": корреляция(xs, ys)}
конец

# Полная сводка по выборке.
открой слово сводка(массив)
    пусть с = сортировать_числа(массив)
    аминь {
        "количество": длина(с),
        "сумма": сумма(с),
        "мин": с[0],
        "макс": с[длина(с) - 1],
        "среднее": среднее(с),
        "медиана": медиана(с),
        "отклонение": отклонение(с),
        "p95": перцентиль(с, 95),
    }
конец

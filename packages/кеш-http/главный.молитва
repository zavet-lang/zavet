# Пакет «кеш-http» — ETag, 304 Not Modified, Last-Modified и Cache-Control для модуля «веб».

# Вычисляет ETag для строки тела. При слабый = истина добавляет префикс W/.
открой слово etag(тело, слабый = ложь)
    пусть текст = если тело == ничего: "" иначе: строка(тело)
    пусть хеш = подстрока(крипто.sha256(текст), 0, 24)
    пусть тег = '"' + хеш + '"'
    аминь если слабый: "W/" + тег иначе: тег
конец

# Сравнивает ETag со значением заголовка If-None-Match (поддерживает список через запятую и *).
открой слово etag_совпадает(тег, ifNoneMatch)
    если ifNoneMatch == ничего
        аминь ложь
    конец
    если обрезать(ifNoneMatch) == ""
        аминь ложь
    конец
    пусть заголовок = обрезать(ifNoneMatch)
    если заголовок == "*"
        аминь истина
    конец
    пусть нормТег = если начинается_с(тег, "W/"): подстрока(тег, 2, длина(тег)) иначе: тег
    для часть в разделить(заголовок, ",")
        пусть к = обрезать(часть)
        пусть нормК = если начинается_с(к, "W/"): подстрока(к, 2, длина(к)) иначе: к
        если нормК == нормТег
            аминь истина
        конец
    конец
    аминь ложь
конец

# Собирает строку заголовка Cache-Control из словаря опций:
# публичный, приватный, без_хранения, без_кеша, перепроверять, неизменяемый, макс_возраст, s_maxage.
открой слово cache_control(опции)
    пусть оп = опции ?? {}
    измени части = []
    если получить(оп, "без_хранения", ложь)
        добавить(части, "no-store")
        аминь соединить(части, ", ")
    конец
    если получить(оп, "публичный", ложь)
        добавить(части, "public")
    иначеесли получить(оп, "приватный", ложь)
        добавить(части, "private")
    конец
    если получить(оп, "без_кеша", ложь)
        добавить(части, "no-cache")
    конец
    пусть maxAge = получить(оп, "макс_возраст", ничего)
    если maxAge != ничего
        добавить(части, "max-age=" + строка(maxAge))
    конец
    пусть sMaxAge = получить(оп, "s_maxage", ничего)
    если sMaxAge != ничего
        добавить(части, "s-maxage=" + строка(sMaxAge))
    конец
    если получить(оп, "перепроверять", ложь)
        добавить(части, "must-revalidate")
    конец
    если получить(оп, "неизменяемый", ложь)
        добавить(части, "immutable")
    конец
    аминь соединить(части, ", ")
конец

слово заголовок(заголовки, имя)
    если заголовки == ничего
        аминь ничего
    конец
    пусть низ = нижний(имя)
    для к в ключи(заголовки)
        если нижний(к) == низ
            аминь заголовки[к]
        конец
    конец
    аминь ничего
конец

# Middleware для веб.приложение(): добавляет ETag и Cache-Control на GET/HEAD 200,
# а при совпадении If-None-Match возвращает 304 Not Modified без тела.
открой слово middleware(опции = ничего)
    пусть оп = опции ?? {}
    пусть слабый = получить(оп, "слабый_etag", ложь)
    пусть cc = получить(оп, "cache_control", ничего)
    измени ccСтр = ""
    если cc != ничего
        ccСтр = если тип(cc) == "STRING": cc иначе: cache_control(cc)
    конец

    аминь слово(запрос, далее)
        пусть ответ = далее()
        пусть метод = верхний(получить(запрос, "метод", "GET"))
        пусть статус = получить(ответ, "статус", 200)
        если (метод != "GET" и метод != "HEAD") или статус != 200
            аминь ответ
        конец

        если получить(ответ, "заголовки", ничего) == ничего
            ответ["заголовки"] = {}
        конец
        пусть загОтв = ответ["заголовки"]

        если ccСтр != "" и заголовок(загОтв, "Cache-Control") == ничего
            загОтв["Cache-Control"] = ccСтр
        конец

        измени тег = заголовок(загОтв, "ETag")
        если тег == ничего
            тег = etag(получить(ответ, "тело", ""), слабый)
            загОтв["ETag"] = тег
        конец

        пусть inm = заголовок(получить(запрос, "заголовки", {}), "If-None-Match")
        если etag_совпадает(тег, inm)
            измени заг304 = {"ETag": тег}
            если ccСтр != ""
                заг304["Cache-Control"] = ccСтр
            конец
            аминь {"статус": 304, "тело": "", "заголовки": заг304}
        конец

        аминь ответ
    конец
конец

# Проверяет условие Last-Modified / If-Modified-Since и возвращает 304, если дата не изменилась.
открой слово проверить_дату(запрос, датаИзмененияСтр)
    пусть ims = заголовок(получить(запрос, "заголовки", {}), "If-Modified-Since")
    если ims != ничего
        если обрезать(ims) == обрезать(датаИзмененияСтр)
            аминь {"статус": 304, "тело": "", "заголовки": {"Last-Modified": датаИзмененияСтр}}
        конец
    конец
    аминь ничего
конец

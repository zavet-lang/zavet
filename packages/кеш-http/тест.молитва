приими кеш из "./главный.молитва"

тест "etag, слабый etag и If-None-Match"
    пусть т1 = кеш.etag("привет")
    пусть т2 = кеш.etag("привет", истина)
    проверить(начинается_с(т2, "W/"))
    проверить(кеш.etag_совпадает(т1, т1) == истина)
    проверить(кеш.etag_совпадает(т1, т2) == истина)
    проверить(кеш.etag_совпадает(т1, '"other", ' + т1) == истина)
    проверить(кеш.etag_совпадает(т1, "*") == истина)
    проверить(кеш.etag_совпадает(т1, '"wrong"') == ложь)
конец

тест "конструктор Cache-Control"
    пусть s1 = кеш.cache_control({"публичный": истина, "макс_возраст": 3600, "неизменяемый": истина})
    проверить(s1 == "public, max-age=3600, immutable")
    пусть s2 = кеш.cache_control({"без_хранения": истина, "публичный": истина})
    проверить(s2 == "no-store")
конец

тест "middleware возвращает 304 при совпадении ETag"
    пусть app = веб.приложение()
    app.использовать(кеш.middleware({"cache_control": {"публичный": истина, "макс_возраст": 120}}))
    app.получить("/doc", слово(запрос): веб.json({"версия": 1}))

    пусть r1 = app.обработать("GET", "/doc")
    проверить(r1["статус"] == 200)
    пусть тег = r1["заголовки"]["ETag"]
    проверить(r1["заголовки"]["Cache-Control"] == "public, max-age=120")

    пусть r2 = app.обработать("GET", "/doc", "", {"If-None-Match": тег})
    проверить(r2["статус"] == 304)
    проверить(r2["тело"] == "")
конец

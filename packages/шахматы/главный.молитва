# Пакет «шахматы» — доска 8x8, нотация FEN, проверка легальности ходов и текстовая отрисовка.

пусть ФАЙЛЫ = "abcdefgh"
пусть НАЧАЛЬНЫЙ_FEN = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w"

слово это_белая(ф)
    аминь ф != "" и содержит("PNBRQK", ф)
конец

слово это_чёрная(ф)
    аминь ф != "" и содержит("pnbrqk", ф)
конец

слово клетка_в_коорд(клетка)
    если длина(клетка) != 2
        аминь ничего
    конец
    пусть col = найти(ФАЙЛЫ, нижний(подстрока(клетка, 0, 1)))
    пусть ряд = 8 - число(подстрока(клетка, 1, 2))
    если col < 0 или col > 7 или ряд < 0 или ряд > 7
        аминь ничего
    конец
    аминь {"r": ряд, "c": col}
конец

открой образ Доска
    поля: клетки, ход, история

    слово создать(fen = НАЧАЛЬНЫЙ_FEN)
        это.клетки = []
        это.ход = "w"
        это.история = []
        это.из_fen(fen)
    конец

    слово из_fen(fen)
        пусть части = разделить(обрезать(fen), " ")
        пусть ряды = разделить(части[0], "/")
        это.ход = если длина(части) > 1: части[1] иначе: "w"
        это.клетки = []
        для рСтр в ряды
            измени ряд = []
            измени i = 0
            доколе i < длина(рСтр)
                пусть ch = подстрока(рСтр, i, i + 1)
                если содержит("12345678", ch)
                    измени k = 0
                    пусть n = число(ch)
                    доколе k < n
                        добавить(ряд, "")
                        k = k + 1
                    конец
                иначе
                    добавить(ряд, ch)
                конец
                i = i + 1
            конец
            добавить(это.клетки, ряд)
        конец
        аминь это
    конец

    слово в_fen()
        измени ряды = []
        измени r = 0
        доколе r < 8
            измени s = ""
            измени пуст = 0
            измени c = 0
            доколе c < 8
                пусть ф = это.клетки[r][c]
                если ф == ""
                    пуст = пуст + 1
                иначе
                    если пуст > 0
                        s = s + строка(пуст)
                        пуст = 0
                    конец
                    s = s + ф
                конец
                c = c + 1
            конец
            если пуст > 0
                s = s + строка(пуст)
            конец
            добавить(ряды, s)
            r = r + 1
        конец
        аминь соединить(ряды, "/") + " " + это.ход
    конец

    слово путь_свободен(r1, c1, r2, c2)
        пусть dr = если r2 > r1: 1 иначе: (если r2 < r1: -1 иначе: 0)
        пусть dc = если c2 > c1: 1 иначе: (если c2 < c1: -1 иначе: 0)
        измени r = r1 + dr
        измени c = c1 + dc
        доколе r != r2 или c != c2
            если это.клетки[r][c] != ""
                аминь ложь
            конец
            r = r + dr
            c = c + dc
        конец
        аминь истина
    конец

    # Проверяет и выполняет ход в формате ("e2", "e4").
    слово сходить(откуда, куда)
        пусть p1 = клетка_в_коорд(откуда)
        пусть p2 = клетка_в_коорд(куда)
        если p1 == ничего или p2 == ничего
            аминь {"ок": ложь, "ошибка": "некорректные координаты"}
        конец
        пусть r1 = p1["r"]
        пусть c1 = p1["c"]
        пусть r2 = p2["r"]
        пусть c2 = p2["c"]
        пусть ф = это.клетки[r1][c1]
        если ф == ""
            аминь {"ок": ложь, "ошибка": "на исходной клетке нет фигуры"}
        конец
        пусть бел = это_белая(ф)
        если (это.ход == "w" и не бел) или (это.ход == "b" и бел)
            аминь {"ок": ложь, "ошибка": "сейчас ход другой стороны"}
        конец
        пусть цель = это.клетки[r2][c2]
        если цель != "" и ((бел и это_белая(цель)) или (не бел и это_чёрная(цель)))
            аминь {"ок": ложь, "ошибка": "нельзя бить свою фигуру"}
        конец

        пусть dr = r2 - r1
        пусть dc = c2 - c1
        пусть adr = абс(dr)
        пусть adc = абс(dc)
        пусть типФ = нижний(ф)
        измени легален = ложь

        если типФ == "p"
            пусть напр = если бел: -1 иначе: 1
            пусть стартР = если бел: 6 иначе: 1
            если dc == 0 и dr == напр и цель == ""
                легален = истина
            иначеесли dc == 0 и r1 == стартР и dr == 2 * напр и цель == "" и это.клетки[r1 + напр][c1] == ""
                легален = истина
            иначеесли adc == 1 и dr == напр и цель != ""
                легален = истина
            конец
        иначеесли типФ == "n"
            легален = (adr == 2 и adc == 1) или (adr == 1 и adc == 2)
        иначеесли типФ == "b"
            легален = adr == adc и adr > 0 и это.путь_свободен(r1, c1, r2, c2)
        иначеесли типФ == "r"
            легален = (dr == 0 или dc == 0) и (adr + adc > 0) и это.путь_свободен(r1, c1, r2, c2)
        иначеесли типФ == "q"
            легален = (dr == 0 или dc == 0 или adr == adc) и (adr + adc > 0) и это.путь_свободен(r1, c1, r2, c2)
        иначеесли типФ == "k"
            легален = adr <= 1 и adc <= 1 и (adr + adc > 0)
        конец

        если не легален
            аминь {"ок": ложь, "ошибка": "недопустимый ход фигуры"}
        конец

        это.клетки[r2][c2] = ф
        это.клетки[r1][c1] = ""
        это.ход = если это.ход == "w": "b" иначе: "w"
        добавить(это.история, откуда + "-" + куда)
        аминь {"ок": истина, "взято": цель, "ход": откуда + "-" + куда}
    конец

    слово нарисовать()
        измени линии = []
        измени r = 0
        доколе r < 8
            измени стр = строка(8 - r) + " "
            измени c = 0
            доколе c < 8
                пусть ф = это.клетки[r][c]
                стр = стр + (если ф == "": "." иначе: ф) + " "
                c = c + 1
            конец
            добавить(линии, стр)
            r = r + 1
        конец
        добавить(линии, "  a b c d e f g h")
        аминь соединить(линии, "\n")
    конец
конец

открой слово новая_партия(fen = НАЧАЛЬНЫЙ_FEN)
    аминь новый Доска(fen)
конец

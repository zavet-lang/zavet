приими шах из "./главный.молитва"

тест "ходы, проверка правил и FEN"
    пусть д = шах.новая_партия()
    проверить(д.сходить("e2", "e4")["ок"] == истина)
    проверить(д.сходить("e4", "e5")["ок"] == ложь) # ход чёрных
    проверить(д.сходить("e7", "e5")["ок"] == истина)
    проверить(д.сходить("g1", "f3")["ок"] == истина)
    проверить(д.сходить("b8", "c6")["ок"] == истина)
    проверить(д.сходить("f1", "b5")["ок"] == истина) # Испанская партия
    проверить(длина(д.история) == 5)
    проверить(содержит(д.нарисовать(), "a b c d e f g h"))
    проверить(содержит(д.в_fen(), " b"))
конец

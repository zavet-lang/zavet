# Пакет «морфология» — русское согласование числительных, числа прописью и работа с регистром.

# Выбирает правильную форму слова для числа n: форма1 ("файл"), форма2 ("файла"), форма5 ("файлов").
открой слово форма(n, форма1, форма2, форма5)
    пусть м = абс(n) % 100
    если м >= 11 и м <= 19
        аминь форма5
    конец
    пусть посл = м % 10
    если посл == 1
        аминь форма1
    конец
    если посл >= 2 и посл <= 4
        аминь форма2
    конец
    аминь форма5
конец

# Возвращает строку вида "5 файлов", "2 книги", "1 день".
открой слово с_числом(n, форма1, форма2, форма5)
    аминь строка(n) + " " + форма(n, форма1, форма2, форма5)
конец

# Переводит первую букву строки в верхний регистр.
открой слово с_заглавной(текст)
    если текст == ничего
        аминь ""
    конец
    пусть s = строка(текст)
    если длина(s) == 0
        аминь ""
    конец
    аминь верхний(подстрока(s, 0, 1)) + подстрока(s, 1, длина(s))
конец

# Делает заглавной первую букву каждого слова.
открой слово каждое_слово_с_заглавной(текст)
    если текст == ничего
        аминь ""
    конец
    пусть слова = разделить(строка(текст), " ")
    измени итог = []
    для с в слова
        добавить(итог, с_заглавной(с))
    конец
    аминь соединить(итог, " ")
конец

пусть ЕДИНИЦЫ_М = ["", "один", "два", "три", "четыре", "пять", "шесть", "семь", "восемь", "девять"]
пусть ЕДИНИЦЫ_Ж = ["", "одна", "две", "три", "четыре", "пять", "шесть", "семь", "восемь", "девять"]
пусть ДЕСЯТЬ_19 = ["десять", "одиннадцать", "двенадцать", "тринадцать", "четырнадцать", "пятнадцать", "шестнадцать", "семнадцать", "восемнадцать", "девятнадцать"]
пусть ДЕСЯТКИ = ["", "", "двадцать", "тридцать", "сорок", "пятьдесят", "шестьдесят", "семьдесят", "восемьдесят", "девяносто"]
пусть СОТНИ = ["", "сто", "двести", "триста", "четыреста", "пятьсот", "шестьсот", "семьсот", "восемьсот", "девятьсот"]

слово триада_прописью(n, женский = ложь)
    измени части = []
    пусть с = (n - (n % 100)) / 100
    пусть ост = n % 100
    если с > 0
        добавить(части, СОТНИ[с])
    конец
    если ост >= 10 и ост <= 19
        добавить(части, ДЕСЯТЬ_19[ост - 10])
    иначе
        пусть д = (ост - (ост % 10)) / 10
        пусть е = ост % 10
        если д > 0
            добавить(части, ДЕСЯТКИ[д])
        конец
        если е > 0
            пусть табл = если женский: ЕДИНИЦЫ_Ж иначе: ЕДИНИЦЫ_М
            добавить(части, табл[е])
        конец
    конец
    аминь соединить(части, " ")
конец

# Преобразует целое число (до 999 999 999) в русские слова.
открой слово число_прописью(n, женский = ложь)
    если n == 0
        аминь "ноль"
    конец
    измени знак = ""
    измени знач = n
    если знач < 0
        знак = "минус "
        знач = -знач
    конец

    измени части = []
    пусть млн = (знач - (знач % 1000000)) / 1000000
    пусть остаток1 = знач % 1000000
    пусть тыс = (остаток1 - (остаток1 % 1000)) / 1000
    пусть ед = остаток1 % 1000

    если млн > 0
        добавить(части, триада_прописью(млн, ложь) + " " + форма(млн, "миллион", "миллиона", "миллионов"))
    конец
    если тыс > 0
        добавить(части, триада_прописью(тыс, истина) + " " + форма(тыс, "тысяча", "тысячи", "тысяч"))

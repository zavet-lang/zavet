приими морф из "./главный.молитва"

тест "согласование числительных"
    проверить(морф.с_числом(1, "файл", "файла", "файлов") == "1 файл")
    проверить(морф.с_числом(2, "файл", "файла", "файлов") == "2 файла")
    проверить(морф.с_числом(5, "файл", "файла", "файлов") == "5 файлов")
    проверить(морф.с_числом(11, "файл", "файла", "файлов") == "11 файлов")
    проверить(морф.с_числом(21, "файл", "файла", "файлов") == "21 файл")
    проверить(морф.с_числом(104, "книга", "книги", "книг") == "104 книги")
конец

тест "числа прописью и рубли"
    проверить(морф.число_прописью(0) == "ноль")
    проверить(морф.число_прописью(42) == "сорок два")
    проверить(морф.число_прописью(1234) == "одна тысяча двести тридцать четыре")
    проверить(морф.число_прописью(-15) == "минус пятнадцать")
    проверить(морф.рубли_прописью(101, 2) == "Сто один рубль 2 копейки")
    проверить(морф.каждое_слово_с_заглавной("иван петров") == "Иван Петров")
конец

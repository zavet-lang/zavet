приими прог из "./главный.молитва"

тест "полоса прогресса и спиннер"
    пусть п = прог.полоса(10, 10, "Сборка")
    п.шаг(5)
    проверить(п.процент() == 50)
    проверить(п.строка_полосы() == "Сборка [█████░░░░░] 50% (5/10)")

    п.шаг(10)
    проверить(п.процент() == 100)
    проверить(длина(прог.кадр_спиннера(3)) > 0)
конец

# Пакет «прогресс» — полоса прогресса и спиннер для консольных утилит.

пусть КАДРЫ_СПИННЕРА = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

слово повтор(симв, n)
    измени s = ""
    измени i = 0
    доколе i < n
        s = s + симв
        i = i + 1
    конец
    аминь s
конец

открой образ ПолосаПрогресса
    поля: всего, текущее, ширина, заголовок, старт_мс

    слово создать(всего, ширина = 20, заголовок = "")
        это.всего = если всего <= 0: 1 иначе: всего
        это.текущее = 0
        это.ширина = ширина
        это.заголовок = заголовок
        это.старт_мс = время.метка()
    конец

    слово шаг(дельта = 1)
        это.текущее = это.текущее + дельта
        если это.текущее > это.всего
            это.текущее = это.всего
        конец
        аминь это
    конец

    слово установить(значение)
        это.текущее = значение
        если это.текущее < 0
            это.текущее = 0
        конец
        если это.текущее > это.всего
            это.текущее = это.всего
        конец
        аминь это
    конец

    слово процент()
        аминь (это.текущее * 100 - ((это.текущее * 100) % это.всего)) / это.всего
    конец

    слово строка_полосы()
        пусть зап = (это.текущее * это.ширина - ((это.текущее * это.ширина) % это.всего)) / это.всего
        пусть пуст = это.ширина - зап
        пусть преф = если длина(это.заголовок) > 0: это.заголовок + " " иначе: ""
        аминь преф + "[" + повтор("█", зап) + повтор("░", пуст) + "] " +
            строка(это.процент()) + "% (" + строка(это.текущее) + "/" + строка(это.всего) + ")"
    конец
конец

открой слово полоса(всего, ширина = 20, заголовок = "")
    аминь новый ПолосаПрогресса(всего, ширина, заголовок)
конец

открой слово кадр_спиннера(шаг)
    аминь КАДРЫ_СПИННЕРА[абс(шаг) % длина(КАДРЫ_СПИННЕРА)]
конец

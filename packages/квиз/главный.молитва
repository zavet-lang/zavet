# Пакет «квиз» — движок викторин, тестов и подсчёта оценок.

открой образ Викторина
    поля: название, вопросы, индекс, ответы

    слово создать(название, вопросы = [])
        это.название = название
        это.вопросы = вопросы
        это.индекс = 0
        это.ответы = []
    конец

    слово добавить_вопрос(текст, варианты, верныйИндекс, баллы = 1, пояснение = "")
        добавить(это.вопросы, {
            "текст": текст,
            "варианты": варианты,
            "верный": верныйИндекс,
            "баллы": баллы,
            "пояснение": пояснение,
        })
        аминь это
    конец

    слово текущий_вопрос()
        если это.индекс >= длина(это.вопросы)
            аминь ничего
        конец
        аминь это.вопросы[это.индекс]
    конец

    слово завершена()
        аминь это.индекс >= длина(это.вопросы)
    конец

    слово ответить(индексВарианта)
        если это.завершена()
            бросить("викторина уже завершена")
        конец
        пусть вопр = это.вопросы[это.индекс]
        пусть верно = индексВарианта == вопр["верный"]
        добавить(это.ответы, {
            "вопрос": вопр["текст"],
            "выбрано": индексВарианта,
            "верный": вопр["верный"],
            "верно": верно,
            "баллы": если верно: вопр["баллы"] иначе: 0,
            "макс_баллов": вопр["баллы"],
            "пояснение": получить(вопр, "пояснение", ""),
        })
        это.индекс = это.индекс + 1
        аминь {"верно": верно, "пояснение": получить(вопр, "пояснение", "")}
    конец

    слово итог()
        измени набрано = 0
        измени всегоБаллов = 0
        измени верных = 0
        для о в это.ответы
            набрано = набрано + о["баллы"]
            всегоБаллов = всегоБаллов + о["макс_баллов"]
            если о["верно"]
                верных = верных + 1
            конец
        конец
        пусть проц = если всегоБаллов == 0: 0 иначе: (набрано * 100 - ((набрано * 100) % всегоБаллов)) / всегоБаллов
        пусть оценка = если проц >= 90: 5 иначе: (если проц >= 75: 4 иначе: (если проц >= 50: 3 иначе: 2))
        аминь {
            "название": это.название,
            "верных": верных,
            "всего_вопросов": длина(это.вопросы),
            "баллы": набрано,
            "макс_баллов": всегоБаллов,
            "процент": проц,
            "оценка": оценка,
            "разбор": это.ответы,
        }
    конец
конец

открой слово создать(название, вопросы = [])
    аминь новый Викторина(название, вопросы)
конец

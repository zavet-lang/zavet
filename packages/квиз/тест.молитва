приими квиз из "./главный.молитва"

тест "прохождение викторины и расчёт итоговой оценки"
    пусть к = квиз.создать("Основы Завета")
    к.добавить_вопрос("Ключевое слово функции?", ["func", "слово", "def"], 1, 2, "В Завете функции объявляются словом «слово»")
    к.добавить_вопрос("Ключевое слово возврата?", ["аминь", "return"], 0, 2)

    проверить(к.текущий_вопрос()["текст"] == "Ключевое слово функции?")
    пусть р1 = к.ответить(1)
    проверить(р1["верно"] == истина)
    пусть р2 = к.ответить(0)
    проверить(р2["верно"] == истина)
    проверить(к.завершена() == истина)

    пусть ит = к.итог()
    проверить(ит["баллы"] == 4)
    проверить(ит["процент"] == 100)
    проверить(ит["оценка"] == 5)
конец

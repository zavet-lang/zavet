# Пакет «финансы» — точные расчёты в копейках, вклады, кредиты, НДС и форматирование.

# Округление float до 2 знаков после запятой (в копейки, целое число).
открой слово в_копейки(рубли)
    пусть scaled = (рубли * 1.0) * 100.0
    пусть цел = если scaled >= 0.0: мат.пол(scaled + 0.5) иначе: мат.потолок(scaled - 0.5)
    # Преобразование float к integer через строку
    пусть s = разделить(строка(цел), ".")[0]
    аминь число(s)
конец

# Форматирует сумму в копейках в красивый вид "12 345,67 ₽".
открой слово форматировать_копейки(копейки, валюта = "₽")
    пусть знак = если копейки < 0: "-" иначе: ""
    пусть абсК = абс(копейки)
    пусть коп = абсК % 100
    пусть руб = (абсК - коп) / 100

    пусть рСтр = строка(руб)
    измени гр = ""
    пусть дл = длина(рСтр)
    измени i = 0
    доколе i < дл
        если i > 0 и ((дл - i) % 3) == 0
            гр = гр + " "
        конец
        гр = гр + подстрока(рСтр, i, i + 1)
        i = i + 1
    конец
    пусть кСтр = если коп < 10: "0" + строка(коп) иначе: строка(коп)
    аминь знак + гр + "," + кСтр + " " + валюта
конец

# Выделяет и начисляет НДС (по умолчанию 20%).
открой слово ндс_сверху(сумма, ставка = 20.0)
    пусть налог = (сумма * 1.0) * (ставка * 1.0) / 100.0
    аминь {"база": сумма * 1.0, "ндс": налог, "итого": (сумма * 1.0) + налог}
конец

открой слово ндс_внутри(итого, ставка = 20.0)
    пусть налог = (итого * 1.0) * (ставка * 1.0) / (100.0 + (ставка * 1.0))
    аминь {"база": (итого * 1.0) - налог, "ндс": налог, "итого": итого * 1.0}
конец

# Сложные проценты: итоговая сумма при годовой ставке, сроке в годах и частоте капитализации в год.
открой слово сложный_процент(сумма, годоваяСтавка, лет, капитализацийВГод = 12)
    пусть r = (годоваяСтавка * 1.0) / 100.0
    пусть n = капитализацийВГод * 1.0
    пусть t = лет * 1.0
    пусть итог = (сумма * 1.0) * степень(1.0 + r / n, n * t)
    аминь {"итого": итог, "доход": итог - (сумма * 1.0)}
конец

# Аннуитетный ежемесячный платёж по кредиту и общая переплата.
открой слово аннуитет(сумма, годоваяСтавка, месяцев)
    пусть s = сумма * 1.0
    пусть r = (годоваяСтавка * 1.0) / 100.0 / 12.0
    если r == 0.0
        пусть п = s / (месяцев * 1.0)
        аминь {"платёж": п, "всего": s, "переплата": 0.0}
    конец
    пусть k = степень(1.0 + r, месяцев)
    пусть п = s * (r * k) / (k - 1.0)
    пусть всего = п * (месяцев * 1.0)
    аминь {"платёж": п, "всего": всего, "переплата": всего - s}
конец

приими фин из "./главный.молитва"

тест "копейки, НДС, сложные проценты и аннуитет"
    проверить(фин.в_копейки(123.45) == 12345)
    проверить(фин.форматировать_копейки(1234567) == "12 345,67 ₽")

    пусть н = фин.ндс_сверху(1000, 20)
    проверить(абс(н["ндс"] - 200.0) < 0.01)
    проверить(абс(н["итого"] - 1200.0) < 0.01)

    пусть н2 = фин.ндс_внутри(1200, 20)
    проверить(абс(н2["база"] - 1000.0) < 0.01)

    пусть вкл = фин.сложный_процент(100000, 12, 1, 12)
    проверить(вкл["итого"] > 112600.0 и вкл["итого"] < 112700.0)

    пусть кр = фин.аннуитет(100000, 12, 12)
    проверить(кр["платёж"] > 8880.0 и кр["платёж"] < 8890.0)
конец

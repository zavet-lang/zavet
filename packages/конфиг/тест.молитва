приими конф из "./главный.молитва"

тест "разбор .env, слои и типизированные геттеры"
    пусть к = конф.создать({"PORT": 3000, "DEBUG": ложь})
    к.из_env_текста("# комментарий\nPORT=8888\nDEBUG=true\nAPP_NAME=\"Мой сервис\"\n")

    проверить(к.число_п("PORT") == 8888)
    проверить(к.булево_п("DEBUG") == истина)
    проверить(к.строка_п("APP_NAME") == "Мой сервис")
    проверить(к.строка_п("MISSING", "def") == "def")
    проверить(длина(к.обязательные(["PORT", "SECRET"])) == 1)
конец

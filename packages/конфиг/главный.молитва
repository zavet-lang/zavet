# Пакет «конфиг» — .env-парсер, JSON-слои и типизированный доступ к настройкам.

# Разбирает текст формата .env в словарь (поддерживает комментарии # и кавычки).
открой слово разобрать_env(текст)
    измени итог = {}
    если текст == ничего
        аминь итог
    конец
    пусть строки = разделить(заменить(строка(текст), "\r\n", "\n"), "\n")
    для стр в строки
        пусть обр = обрезать(стр)
        если обр == "" или начинается_с(обр, "#")
            продолжи
        конец
        пусть поз = найти(обр, "=")
        если поз <= 0
            продолжи
        конец
        пусть ключ = обрезать(подстрока(обр, 0, поз))
        измени знач = обрезать(подстрока(обр, поз + 1, длина(обр)))
        если длина(знач) >= 2
            пусть перв = подстрока(знач, 0, 1)
            пусть посл = подстрока(знач, длина(знач) - 1, длина(знач))
            если (перв == "\"" и посл == "\"") или (перв == "'" и посл == "'")
                знач = подстрока(знач, 1, длина(знач) - 1)
            конец
        конец
        итог[ключ] = знач
    конец
    аминь итог
конец

открой образ Конфиг
    поля: данные

    слово создать(начальные = {})
        это.данные = {}
        это.применить(начальные)
    конец

    слово применить(словарь)
        если словарь == ничего
            аминь это
        конец
        для к в ключи(словарь)
            это.данные[к] = словарь[к]
        конец
        аминь это
    конец

    слово из_env_текста(текст)
        аминь это.применить(разобрать_env(текст))
    конец

    слово из_env_файла(путь)
        если файлы.существует(путь)
            это.применить(разобрать_env(файлы.прочитать(путь)))
        конец
        аминь это
    конец

    слово из_json_файла(путь)
        если файлы.существует(путь)
            это.применить(json.разобрать(файлы.прочитать(путь)))
        конец
        аминь это
    конец

    слово строка_п(ключ, умолч = "")
        пусть v = получить(это.данные, ключ, ничего)
        если v == ничего
            аминь умолч
        конец
        аминь строка(v)
    конец

    слово число_п(ключ, умолч = 0)
        пусть v = получить(это.данные, ключ, ничего)
        если v == ничего
            аминь умолч
        конец
        если тип(v) == "ЦЕЛОЕ" или тип(v) == "ДРОБНОЕ"
            аминь v
        конец
        аминь число(строка(v))
    конец

    слово булево_п(ключ, умолч = ложь)
        пусть v = получить(это.данные, ключ, ничего)
        если v == ничего
            аминь умолч
        конец
        если тип(v) == "БУЛЕВО"
            аминь v
        конец
        пусть н = нижний(обрезать(строка(v)))
        аминь н == "1" или н == "true" или н == "истина" или н == "да" или н == "yes"
    конец

    # Проверяет наличие всех обязательных ключей; возвращает массив отсутствующих.
    слово обязательные(списокКлючей)
        измени нет = []
        для к в списокКлючей
            если получить(это.данные, к, ничего) == ничего
                добавить(нет, к)
            конец
        конец
        аминь нет
    конец
конец

открой слово создать(начальные = {})
    аминь новый Конфиг(начальные)
конец

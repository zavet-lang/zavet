приими дедуп из "./главный.молитва"

тест "поиск дубликатов по SHA-256 и план очистки"
    пусть файлы = {
        "a/doc1.txt": "одинаковый текст",
        "b/doc2.txt": "одинаковый текст",
        "c/doc3.txt": "одинаковый текст",
        "d/unique.txt": "уникальное содержимое",
    }

    пусть отчёт = дедуп.найти_в_словаре(файлы)
    проверить(длина(отчёт["группы"]) == 1)
    проверить(отчёт["лишних_файлов"] == 2)
    проверить(отчёт["группы"][0]["оригинал"] == "a/doc1.txt")

    пусть план = дедуп.план_очистки(отчёт)
    проверить(длина(план) == 2)
    проверить(план[0] == "b/doc2.txt")
    проверить(план[1] == "c/doc3.txt")
конец

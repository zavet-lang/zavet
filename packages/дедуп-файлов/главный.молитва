# Пакет «дедуп-файлов» — поиск дубликатов файлов по содержимому (SHA-256).
# Работает как со списком путей/каталогом на диске, так и с виртуальным словарём {путь: содержимое}.

# Рекурсивно собирает все файлы в каталоге.
открой слово собрать_файлы(каталог)
    измени итог = []
    если не файлы.существует(каталог)
        аминь итог
    конец
    пусть элементы = файлы.список(каталог)
    для имя в элементы
        пусть полный = путь.соединить(каталог, имя)
        если файлы.это_дир(полный)
            пусть влож = собрать_файлы(полный)
            для ф в влож
                добавить(итог, ф)
            конец
        иначе
            добавить(итог, полный)
        конец
    конец
    аминь итог
конец

# Ищет дубликаты в словаре {путь: содержимое_строкой}. Удобно для предпросмотра и тестов.
открой слово найти_в_словаре(файлыСловарь)
    измени поХешу = {}
    измени размеры = {}
    для п в ключи(файлыСловарь)
        пусть содерж = строка(файлыСловарь[п])
        пусть хеш = крипто.sha256(содерж)
        пусть список = получить(поХешу, хеш, [])
        добавить(список, п)
        поХешу[хеш] = список
        размеры[хеш] = длина(содерж)
    конец

    измени группы = []
    измени лишнихБайт = 0
    измени лишнихФайлов = 0
    для х в ключи(поХешу)
        пусть группа = поХешу[х]
        если длина(группа) > 1
            пусть отсорт = сортировать(группа, слово(а, б): а > б)
            пусть лишних = длина(отсорт) - 1
            лишнихФайлов = лишнихФайлов + лишних
            лишнихБайт = лишнихБайт + лишних * размеры[х]
            добавить(группы, {
                "хеш": х,
                "размер": размеры[х],
                "оригинал": отсорт[0],
                "дубликаты": отсорт,
            })
        конец
    конец

    аминь {
        "группы": группы,
        "лишних_файлов": лишнихФайлов,
        "лишних_байт": лишнихБайт,
    }
конец

# Сканирует папку на диске и возвращает группы дубликатов по SHA-256.
открой слово сканировать(каталог)
    пусть списокПутей = собрать_файлы(каталог)
    измени словарь = {}
    для п в списокПутей
        попытка
            словарь[п] = файлы.читать(п)
        поймать _
            продолжи
        конец
    конец
    аминь найти_в_словаре(словарь)
конец

# Формирует безопасный план очистки (оставляет первый файл в группе, остальные помечает к удалению).
открой слово план_очистки(отчёт)
    измени кУдалению = []
    для г в отчёт["группы"]
        измени i = 1
        доколе i < длина(г["дубликаты"])
            добавить(кУдалению, г["дубликаты"][i])
            i = i + 1
        конец
    конец
    аминь кУдалению
конец

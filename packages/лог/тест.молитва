приими лог из "./главный.молитва"

тест "уровни логирования, контекст и JSON-формат"
    пусть л = лог.создать({"уровень": "инфо", "формат": "текст"})
    проверить(л.отладка("скрыто") == ложь)
    проверить(л.инфо("старт", {"порт": 8080}) == истина)
    пусть доч = л.с_контекстом({"модуль": "бд"})
    доч.ошибка("сбой", {"код": 500})

    пусть зап = л.записи()
    проверить(длина(зап) == 2)
    проверить(содержит(зап[0], "[ИНФО] старт"))
    проверить(содержит(зап[1], "модуль=бд"))

    пусть лж = лог.создать({"формат": "json"})
    лж.инфо("пинг", {"мс": 12})
    пусть разб = json.разобрать(лж.записи()[0])
    проверить(разб["сообщение"] == "пинг")
    проверить(разб["мс"] == 12)
конец

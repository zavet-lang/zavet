# Пакет «лог» — структурированный логгер с уровнями, контекстом, JSON/текст-выводом и приёмниками.

пусть УРОВНИ = {"отладка": 10, "инфо": 20, "внимание": 30, "ошибка": 40}

открой образ Логгер
    поля: мин_уровень, формат, контекст, приемник, буфер

    слово создать(опции = {})
        пусть ур = нижний(строка(получить(опции, "уровень", "инфо")))
        это.мин_уровень = получить(УРОВНИ, ур, 20)
        это.формат = получить(опции, "формат", "текст")
        это.контекст = получить(опции, "контекст", {})
        это.приемник = получить(опции, "приемник", ничего)
        это.буфер = []
    конец

    # Создаёт дочерний логгер с дополнительными полями контекста.
    слово с_контекстом(поля)
        измени новыйКонт = {}
        для к в ключи(это.контекст)
            новыйКонт[к] = это.контекст[к]
        конец
        для к в ключи(поля)
            новыйКонт[к] = поля[к]
        конец
        пусть доч = новый Логгер({
            "формат": это.формат,
            "контекст": новыйКонт,
            "приемник": это.приемник,
        })
        доч.мин_уровень = это.мин_уровень
        доч.буфер = это.буфер
        аминь доч
    конец

    слово записать(уровеньИмя, сообщение, данные = {})
        пусть вес = получить(УРОВНИ, нижний(уровеньИмя), 20)
        если вес < это.мин_уровень
            аминь ложь
        конец
        измени запись = {
            "время": время.сейчас(),
            "уровень": верхний(уровеньИмя),
            "сообщение": строка(сообщение),
        }
        для к в ключи(это.контекст)
            запись[к] = это.контекст[к]
        конец
        для к в ключи(данные)
            запись[к] = данные[к]
        конец

        измени строкаВыв = ""
        если это.формат == "json"
            строкаВыв = json.создать(запись)
        иначе
            измени хвост = []
            для к в ключи(запись)
                если к != "время" и к != "уровень" и к != "сообщение"
                    добавить(хвост, к + "=" + строка(запись[к]))
                конец
            конец
            пусть доп = если длина(хвост) > 0: " | " + соединить(хвост, " ") иначе: ""
            строкаВыв = "[" + запись["уровень"] + "] " + запись["сообщение"] + доп
        конец

        добавить(это.буфер, строкаВыв)
        если это.приемник != ничего
            это.приемник(строкаВыв, запись)
        конец
        аминь истина
    конец

    слово отладка(сообщение, данные = {})
        аминь это.записать("отладка", сообщение, данные)
    конец

    слово инфо(сообщение, данные = {})
        аминь это.записать("инфо", сообщение, данные)
    конец

    слово внимание(сообщение, данные = {})
        аминь это.записать("внимание", сообщение, данные)
    конец

    слово ошибка(сообщение, данные = {})
        аминь это.записать("ошибка", сообщение, данные)
    конец

    слово записи()
        аминь это.буфер
    конец
конец

открой слово создать(опции = {})
    аминь новый Логгер(опции)
конец

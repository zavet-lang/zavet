# Пакет «индекс-поиска» — полнотекстовый инвертированный индекс в памяти.
# Поддерживает токенизацию кириллицы/латиницы, русские стоп-слова, TF-IDF ранжирование и фрагменты (сниппеты).

пусть СТОП_СЛОВА = {
    "и": истина, "в": истина, "во": истина, "не": истина, "что": истина,
    "он": истина, "на": истина, "я": истина, "с": истина, "со": истина,
    "как": истина, "а": истина, "то": истина, "все": истина, "она": истина,
    "так": истина, "его": истина, "но": истина, "да": истина, "ты": истина,
    "к": истина, "у": истина, "же": истина, "вы": истина, "за": истина,
    "бы": истина, "по": истина, "из": истина, "от": истина, "для": истина,
    "о": истина, "об": истина, "при": истина, "до": истина, "или": истина,
    "the": истина, "and": истина, "of": истина, "to": истина, "in": истина,
}

# Разбивает текст на нормализованные токены (нижний регистр, без стоп-слов).
открой слово токены(текст, убиратьСтоп = истина)
    если текст == ничего
        аминь []
    конец
    пусть чистый = регвыр.заменить(нижний(строка(текст)), '[^a-zа-яё0-9]+', " ")
    пусть слова = разделить(обрезать(чистый), " ")
    измени итог = []
    для с в слова
        пусть w = заменить(с, "ё", "е")
        если длина(w) < 2
            продолжи
        конец
        если убиратьСтоп и получить(СТОП_СЛОВА, w, ложь)
            продолжи
        конец
        добавить(итог, w)
    конец
    аминь итог
конец

# Вырезает фрагмент текста вокруг первого найденного слова запроса.
открой слово сниппет(текст, словаЗапроса, радиус = 60)
    пусть исход = строка(текст)
    пусть ниж = заменить(нижний(исход), "ё", "е")
    измени поз = -1
    для w в словаЗапроса
        пусть p = найти(ниж, w)
        если p >= 0
            поз = p
            прерви
        конец
    конец
    если поз < 0
        если длина(исход) <= радиус * 2
            аминь исход
        конец
        аминь подстрока(исход, 0, радиус * 2) + "..."
    конец
    # Приблизительная позиция в символах (найти возвращает байты, ограничиваем безопасно)
    пусть дл = длина(исход)
    пусть полПоз = (поз - (поз % 2)) / 2
    пусть старт = макс(0, полПоз - радиус)
    пусть финиш = мин(дл, старт + радиус * 2)
    пусть преф = если старт > 0: "..." иначе: ""
    пусть суф = если финиш < дл: "..." иначе: ""
    аминь преф + обрезать(подстрока(исход, старт, финиш)) + суф
конец

открой образ Индекс
    слово создать()
        это._документы = {}
        это._инверт = {}
        это._всего = 0
    конец

    # Индексирует документ с id, текстом и опциональными метаданными.
    слово добавить(ид, текст, мета = ничего)
        пусть ключ = строка(ид)
        если получить(это._документы, ключ, ничего) != ничего
            это.удалить(ключ)
        конец

        пусть списокСлов = токены(текст)
        измени частоты = {}
        для w в списокСлов
            частоты[w] = получить(частоты, w, 0) + 1
        конец

        это._документы[ключ] = {
            "id": ключ,
            "текст": текст,
            "мета": мета ?? {},
            "длина": длина(списокСлов),
            "частоты": частоты,
        }
        это._всего = это._всего + 1

        для w в ключи(частоты)
            пусть лист = получить(это._инверт, w, {})
            лист[ключ] = частоты[w]
            это._инверт[w] = лист
        конец
        аминь это
    конец

    слово удалить(ид)
        пусть ключ = строка(ид)
        пусть док = получить(это._документы, ключ, ничего)
        если док == ничего
            аминь ложь
        конец
        для w в ключи(док["частоты"])
            пусть лист = получить(это._инверт, w, ничего)
            если лист != ничего
                лист[ключ] = ничего
            конец
        конец
        это._документы[ключ] = ничего
        это._всего = это._всего - 1
        аминь истина
    конец

    # Поиск по запросу с TF-IDF ранжированием.
    слово искать(запрос, лимит = 10)
        пусть q = токены(запрос)
        если длина(q) == 0 или это._всего == 0
            аминь []
        конец

        измени очки = {}
        для w в q
            пусть лист = получить(это._инверт, w, ничего)
            если лист == ничего
                продолжи
            конец
            # Подсчёт числа документов с этим словом (df)
            измени df = 0
            для ид в ключи(лист)
                если лист[ид] != ничего
                    df = df + 1
                конец
            конец
            если df == 0
                продолжи
            конец
            пусть idf = мат.лог((это._всего + 1.0) / (df + 1.0)) + 1.0

            для ид в ключи(лист)
                пусть tf = лист[ид]
                если tf == ничего
                    продолжи
                конец
                пусть док = это._документы[ид]
                пусть нормTf = (tf * 1.0) / (макс(1, док["длина"]) * 1.0)
                очки[ид] = получить(очки, ид, 0.0) + нормTf * idf
            конец
        конец

        измени результаты = []
        для ид в ключи(очки)
            пусть док = это._документы[ид]
            добавить(результаты, {
                "id": ид,
                "оценка": очки[ид],
                "мета": док["мета"],
                "фрагмент": сниппет(док["текст"], q),
            })
        конец

        пусть отсорт = сортировать(результаты, слово(а, б): а["оценка"] < б["оценка"])
        если длина(отсорт) > лимит
            измени обрез = []
            измени i = 0
            доколе i < лимит
                добавить(обрез, отсорт[i])
                i = i + 1
            конец
            аминь обрез
        конец
        аминь отсорт
    конец

    слово всего_документов()
        аминь это._всего
    конец
конец

открой слово создать()
    аминь Индекс()
конец

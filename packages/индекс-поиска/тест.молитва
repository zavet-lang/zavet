приими поиск из "./главный.молитва"

тест "индексация, TF-IDF ранжирование, удаление и сниппет"
    пусть инд = поиск.создать()
    инд.добавить("1", "Язык программирования Завет на русском языке с модулем веб", {"заголовок": "Завет"})
    инд.добавить("2", "Рецепт борща со свёклой и капустой", {"заголовок": "Борщ"})
    инд.добавить("3", "Завет имеет встроенный веб фреймворк и веб сервер", {"заголовок": "Веб в Завете"})

    проверить(инд.всего_документов() == 3)

    пусть рез = инд.искать("веб Завет")
    проверить(длина(рез) == 2)
    # Документ 3 упоминает «веб» дважды — должен быть выше
    проверить(рез[0]["id"] == "3")
    проверить(рез[1]["id"] == "1")

    проверить(инд.удалить("3") == истина)
    проверить(инд.всего_документов() == 2)
    пусть рез2 = инд.искать("веб")
    проверить(длина(рез2) == 1)
    проверить(рез2[0]["id"] == "1")

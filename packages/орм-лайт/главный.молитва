# Пакет «орм-лайт» — безопасный построитель SQL-запросов и CRUD-репозиторий поверх «бд».

# Выполняет запрос с массивом параметров (бд принимает вариативные аргументы).
слово выполнить_с_парам(соед, sql, парам)
    аминь соед.выполнить(sql, ...парам)
конец

слово запрос_с_парам(соед, sql, парам)
    аминь соед.запрос(sql, ...парам)
конец

# Построитель SELECT-запросов с параметризацией.
открой образ Запрос
    слово создать(соед, таблица)
        это.соед = соед
        это.таблица = таблица
        это._поля = ["*"]
        это._условия = []
        это._парам = []
        это._сорт = []
        это._лимит = ничего
        это._смещение = ничего
    конец

    слово поля(списокПолей)
        это._поля = списокПолей
        аминь это
    конец

    слово где(поле, оператор, значение)
        добавить(это._условия, поле + " " + оператор + " ?")
        добавить(это._парам, значение)
        аминь это
    конец

    слово равно(поле, значение)
        аминь это.где(поле, "=", значение)
    конец

    слово в_списке(поле, значения)
        если длина(значения) == 0
            добавить(это._условия, "1 = 0")
            аминь это
        конец
        измени знаки = []
        для з в значения
            добавить(знаки, "?")
            добавить(это._парам, з)
        конец
        добавить(это._условия, поле + " IN (" + соединить(знаки, ", ") + ")")
        аминь это
    конец

    слово сортировать(поле, направление = "ASC")
        пусть напр = если верхний(направление) == "DESC": "DESC" иначе: "ASC"
        добавить(это._сорт, поле + " " + напр)
        аминь это
    конец

    слово лимит(n)
        это._лимит = n
        аминь это
    конец

    слово смещение(n)
        это._смещение = n
        аминь это
    конец

    слово собрать_sql()
        измени sql = "SELECT " + соединить(это._поля, ", ") + " FROM " + это.таблица
        если длина(это._условия) > 0
            sql = sql + " WHERE " + соединить(это._условия, " AND ")
        конец
        если длина(это._сорт) > 0
            sql = sql + " ORDER BY " + соединить(это._сорт, ", ")
        конец
        если это._лимит != ничего
            sql = sql + " LIMIT " + строка(это._лимит)
        конец
        если это._смещение != ничего
            sql = sql + " OFFSET " + строка(это._смещение)
        конец
        аминь {"sql": sql, "параметры": это._парам}
    конец

    слово все()
        пусть собр = это.собрать_sql()
        аминь запрос_с_парам(это.соед, собр["sql"], собр["параметры"])
    конец

    слово первый()
        пусть предЛимит = это._лимит
        это._лимит = 1
        пусть строки = это.все()
        это._лимит = предЛимит
        если длина(строки) == 0
            аминь ничего
        конец
        аминь строки[0]
    конец

    слово количество()
        измени sql = "SELECT COUNT(*) AS cnt FROM " + это.таблица
        если длина(это._условия) > 0
            sql = sql + " WHERE " + соединить(это._условия, " AND ")
        конец
        пусть строки = запрос_с_парам(это.соед, sql, это._парам)
        аминь строки[0]["cnt"]
    конец
конец

# CRUD-репозиторий для одной таблицы.
открой образ Репозиторий
    слово создать(соед, таблица, ключ = "id")
        это.соед = соед
        это.таблица = таблица
        это.ключ = ключ
    конец

    слово запрос()
        аминь Запрос(это.соед, это.таблица)
    конец

    слово все()
        аминь это.запрос().все()
    конец

    слово найти(ид)
        аминь это.запрос().равно(это.ключ, ид).первый()
    конец

    слово вставить(данные)
        пусть колонки = ключи(данные)
        измени знаки = []
        измени значения = []
        для к в колонки
            добавить(знаки, "?")
            добавить(значения, данные[к])
        конец
        пусть sql = "INSERT INTO " + это.таблица + " (" + соединить(колонки, ", ") + ") VALUES (" + соединить(знаки, ", ") + ")"
        выполнить_с_парам(это.соед, sql, значения)
        пусть послед = это.соед.запрос("SELECT last_insert_rowid() AS id")
        аминь послед[0]["id"]
    конец

    слово обновить(ид, данные)
        пусть колонки = ключи(данные)
        измени части = []
        измени значения = []
        для к в колонки
            добавить(части, к + " = ?")
            добавить(значения, данные[к])
        конец
        добавить(значения, ид)
        пусть sql = "UPDATE " + это.таблица + " SET " + соединить(части, ", ") + " WHERE " + это.ключ + " = ?"
        выполнить_с_парам(это.соед, sql, значения)
        аминь это.найти(ид)
    конец

    слово удалить(ид)
        это.соед.выполнить("DELETE FROM " + это.таблица + " WHERE " + это.ключ + " = ?", ид)
    конец

    слово количество()
        аминь это.запрос().количество()
    конец
конец

открой слово репозиторий(соед, таблица, ключ = "id")
    аминь Репозиторий(соед, таблица, ключ)
конец

приими орм из "./главный.молитва"

тест "CRUD-репозиторий и построитель запросов"
    пусть соед = бд.открыть(":memory:")
    соед.выполнить("CREATE TABLE books (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT, pages INTEGER)")

    пусть книги = орм.репозиторий(соед, "books")
    пусть id1 = книги.вставить({"title": "Бытие", "pages": 50})
    пусть id2 = книги.вставить({"title": "Исход", "pages": 40})
    пусть id3 = книги.вставить({"title": "Псалтирь", "pages": 150})

    проверить(книги.количество() == 3)
    проверить(книги.найти(id2)["title"] == "Исход")

    книги.обновить(id2, {"pages": 41})
    проверить(книги.найти(id2)["pages"] == 41)

    пусть большие = книги.запрос().где("pages", ">=", 41).сортировать("pages", "DESC").лимит(2).все()
    проверить(длина(большие) == 2)
    проверить(большие[0]["title"] == "Псалтирь")
    проверить(большие[1]["title"] == "Бытие")

    пусть поИд = книги.запрос().в_списке("id", [id1, id3]).количество()
    проверить(поИд == 2)

    книги.удалить(id1)
    проверить(книги.количество() == 2)
    соед.закрыть()
конец

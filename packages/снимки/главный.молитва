# Пакет «снимки» — снэпшот-тестирование (сохранение и сравнение эталонов).

открой образ ХранилищеСнимков
    поля: снимки, обновить

    слово создать(обновить = ложь)
        это.снимки = {}
        это.обновить = обновить
    конец

    # Загружает эталоны из JSON-файла (если файл существует).
    слово загрузить_из_файла(путь)
        если файлы.существует(путь)
            это.снимки = json.разобрать(файлы.прочитать(путь))
        конец
        аминь это
    конец

    # Сохраняет текущие эталоны в JSON-файл.
    слово сохранить_в_файл(путь)
        файлы.записать(путь, json.создать(это.снимки))
        аминь это
    конец

    # Сверяет значение с эталонным снимком по имени.
    # Возвращает {"ок": булево, "создан": булево, "ожидалось": строка, "получено": строка}.
    слово сверить(имя, значение)
        пусть тек = json.создать(значение)
        пусть старый = получить(это.снимки, имя, ничего)
        если старый == ничего или это.обновить
            это.снимки[имя] = тек
            аминь {"ок": истина, "создан": старый == ничего, "ожидалось": тек, "получено": тек}
        конец
        аминь {
            "ок": старый == тек,
            "создан": ложь,
            "ожидалось": старый,
            "получено": тек,
        }
    конец
конец

открой слово создать(обновить = ложь)
    аминь новый ХранилищеСнимков(обновить)
конец

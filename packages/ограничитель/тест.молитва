приими ограничитель из "./главный.молитва"

тест "токен-бакет: расход, отказ и пополнение со временем"
    измени тик = 100.0
    пусть б = ограничитель.ВедроТокенов(2, 10, слово(): тик)

    пусть р1 = б.проверка("ip1")
    проверить(р1["разрешено"] == истина)
    проверить(р1["осталось"] == 1)

    пусть р2 = б.проверка("ip1")
    проверить(р2["разрешено"] == истина)
    проверить(р2["осталось"] == 0)

    пусть р3 = б.проверка("ip1")
    проверить(р3["разрешено"] == ложь)
    проверить(р3["повтор_через"] == 5)

    тик = 105.0
    пусть р4 = б.проверка("ip1")
    проверить(р4["разрешено"] == истина)
конец

тест "скользящее окно и сброс ключа"
    измени тик = 50.0
    пусть ок = ограничитель.СкользящееОкно(2, 10, слово(): тик)
    проверить(ок.проверка("u1")["разрешено"] == истина)
    тик = 52.0
    проверить(ок.проверка("u1")["разрешено"] == истина)
    тик = 53.0
    проверить(ок.проверка("u1")["разрешено"] == ложь)

    тик = 61.0
    проверить(ок.проверка("u1")["разрешено"] == истина)

    ок.сбросить("u1")
    проверить(ок.проверка("u1")["осталось"] == 1)
конец

тест "middleware в веб: заголовки X-RateLimit и 429"
    измени тик = 1.0
    пусть лим = ограничитель.СкользящееОкно(2, 60, слово(): тик)
    пусть app = веб.приложение()
    app.использовать(ограничитель.middleware(лим))
    app.получить("/ping", слово(запрос): веб.текст("ok"))

    пусть r1 = app.обработать("GET", "/ping", "", {"X-Real-IP": "10.0.0.1"})
    проверить(r1["статус"] == 200)
    проверить(r1["заголовки"]["X-RateLimit-Remaining"] == "1")

    пусть r2 = app.обработать("GET", "/ping", "", {"X-Real-IP": "10.0.0.1"})
    проверить(r2["статус"] == 200)
    проверить(r2["заголовки"]["X-RateLimit-Remaining"] == "0")

    пусть r3 = app.обработать("GET", "/ping", "", {"X-Real-IP": "10.0.0.1"})
    проверить(r3["статус"] == 429)
    проверить(получить(r3["заголовки"], "Retry-After", ничего) != ничего)

    # Другой IP не заблокирован
    пусть r4 = app.обработать("GET", "/ping", "", {"X-Real-IP": "10.0.0.2"})
    проверить(r4["статус"] == 200)
конец

# Пакет «ограничитель» — ограничение частоты запросов (rate limiting).
# Реализует два алгоритма: токен-бакет (ВедроТокенов) и скользящее окно (СкользящееОкно),
# а также готовый middleware для модуля «веб» с заголовками X-RateLimit-* и статусом 429.

# Алгоритм «Ведро токенов» (Token Bucket): допускает короткие всплески до `лимит`,
# равномерно пополняя токены со скоростью `лимит / период_сек`.
открой образ ВедроТокенов
    слово создать(лимит, периодСек, часы = ничего)
        это.лимит = лимит
        это.период = периодСек
        это._скорость = (лимит * 1.0) / (периодСек * 1.0)
        это._часы = часы ?? слово(): (время.метка() * 1.0) / 1000.0
        это._вёдра = {}
    конец

    слово проверка(ключ, стоимость = 1)
        пусть сейчас = это._часы()
        измени ведро = получить(это._вёдра, ключ, ничего)
        если ведро == ничего
            ведро = {"токены": это.лимит * 1.0, "обновлено": сейчас}
        иначе
            пусть прошло = сейчас - ведро["обновлено"]
            если прошло > 0
                пусть пополнено = ведро["токены"] + прошло * это._скорость
                ведро["токены"] = если пополнено > это.лимит: это.лимит * 1.0 иначе: пополнено
                ведро["обновлено"] = сейчас
            конец
        конец

        если ведро["токены"] >= стоимость
            ведро["токены"] = ведро["токены"] - стоимость
            это._вёдра[ключ] = ведро
            пусть осталось = мат.пол(ведро["токены"])
            пусть сброс = мат.потолок((это.лимит * 1.0 - ведро["токены"]) / это._скорость)
            аминь {
                "разрешено": истина,
                "лимит": это.лимит,
                "осталось": осталось,
                "сброс_через": сброс,
                "повтор_через": 0,
            }
        конец

        это._вёдра[ключ] = ведро
        пусть нехватает = (стоимость * 1.0) - ведро["токены"]
        пусть повтор = мат.потолок(нехватает / это._скорость)
        если повтор < 1
            повтор = 1
        конец
        аминь {
            "разрешено": ложь,
            "лимит": это.лимит,
            "осталось": 0,
            "сброс_через": повтор,
            "повтор_через": повтор,
        }
    конец

    слово сбросить(ключ)
        это._вёдра[ключ] = ничего
    конец

    слово очистить()
        это._вёдра = {}
    конец
конец

# Алгоритм «Скользящее окно» (Sliding Window Log): хранит метки времени запросов в окне.
открой образ СкользящееОкно
    слово создать(лимит, окноСек, часы = ничего)
        это.лимит = лимит
        это.окно = окноСек
        это._часы = часы ?? слово(): (время.метка() * 1.0) / 1000.0
        это._журнал = {}
    конец

    слово проверка(ключ)
        пусть сейчас = это._часы()
        пусть граница = сейчас - это.окно
        пусть старые = получить(это._журнал, ключ, [])
        измени актуальные = []
        для т в старые
            если т > граница
                добавить(актуальные, т)
            конец
        конец

        если длина(актуальные) < это.лимит
            добавить(актуальные, сейчас)
            это._журнал[ключ] = актуальные
            пусть сброс = мат.потолок(актуальные[0] + это.окно - сейчас)
            аминь {
                "разрешено": истина,
                "лимит": это.лимит,
                "осталось": это.лимит - длина(актуальные),
                "сброс_через": если сброс > 0: сброс иначе: 1,
                "повтор_через": 0,
            }
        конец

        это._журнал[ключ] = актуальные
        пусть повтор = мат.потолок(актуальные[0] + это.окно - сейчас)
        если повтор < 1
            повтор = 1
        конец
        аминь {
            "разрешено": ложь,
            "лимит": это.лимит,
            "осталось": 0,
            "сброс_через": повтор,
            "повтор_через": повтор,
        }
    конец

    слово сбросить(ключ)
        это._журнал[ключ] = []
    конец

    слово очистить()
        это._журнал = {}
    конец
конец

# Извлекает ключ клиента из запроса (X-Forwarded-For, X-Real-IP или "global").
слово ключ_по_умолчанию(запрос)
    пусть заг = получить(запрос, "заголовки", {})
    для имя в ["X-Forwarded-For", "x-forwarded-for", "X-Real-IP", "x-real-ip"]
        пусть зн = получить(заг, имя, ничего)
        если зн != ничего
            если обрезать(зн) != ""
                аминь обрезать(разделить(зн, ",")[0])
            конец
        конец
    конец
    аминь "global"
конец

# Middleware ограничения запросов для веб.приложение().
открой слово middleware(ограничитель, опции = ничего)
    пусть оп = опции ?? {}
    пусть ключИз = получить(оп, "ключ_из", ключ_по_умолчанию)
    пусть сообщение = получить(оп, "сообщение", "Слишком много запросов. Повторите позже.")

    аминь слово(запрос, далее)
        пусть ключ = ключИз(запрос)
        пусть рез = ограничитель.проверка(ключ)

        если не рез["разрешено"]
            пусть ответ429 = веб.json({
                "ошибка": сообщение,
                "повтор_через": рез["повтор_через"],
            }, 429)
            ответ429["заголовки"]["X-RateLimit-Limit"] = строка(рез["лимит"])
            ответ429["заголовки"]["X-RateLimit-Remaining"] = "0"
            ответ429["заголовки"]["X-RateLimit-Reset"] = строка(рез["сброс_через"])
            ответ429["заголовки"]["Retry-After"] = строка(рез["повтор_через"])
            аминь ответ429
        конец

        пусть ответ = далее()
        если получить(ответ, "заголовки", ничего) == ничего
            ответ["заголовки"] = {}
        конец
        ответ["заголовки"]["X-RateLimit-Limit"] = строка(рез["лимит"])
        ответ["заголовки"]["X-RateLimit-Remaining"] = строка(рез["осталось"])
        ответ["заголовки"]["X-RateLimit-Reset"] = строка(рез["сброс_через"])
        аминь ответ
    конец
конец

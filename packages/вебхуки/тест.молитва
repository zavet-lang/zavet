приими вебхуки из "./главный.молитва"

тест "подпись, проверка и защита от replay"
    пусть п = вебхуки.подписать('{"сумма":500}', "секрет", 1700000000)
    пусть ок = вебхуки.проверка('{"сумма":500}', п["заголовок"], "секрет", {"сейчас_сек": 1700000050, "допуск_сек": 300})
    проверить(ок["ок"] == истина)

    пусть стар = вебхуки.проверка('{"сумма":500}', п["заголовок"], "секрет", {"сейчас_сек": 1700000900, "допуск_сек": 300})
    проверить(стар["ок"] == ложь)
    проверить(содержит(стар["ошибка"], "replay"))

    пусть подделка = вебхуки.проверка('{"сумма":999}', п["заголовок"], "секрет", {"сейчас_сек": 1700000010})
    проверить(подделка["ок"] == ложь)
конец

тест "отправка с повторами и middleware проверки в веб"
    пусть app = веб.приложение()
    app.использовать(вебхуки.middleware("ключ-хука", {"часы": слово(): 1700000010}))
    app.пост("/hook", слово(запрос): веб.json({"принято": истина, "метка": запрос["вебхук_метка"]}))

    измени шаг = 0
    пусть транспорт = слово(url, тело, заголовки)
        шаг = шаг + 1
        если шаг == 1
            аминь {"статус": 500, "тело": "err"}
        конец
        аминь app.обработать("POST", "/hook", тело, заголовки)
    конец

    пусть рез = вебхуки.отправить("http://local/hook", "заказ.создан", {"id": 1}, "ключ-хука", {
        "метка_сек": 1700000000,
        "повторы": 2,
        "пауза_мс": 0,
        "транспорт": транспорт,
    })
    проверить(рез["доставлено"] == истина)
    проверить(рез["попыток"] == 2)

    пусть безПодписи = app.обработать("POST", "/hook", '{"x":1}')
    проверить(безПодписи["статус"] == 401)
конец

# Пакет «вебхуки» — подпись, проверка (HMAC-SHA256 + защита от replay-атак) и отправка вебхуков.

# Формат заголовка подписи: "t=<unix_sec>,v1=<hmac_sha256(t + '.' + payload, secret)>"
открой слово подписать(тело, секрет, меткаСек = ничего)
    пусть t = если меткаСек != ничего: меткаСек иначе: время.сейчас()
    пусть текст = если тип(тело) == "STRING": тело иначе: json.создать(тело)
    пусть подпись = крипто.hmac_sha256(строка(t) + "." + текст, секрет)
    аминь {
        "заголовок": "t=" + строка(t) + ",v1=" + подпись,
        "метка": t,
        "подпись": подпись,
        "тело": текст,
    }
конец

# Разбирает заголовок подписи вида "t=1700000000,v1=abcdef...".
слово разобрать_заголовок(заголовок)
    измени итог = {"t": ничего, "v1": ничего}
    если заголовок == ничего
        аминь итог
    конец
    если обрезать(заголовок) == ""
        аминь итог
    конец
    для часть в разделить(заголовок, ",")
        пусть пара = разделить(обрезать(часть), "=")
        если длина(пара) == 2
            пусть к = обрезать(пара[0])
            пусть з = обрезать(пара[1])
            если к == "t" и регвыр.совпадает(з, '^[0-9]+$')
                итог["t"] = число(з)
            иначеесли к == "v1"
                итог["v1"] = з
            конец
        конец
    конец
    аминь итог
конец

# Проверяет подпись и свежесть метки времени (допуск по умолчанию 300 секунд).
открой слово проверка(тело, заголовок, секрет, опции = ничего)
    пусть оп = опции ?? {}
    пусть допуск = получить(оп, "допуск_сек", 300)
    пусть сейчас = получить(оп, "сейчас_сек", время.сейчас())

    пусть разбор = разобрать_заголовок(заголовок)
    если разбор["t"] == ничего или разбор["v1"] == ничего
        аминь {"ок": ложь, "ошибка": "некорректный формат заголовка подписи"}
    конец

    если допуск > 0
        пусть разница = абс(сейчас - разбор["t"])
        если разница > допуск
            аминь {"ок": ложь, "ошибка": "подпись просрочена (возможен replay)"}
        конец
    конец

    пусть текст = если тип(тело) == "STRING": тело иначе: json.создать(тело)
    пусть ожидаемая = крипто.hmac_sha256(строка(разбор["t"]) + "." + текст, секрет)
    если разбор["v1"] != ожидаемая
        аминь {"ок": ложь, "ошибка": "неверная подпись HMAC"}
    конец

    аминь {"ок": истина, "метка": разбор["t"]}
конец

# Отправляет подписанный вебхук с повторами (поддерживает подмену транспорта для тестов).
открой слово отправить(url, событие, данные, секрет, опции = ничего)
    пусть оп = опции ?? {}
    пусть имяЗаг = получить(оп, "заголовок_подписи", "X-Webhook-Signature")
    пусть повторы = получить(оп, "повторы", 2)
    пусть паузаМс = получить(оп, "пауза_мс", 200)
    пусть транспорт = получить(оп, "транспорт", слово(u, т, з): http.пост(u, т, з))
    пусть сон = получить(оп, "сон", слово(мс): время.спать(мс))

    пусть полезная = json.создать({"событие": событие, "данные": данные})
    пусть подп = подписать(полезная, секрет, получить(оп, "метка_сек", ничего))
    пусть заголовки = {
        "Content-Type": "application/json",
        "X-Webhook-Event": событие,
    }
    заголовки[имяЗаг] = подп["заголовок"]

    измени попыткаНом = 0
    измени ответ = ничего
    доколе попыткаНом <= повторы
        попыткаНом = попыткаНом + 1
        попытка
            ответ = транспорт(url, полезная, заголовки)
        поймать ош
            ответ = {"статус": 0, "тело": строка(ош)}
        конец
        пусть ст = получить(ответ, "статус", 0)
        если ст >= 200 и ст < 300
            аминь {"доставлено": истина, "статус": ст, "попыток": попыткаНом, "ответ": ответ}
        конец
        если попыткаНом <= повторы и паузаМс > 0
            сон(паузаМс * попыткаНом)
        конец
    конец

    аминь {"доставлено": ложь, "статус": получить(ответ, "статус", 0), "попыток": попыткаНом, "ответ": ответ}
конец

слово заголовок_без_регистра(заголовки, имя)
    если заголовки == ничего
        аминь ничего
    конец
    пусть н = нижний(имя)
    для к в ключи(заголовки)
        если нижний(к) == н
            аминь заголовки[к]
        конец
    конец
    аминь ничего
конец

# Middleware проверки подписи входящих вебхуков для веб.приложение().
открой слово middleware(секрет, опции = ничего)
    пусть оп = опции ?? {}
    пусть имяЗаг = получить(оп, "заголовок_подписи", "X-Webhook-Signature")
    пусть допуск = получить(оп, "допуск_сек", 300)
    пусть часы = получить(оп, "часы", слово(): время.сейчас())

    аминь слово(запрос, далее)
        пусть заг = заголовок_без_регистра(получить(запрос, "заголовки", {}), имяЗаг)
        пусть тело = получить(запрос, "тело", "")
        пусть рез = проверка(тело, заг, секрет, {"допуск_сек": допуск, "сейчас_сек": часы()})
        если не рез["ок"]
            аминь веб.json({"ошибка": рез["ошибка"]}, 401)
        конец
        запрос["вебхук_метка"] = рез["метка"]
        аминь далее()
    конец
конец

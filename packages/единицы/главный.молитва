# Конвертация температуры (C / F / K).
открой слово температура(значение, изЕд, вЕд)
    пусть v = значение * 1.0
    пусть а = верхний(обрезать(строка(изЕд)))
    пусть б = верхний(обрезать(строка(вЕд)))
    измени c = v
    если а == "F"
        c = (v - 32.0) * 5.0 / 9.0
    иначеесли а == "K"
        c = v - 273.15
    иначеесли а != "C"
        бросить("неизвестная шкала температуры: " + а)
    конец
    если б == "C"
        аминь c
    конец
    если б == "F"
        аминь c * 9.0 / 5.0 + 32.0
    конец
    если б == "K"
        аминь c + 273.15
    конец
    бросить("неизвестная шкала температуры: " + б)
конец

# Универсальная конвертация единиц внутри одной физической категории.
открой слово перевести(значение, изЕд, вЕд)
    пусть а = нижний(обрезать(строка(изЕд)))
    пусть б = нижний(обрезать(строка(вЕд)))
    если а == "c" или а == "f" или а == "k"
        аминь температура(значение, а, б)
    конец
    для кат в ключи(ТАБЛИЦЫ)
        пусть т = ТАБЛИЦЫ[кат]
        пусть k1 = получить(т, а, ничего)
        пусть k2 = получить(т, б, ничего)
        если k1 != ничего и k2 != ничего
            аминь (значение * 1.0) * k1 / k2
        конец
    конец
    бросить("несовместимые или неизвестные единицы: " + а + " -> " + б)
конец

# Человекочитаемый размер файла из байт ("1.5 МБ").
открой слово размер_данных(байт)
    пусть ед = ["Б", "КБ", "МБ", "ГБ", "ТБ"]
    измени v = байт * 1.0
    измени i = 0
    доколе v >= 1024.0 и i < длина(ед) - 1
        v = v / 1024.0
        i = i + 1
    конец
    пусть цел10 = мат.пол(v * 10.0 + 0.5) / 10.0
    аминь строка(цел10) + " " + ед[i]
конец

# Пакет «telegram-меню» — inline-клавиатуры, пагинация, роутер callback_data и FSM диалогов.

открой слово кнопка(текст, callbackData)
    аминь {"text": строка(текст), "callback_data": строка(callbackData)}
конец

открой слово кнопка_ссылка(текст, url)
    аминь {"text": строка(текст), "url": строка(url)}
конец

открой слово клавиатура(ряды)
    аминь {"inline_keyboard": ряды}
конец

# Разбивает массив кнопок на сетку по N столбцов.
открой слово сетка(кнопки, столбцов = 2)
    измени ряды = []
    измени тек = []
    для кн в кнопки
        добавить(тек, кн)
        если длина(тек) >= столбцов
            добавить(ряды, тек)
            тек = []
        конец
    конец
    если длина(тек) > 0
        добавить(ряды, тек)
    конец
    аминь {"inline_keyboard": ряды}
конец

# Пагинация массива элементов: возвращает {страница, всего_страниц, элементы, разметка}.
открой слово пагинация(элементы, страница = 1, наСтранице = 5, префикс = "page")
    пусть всего = длина(элементы)
    пусть всегоСтр = если всего == 0: 1 иначе: ((всего - 1) - ((всего - 1) % наСтранице)) / наСтранице + 1
    измени стр = страница
    если стр < 1
        стр = 1
    конец
    если стр > всегоСтр
        стр = всегоСтр
    конец
    пусть нач = (стр - 1) * наСтранице
    измени выб = []
    измени i = нач
    доколе i < нач + наСтранице и i < всего
        добавить(выб, элементы[i])
        i = i + 1
    конец
    измени нав = []
    если стр > 1
        добавить(нав, кнопка("◀ Назад", префикс + ":" + строка(стр - 1)))
    конец
    добавить(нав, кнопка(строка(стр) + "/" + строка(всегоСтр), префикс + ":noop"))
    если стр < всегоСтр
        добавить(нав, кнопка("Вперёд ▶", префикс + ":" + строка(стр + 1)))
    конец
    аминь {
        "страница": стр,
        "всего_страниц": всегоСтр,
        "элементы": выб,
        "разметка": {"inline_keyboard": [нав]},
    }
конец

# Машина состояний диалога по chat_id.
открой образ ДиалогFSM
    поля: состояния, данные

    слово создать()
        это.состояния = {}
        это.данные = {}
    конец

    слово шаг(чатИд)
        аминь получить(это.состояния, строка(чатИд), ничего)
    конец

    слово перейти(чатИд, имяШага)
        это.состояния[строка(чатИд)] = имяШага
        аминь это
    конец

    слово сохранить(чатИд, ключ, значение)
        пусть ид = строка(чатИд)
        измени д = получить(это.данные, ид, nothing_dict())
        д[ключ] = значение
        это.данные[ид] = д
        аминь это
    конец

    слово контекст(чатИд)
        аминь получить(это.данные, строка(чатИд), {})
    конец

    слово сбросить(чатИд)
        пусть ид = строка(чатИд)
        это.состояния[ид] = ничего
        это.данные[ид] = {}
        аминь это
    конец
конец

слово nothing_dict()
    аминь {}
конец

открой слово fsm()
    аминь новый ДиалогFSM()
конец

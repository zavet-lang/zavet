приими меню из "./главный.молитва"

тест "сетка кнопок, пагинация и FSM диалога"
    пусть кл = меню.сетка([
        меню.кнопка("1", "a"),
        меню.кнопка("2", "b"),
        меню.кнопка("3", "c"),
    ], 2)
    проверить(длина(кл["inline_keyboard"]) == 2)
    проверить(длина(кл["inline_keyboard"][0]) == 2)
    проверить(длина(кл["inline_keyboard"][1]) == 1)

    пусть п = меню.пагинация(["а", "б", "в", "г", "д"], 2, 2, "cat")
    проверить(п["всего_страниц"] == 3)
    проверить(длина(п["элементы"]) == 2)
    проверить(п["элементы"][0] == "в")

    пусть ф = меню.fsm()
    ф.перейти(101, "ввод_имени")
    ф.сохранить(101, "имя", "Пётр")
    проверить(ф.шаг(101) == "ввод_имени")
    проверить(ф.контекст(101)["имя"] == "Пётр")
    ф.сбросить(101)
    проверить(ф.шаг(101) == ничего)
конец

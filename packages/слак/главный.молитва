# Пакет «слак» — Slack Incoming Webhook и конструктор блоков Block Kit.

открой слово заголовок(текст)
    аминь {"type": "header", "text": {"type": "plain_text", "text": строка(текст)}}
конец

открой слово секция(markdownТекст)
    аминь {"type": "section", "text": {"type": "mrkdwn", "text": строка(markdownТекст)}}
конец

открой слово разделитель()
    аминь {"type": "divider"}
конец

открой слово контекст(строки)
    измени элементы = []
    для s в строки
        добавить(элементы, {"type": "mrkdwn", "text": строка(s)})
    конец
    аминь {"type": "context", "elements": элементы}
конец

открой образ Вебхук
    поля: url, транспорт

    слово создать(url, транспорт = ничего)
        это.url = url
        это.транспорт = транспорт
    конец

    слово отправить(текст, блоки = [])
        измени тело = {"text": строка(текст)}
        если длина(блоки) > 0
            тело["blocks"] = блоки
        конец
        пусть jsonТело = json.создать(тело)
        пусть заг = {"Content-Type": "application/json"}
        если это.транспорт != ничего
            аминь это.транспорт("POST", это.url, jsonТело, заг)
        конец
        аминь http.запрос("POST", это.url, jsonТело, заг)
    конец
конец

открой слово вебхук(url, транспорт = ничего)
    аминь новый Вебхук(url, транспорт)
конец

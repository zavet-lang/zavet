приими gh из "./главный.молитва"

тест "запросы к GitHub API: репозиторий и создание задачи"
    измени последнийПуть = ""
    измени авторизация = ""
    пусть кл = gh.клиент("ghp_test123", {
        "транспорт": слово(метод, url, тело, заг)
            последнийПуть = метод + " " + url
            авторизация = получить(заг, "Authorization", "")
            аминь {"статус": 200, "тело": '{"full_name":"zavet-lang/zavet","stargazers_count":42}'}
        конец,
    })

    пусть р = кл.репозиторий("zavet-lang", "zavet")
    проверить(р["ок"] == истина)
    проверить(р["данные"]["stargazers_count"] == 42)
    проверить(авторизация == "Bearer ghp_test123")

    пусть з = кл.создать_задачу("zavet-lang", "zavet", "Новый пакет", "Описание", ["enhancement"])
    проверить(з["ок"] == истина)
    проверить(содержит(последнийПуть, "POST https://api.github.com/repos/zavet-lang/zavet/issues"))
конец

# Пакет «гитхаб» — клиент GitHub REST API v3 (репозитории, релизы, issues).

открой образ Клиент
    поля: токен, база, транспорт

    слово создать(токен = "", опции = {})
        это.токен = токен
        это.база = получить(опции, "база", "https://api.github.com")
        это.транспорт = получить(опции, "транспорт", ничего)
    конец

    слово запрос(метод, путь, тело = ничего)
        пусть url = это.база + путь
        измени заг = {
            "Accept": "application/vnd.github+json",
            "User-Agent": "zavet-github-client/1.0",
        }
        если это.токен != ""
            заг["Authorization"] = "Bearer " + это.токен
        конец
        измени сыроеТело = ""
        если тело != ничего
            заг["Content-Type"] = "application/json"
            сыроеТело = json.создать(тело)
        конец
        пусть отв = если это.транспорт != ничего:
            это.транспорт(метод, url, сыроеТело, заг)
        иначе:
            http.запрос(метод, url, сыроеТело, заг)
        пусть статус = получить(отв, "статус", 0)
        пусть стрТело = получить(отв, "тело", "")
        измени данные = ничего
        если длина(обрезать(стрТело)) > 0
            попытка
                данные = json.разобрать(стрТело)
            поймать ош
                данные = стрТело
            конец
        конец
        аминь {"ок": статус >= 200 и статус < 300, "статус": статус, "данные": данные}
    конец

    слово репозиторий(владелец, имя)
        аминь это.запрос("GET", "/repos/" + владелец + "/" + имя)
    конец

    слово релизы(владелец, имя)
        аминь это.запрос("GET", "/repos/" + владелец + "/" + имя + "/releases")
    конец

    слово список_задач(владелец, имя, состояние = "open")
        аминь это.запрос("GET", "/repos/" + владелец + "/" + имя + "/issues?state=" + состояние)
    конец

    слово создать_задачу(владелец, имя, заголовок, описание = "", метки = [])
        аминь это.запрос("POST", "/repos/" + владелец + "/" + имя + "/issues", {
            "title": заголовок,
            "body": описание,
            "labels": метки,
        })
    конец

    слово комментарий(владелец, имя, номер, текст)
        аминь это.запрос("POST", "/repos/" + владелец + "/" + имя + "/issues/" + строка(номер) + "/comments", {
            "body": текст,
        })
    конец
конец

открой слово клиент(токен = "", опции = {})
    аминь новый Клиент(токен, опции)
конец

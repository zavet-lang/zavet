# Пакет «бэкап» — создание резервных копий с SHA-256 проверкой целостности и восстановлением.

# Создаёт снимок из словаря {"относительный/путь": "содержимое"} (удобно для тестов и in-memory).
открой слово создать_снимок(файлыКарта, метка = "")
    измени записи = []
    для путь в ключи(файлыКарта)
        пусть содерж = строка(файлыКарта[путь])
        добавить(записи, {
            "путь": путь,
            "размер": длина(содерж),
            "sha256": крипто.sha256(содерж),
            "данные_b64": крипто.base64_кодировать(содерж),
        })
    конец
    аминь {
        "версия": 1,
        "создан": время.сейчас(),
        "метка": метка,
        "файлы": записи,
    }
конец

# Проверяет SHA-256 каждого файла в снимке.
открой слово проверить_целостность(снимок)
    измени повреждённые = []
    для зап в получить(снимок, "файлы", [])
        пусть текст = крипто.base64_декодировать(зап["данные_b64"])
        если крипто.sha256(текст) != зап["sha256"]
            добавить(повреждённые, зап["путь"])
        конец
    конец
    аминь {"ок": длина(повреждённые) == 0, "повреждённые": повреждённые}
конец

# Извлекает словарь {"путь": "содержимое"} из проверенного снимка.
открой слово извлечь(снимок)
    пусть пров = проверить_целостность(снимок)
    если не пров["ок"]
        бросить("снимок повреждён: " + соединить(пров["повреждённые"], ", "))
    конец
    измени вых = {}
    для зап в получить(снимок, "файлы", [])
        вых[зап["путь"]] = крипто.base64_декодировать(зап["данные_b64"])
    конец
    аминь вых
конец

# Сохраняет снимок на диск в JSON-файл.
открой слово сохранить_в_файл(снимок, путьФайла)
    файлы.записать(путьФайла, json.создать(снимок))
    аминь путьФайла
конец

# Загружает снимок из JSON-файла.
открой слово загрузить_из_файла(путьФайла)
    аминь json.разобрать(файлы.прочитать(путьФайла))
конец

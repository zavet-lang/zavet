# Пакет «пароли» — итеративное хеширование паролей с солью (PBKDF-стиль на HMAC-SHA256),
# сравнение за постоянное время, оценка стойкости и генератор паролей.

слово равны_постоянно(а, б)
    если длина(а) != длина(б)
        аминь ложь
    конец
    измени расхождений = 0
    измени i = 0
    доколе i < длина(а)
        если подстрока(а, i, i + 1) != подстрока(б, i, i + 1)
            расхождений = расхождений + 1
        конец
        i = i + 1
    конец
    аминь расхождений == 0
конец

слово растянуть(пароль, соль, итераций)
    измени д = крипто.hmac_sha256(пароль + ":" + соль, соль)
    измени i = 1
    доколе i < итераций
        д = крипто.hmac_sha256(д + ":" + соль + ":" + строка(i), пароль)
        i = i + 1
    конец
    аминь д
конец

слово случайный_hex(байт)
    измени вых = ""
    измени i = 0
    доколе длина(вых) < байт * 2
        пусть зерно = строка(время.метка()) + ":" + строка(i) + ":" + строка(случайное.целое(100000, 999999)) + ":" + строка(случайное.целое(100000, 999999))
        вых = вых + крипто.sha256(зерно)
        i = i + 1
    конец
    аминь подстрока(вых, 0, байт * 2)
конец

# Хеширует пароль со случайной солью и заданным числом итераций.
# Формат результата: "hmac256$<итераций>$<соль>$<хеш>".
открой слово хешировать(пароль, итераций = 200)
    пусть соль = случайный_hex(16)
    пусть хеш = растянуть(строка(пароль), соль, итераций)
    аминь "hmac256$" + строка(итераций) + "$" + соль + "$" + хеш
конец

# Проверяет соответствие пароля сохранённому хешу.
открой слово сверить(пароль, сохранённый)
    если сохранённый == ничего
        аминь ложь
    конец
    пусть части = разделить(строка(сохранённый), "$")
    если длина(части) != 4 или части[0] != "hmac256"
        аминь ложь
    конец
    пусть итераций = число(части[1])
    пусть соль = части[2]
    пусть эталон = части[3]
    пусть факт = растянуть(строка(пароль), соль, итераций)
    аминь равны_постоянно(факт, эталон)
конец

# Оценивает стойкость пароля: балл 0..5, уровень и список советов.
открой слово оценить_стойкость(пароль)
    пусть p = строка(пароль)
    измени балл = 0
    измени советы = []
    если длина(p) >= 8
        балл = балл + 1
    иначе
        добавить(советы, "минимум 8 символов")
    конец
    если длина(p) >= 12
        балл = балл + 1
    конец
    если регвыр.совпадает(p, '[a-zа-я]') и регвыр.совпадает(p, '[A-ZА-Я]')
        балл = балл + 1
    иначе
        добавить(советы, "добавьте заглавные и строчные буквы")
    конец
    если регвыр.совпадает(p, '[0-9]')
        балл = балл + 1
    иначе
        добавить(советы, "добавьте цифры")
    конец
    если регвыр.совпадает(p, '[^a-zA-Zа-яА-Я0-9]')
        балл = балл + 1
    иначе
        добавить(советы, "добавьте спецсимволы")
    конец
    пусть уровень = если балл >= 4: "надёжный" иначе: (если балл >= 3: "средний" иначе: "слабый")
    аминь {"балл": балл, "уровень": уровень, "советы": советы}
конец

# Генерирует криптостойкий пароль заданной длины.
открой слово сгенерировать(длинаП = 16)
    пусть алфавит = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!@#$%&*"
    пусть hex = случайный_hex(длинаП)
    пусть hexЦифры = "0123456789abcdef"
    измени вых = ""
    измени i = 0
    доколе i < длинаП
        пусть hi = найти(hexЦифры, подстрока(hex, i * 2, i * 2 + 1))
        пусть lo = найти(hexЦифры, подстрока(hex, i * 2 + 1, i * 2 + 2))
        пусть байт = hi * 16 + lo
        пусть idx = байт % длина(алфавит)
        вых = вых + подстрока(алфавит, idx, idx + 1)
        i = i + 1
    конец
    аминь вых
конец

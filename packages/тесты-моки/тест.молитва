приими моки из "./главный.молитва"

тест "запись вызовов, очередь возвратов и коллбэк"
    пусть шпион = моки.создать()
    шпион.вернуть_по_очереди(["первый", "второй"])
    пусть ф = шпион.коллбэк()

    проверить(ф("x", 1) == "первый")
    проверить(ф("y", 2) == "второй")
    проверить(шпион.число_вызовов() == 2)
    проверить(шпион.последний_вызов()[0] == "y")

    шпион.сбросить()
    проверить(шпион.вызывался() == ложь)

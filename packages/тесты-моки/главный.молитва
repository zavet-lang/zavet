# Пакет «тесты-моки» — шпионы и заглушки для тестирования функций и зависимостей.

открой образ Мок
    поля: вызовы, ответ, очередь_ответов, реализация, ошибка

    слово создать(реализация = ничего)
        это.вызовы = []
        это.ответ = ничего
        это.очередь_ответов = []
        это.реализация = реализация
        это.ошибка = ничего
    конец

    слово вернуть(значение)
        это.ответ = значение
        аминь это
    конец

    слово вернуть_по_очереди(список)
        это.очередь_ответов = список
        аминь это
    конец

    слово бросать(сообщение)
        это.ошибка = сообщение
        аминь это
    конец

    # Вызов мока (передавайте аргументы массивом или через функцию .функция()).
    слово вызвать(аргументы = [])
        добавить(это.вызовы, аргументы)
        если это.ошибка != ничего
            бросить(это.ошибка)
        конец
        если длина(это.очередь_ответов) > 0
            пусть след = это.очередь_ответов[0]
            удалить(это.очередь_ответов, 0)
            аминь след
        конец
        если это.реализация != ничего
            аминь это.реализация(аргументы)
        конец
        аминь это.ответ
    конец

    # Возвращает замыкание (для передачи вместо обычного коллбэка с 0–3 аргументами).
    слово коллбэк()
        пусть м = это
        аминь слово(а = ничего, б = ничего, г = ничего)
            измени арг = []
            если а != ничего
                добавить(арг, а)
            конец
            если б != ничего
                добавить(арг, б)
            конец
            если г != ничего
                добавить(арг, г)
            конец
            аминь м.вызвать(арг)
        конец
    конец

    слово число_вызовов()
        аминь длина(это.вызовы)
    конец

    слово вызывался()
        аминь длина(это.вызовы) > 0
    конец

    слово последний_вызов()
        если длина(это.вызовы) == 0
            аминь ничего
        конец
        аминь это.вызовы[длина(это.вызовы) - 1]
    конец

    слово сбросить()
        это.вызовы = []
        аминь это
    конец
конец

открой слово создать(реализация = ничего)
    аминь новый Мок(реализация)
конец

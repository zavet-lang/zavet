# Пакет «ввод-проверка» — санитизация текста, защита от XSS, path traversal и опасных URL.

# Удаляет HTML-теги и экранирует спецсимволы.
открой слово очистить_html(текст)
    если текст == ничего
        аминь ""
    конец
    пусть безТегов = регвыр.заменить(строка(текст), '<[^>]*>', "")
    аминь шаблон.экранировать(безТегов)
конец

# Проверяет, безопасна ли ссылка (только http://, https://, / или #; запрещает javascript:, data:).
открой слово безопасный_url(url)
    если url == ничего
        аминь ложь
    конец
    пусть u = нижний(обрезать(строка(url)))
    если u == ""
        аминь ложь
    конец
    если начинается_с(u, "https://") или начинается_с(u, "http://") или начинается_с(u, "/") или начинается_с(u, "#")
        аминь не содержит(u, "javascript:") и не содержит(u, "\n") и не содержит(u, "\r")
    конец
    аминь ложь
конец

# Проверяет путь на отсутствие path traversal (.., нулевые байты, абсолютные корни).
открой слово безопасный_путь(путь)
    если путь == ничего
        аминь ложь
    конец
    пусть p = заменить(строка(путь), "\\", "/")
    если p == "" или начинается_с(p, "/") или содержит(p, ":")
        аминь ложь
    конец
    для сегм в разделить(p, "/")
        если сегм == ".."
            аминь ложь
        конец
    конец
    аминь истина
конец

# Превращает произвольную строку в безопасное имя файла.
открой слово безопасное_имя_файла(имя, умолч = "file")
    если имя == ничего
        аминь умолч
    конец
    измени s = обрезать(строка(имя))
    s = регвыр.заменить(s, '[^a-zA-Zа-яА-ЯёЁ0-9._-]+', "_")
    s = регвыр.заменить(s, '^[._]+', "")
    если s == ""
        аминь умолч
    конец
    аминь s
конец

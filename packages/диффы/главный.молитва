# Пакет «диффы» — построчное сравнение двух текстов на базе LCS (наибольшей общей подпоследовательности).

# Вычисляет массив операций: {"тип": "равна"|"добавлена"|"удалена", "строка": текст}.
открой слово сравнить_строки(старый, новыйТекст)
    пусть а = если старый == "": [] иначе: разделить(заменить(старый, "\r\n", "\n"), "\n")
    пусть б = если новыйТекст == "": [] иначе: разделить(заменить(новыйТекст, "\r\n", "\n"), "\n")
    пусть n = длина(а)
    пусть m = длина(б)

    # Таблица длин LCS размером (n+1) x (m+1)
    измени дп = []
    измени i = 0
    доколе i <= n
        измени ряд = []
        измени j = 0
        доколе j <= m
            добавить(ряд, 0)
            j = j + 1
        конец
        добавить(дп, ряд)
        i = i + 1
    конец

    i = n - 1
    доколе i >= 0
        измени j = m - 1
        доколе j >= 0
            если а[i] == б[j]
                дп[i][j] = дп[i + 1][j + 1] + 1
            иначе
                пусть вниз = дп[i + 1][j]
                пусть вправо = дп[i][j + 1]
                дп[i][j] = если вниз >= вправо: вниз иначе: вправо
            конец
            j = j - 1
        конец
        i = i - 1
    конец

    измени итог = []
    i = 0
    измени j = 0
    доколе i < n или j < m
        если i < n и j < m
            если а[i] == б[j]
                добавить(итог, {"тип": "равна", "строка": а[i]})
                i = i + 1
                j = j + 1
                продолжи
            конец
            если дп[i + 1][j] >= дп[i][j + 1]
                добавить(итог, {"тип": "удалена", "строка": а[i]})
                i = i + 1
            иначе
                добавить(итог, {"тип": "добавлена", "строка": б[j]})
                j = j + 1
            конец
        иначеесли i < n
            добавить(итог, {"тип": "удалена", "строка": а[i]})
            i = i + 1
        иначе
            добавить(итог, {"тип": "добавлена", "строка": б[j]})
            j = j + 1
        конец
    конец

    аминь итог
конец

# Форматирует различия в читаемый unified-вид (+ / - / пробел).
открой слово патч(старый, новыйТекст, имяСтарого = "a", имяНового = "b")
    пусть опс = сравнить_строки(старый, новыйТекст)
    измени линии = ["--- " + имяСтарого, "+++ " + имяНового]
    для оп в опс
        если оп["тип"] == "равна"
            добавить(линии, "  " + оп["строка"])
        иначеесли оп["тип"] == "удалена"
            добавить(линии, "- " + оп["строка"])
        иначе
            добавить(линии, "+ " + оп["строка"])
        конец
    конец
    аминь соединить(линии, "\n")
конец

# Возвращает сводку изменений: добавлено, удалено, без_изменений, одинаковые.
открой слово статистика(старый, новыйТекст)
    пусть опс = сравнить_строки(старый, новыйТекст)
    измени доб = 0
    измени уд = 0
    измени рав = 0
    для оп в опс
        если оп["тип"] == "добавлена"
            доб = доб + 1
        иначеесли оп["тип"] == "удалена"
            уд = уд + 1
        иначе
            рав = рав + 1
        конец
    конец
    аминь {
        "добавлено": доб,
        "удалено": уд,
        "без_изменений": рав,
        "одинаковые": доб == 0 и уд == 0,
    }
конец

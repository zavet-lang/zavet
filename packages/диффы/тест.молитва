приими диффы из "./главный.молитва"

тест "сравнение строк, патч и статистика"
    пусть т1 = "строка 1\nстрока 2\nстрока 3"
    пусть т2 = "строка 1\nстрока 2 изм\nстрока 3\nстрока 4"

    пусть ст = диффы.статистика(т1, т2)
    проверить(ст["одинаковые"] == ложь)
    проверить(ст["удалено"] == 1)
    проверить(ст["добавлено"] == 2)
    проверить(ст["без_изменений"] == 2)

    пусть п = диффы.патч(т1, т2)
    проверить(содержит(п, "- строка 2"))
    проверить(содержит(п, "+ строка 2 изм"))
    проверить(содержит(п, "+ строка 4"))

    проверить(диффы.статистика("abc", "abc")["одинаковые"] == истина)

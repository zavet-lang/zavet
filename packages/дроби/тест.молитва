приими др из "./главный.молитва"

тест "сокращение и арифметика рациональных дробей"
    пусть а = др.создать(2, 6)
    проверить(а.в_строку() == "1/3")

    пусть б = др.из_строки("1/6")
    пусть сумма = а.плюс(б)
    проверить(сумма.в_строку() == "1/2")

    пусть произв = а.умножить(др.создать(3, 2))
    проверить(произв.в_строку() == "1/2")
    проверить(сумма.равна(произв))
    проверить(абс(сумма.в_число() - 0.5) < 0.0001)
конец

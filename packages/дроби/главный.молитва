# Пакет «дроби» — точные рациональные дроби с автоматическим сокращением через НОД.

открой слово нод(а, б)
    измени x = абс(а)
    измени y = абс(б)
    доколе y != 0
        пусть t = x % y
        x = y
        y = t
    конец
    аминь если x == 0: 1 иначе: x
конец

открой образ Дробь
    поля: числитель, знаменатель

    слово создать(ч, з = 1)
        если з == 0
            бросить("знаменатель дроби не может быть нулём")
        конец
        измени знак = 1
        если з < 0
            знак = -1
        конец
        пусть ч1 = ч * знак
        пусть з1 = абс(з)
        пусть g = нод(ч1, з1)
        это.числитель = (ч1 - (ч1 % g)) / g
        это.знаменатель = (з1 - (з1 % g)) / g
    конец

    слово плюс(другая)
        аминь новый Дробь(
            это.числитель * другая.знаменатель + другая.числитель * это.знаменатель,
            это.знаменатель * другая.знаменатель
        )
    конец

    слово минус(другая)
        аминь новый Дробь(
            это.числитель * другая.знаменатель - другая.числитель * это.знаменатель,
            это.знаменатель * другая.знаменатель
        )
    конец

    слово умножить(другая)
        аминь новый Дробь(это.числитель * другая.числитель, это.знаменатель * другая.знаменатель)
    конец

    слово разделить(другая)
        если другая.числитель == 0
            бросить("деление на нулевую дробь")
        конец
        аминь новый Дробь(это.числитель * другая.знаменатель, это.знаменатель * другая.числитель)
    конец

    слово равна(другая)
        аминь это.числитель == другая.числитель и это.знаменатель == другая.знаменатель
    конец

    слово сравнить(другая)
        пусть d = это.числитель * другая.знаменатель - другая.числитель * это.знаменатель
        если d < 0
            аминь -1
        конец
        если d > 0
            аминь 1
        конец
        аминь 0
    конец

    слово в_число()
        аминь (это.числитель * 1.0) / (это.знаменатель * 1.0)
    конец

    слово в_строку()
        если это.знаменатель == 1
            аминь строка(это.числитель)
        конец
        аминь строка(это.числитель) + "/" + строка(это.знаменатель)
    конец
конец

открой слово создать(ч, з = 1)
    аминь новый Дробь(ч, з)
конец

# Разбирает строку "3/4" или "-5".
открой слово из_строки(текст)
    пусть s = обрезать(строка(текст))
    пусть части = разделить(s, "/")
    если длина(части) == 1
        аминь новый Дробь(число(части[0]), 1)
    конец
    аминь новый Дробь(число(части[0]), число(части[1]))
конец

# Пакет «графики-ascii» — спарклайны, столбчатые диаграммы и графики в терминале.

пусть БЛОКИ = ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]

слово повторить(симв, n)
    измени s = ""
    измени i = 0
    доколе i < n
        s = s + симв
        i = i + 1
    конец
    аминь s
конец

# Строит однострочный спарклайн по массиву чисел.
открой слово искры(значения)
    если длина(значения) == 0
        аминь ""
    конец
    измени минЗ = значения[0] * 1.0
    измени максЗ = значения[0] * 1.0
    для v в значения
        пусть f = v * 1.0
        если f < минЗ
            минЗ = f
        конец
        если f > максЗ
            максЗ = f
        конец
    конец
    пусть размах = максЗ - минЗ
    измени вых = ""
    для v в значения
        если размах == 0.0
            вых = вых + БЛОКИ[3]
        иначе
            пусть доля = ((v * 1.0) - минЗ) / размах
            измени idx = 0
            доколе (idx + 1) * 1.0 <= доля * 7.0 + 0.5 и idx < 7
                idx = idx + 1
            конец
            вых = вых + БЛОКИ[idx]
        конец
    конец
    аминь вых
конец

# Строит горизонтальную столбчатую диаграмму по массиву {"метка": ..., "значение": ...}.
открой слово столбцы(элементы, ширина = 24, символ = "█")
    если длина(элементы) == 0
        аминь ""
    конец
    измени максЗ = 0.0
    измени максМ = 0
    для эл в элементы
        пусть v = эл["значение"] * 1.0
        если v > максЗ
            максЗ = v
        конец
        пусть дм = длина(строка(эл["метка"]))
        если дм > максМ
            максМ = дм
        конец
    конец
    измени линии = []
    для эл в элементы
        пусть м = строка(эл["метка"])
        пусть пад = повторить(" ", максМ - длина(м))
        пусть v = эл["значение"] * 1.0
        измени n = 0
        если максЗ > 0.0
            пусть целевая = (v / максЗ) * (ширина * 1.0)
            доколе (n + 1) * 1.0 <= целевая + 0.5 и n < ширина
                n = n + 1
            конец
        конец
        добавить(линии, м + пад + " | " + повторить(символ, n) + " " + строка(эл["значение"]))
    конец
    аминь соединить(линии, "\n")
конец

приими гр из "./главный.молитва"

тест "спарклайны и столбчатые диаграммы"
    пусть иск = гр.искры([1, 2, 4, 8, 4, 2, 1])
    проверить(длина(иск) == 7)
    проверить(содержит(иск, "█"))
    проверить(содержит(иск, "▁"))

    пусть д = гр.столбцы([
        {"метка": "Янв", "значение": 10},
        {"метка": "Фев", "значение": 20},
    ], 10)
    проверить(содержит(д, "Янв | █████ 10"))
    проверить(содержит(д, "Фев | ██████████ 20"))
конец

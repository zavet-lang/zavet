приими openapi из "./главный.молитва"

тест "сборка OpenAPI 3.0.3 и маршруты /openapi.json + /docs"
    пусть спека = openapi.создать("API Завета", "1.2.0", "Учебный сервис")
    спека.сервер("http://127.0.0.1:8080", "Локальный")
    спека.тег("пользователи", "Операции с пользователями")
    спека.схема("User", openapi.схема_объект({
        "id": openapi.схема_целое("Идентификатор", 1),
        "name": openapi.схема_строка("Имя", "Аня"),
    }, ["id", "name"]))

    спека.маршрут("GET", "/users/:id", {
        "сводка": "Получить пользователя",
        "теги": ["пользователи"],
        "параметры": [{"имя": "id", "где": "path", "схема": openapi.схема_целое()}],
        "ответы": {"200": {"описание": "Найден", "схема": openapi.ссылка("User")}},
    })

    пусть док = спека.собрать()
    проверить(док["openapi"] == "3.0.3")
    проверить(док["info"]["title"] == "API Завета")
    проверить(получить(док["paths"], '/users/{id}', ничего) != ничего)
    проверить(док["paths"]['/users/{id}']["get"]["summary"] == "Получить пользователя")
    проверить(получить(док["components"]["schemas"], "User", ничего) != ничего)

    пусть app = веб.приложение()
    спека.подключить(app)
    пусть rJson = app.обработать("GET", "/openapi.json")
    проверить(rJson["статус"] == 200)
    проверить(содержит(rJson["тело"], "3.0.3"))

    пусть rHtml = app.обработать("GET", "/docs")
    проверить(rHtml["статус"] == 200)
    пусть html = rHtml["тело"]
    проверить(содержит(html, '/users/{id}'))

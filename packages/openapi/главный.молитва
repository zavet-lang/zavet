# Пакет «openapi» — конструктор спецификации OpenAPI 3.0.3 и HTML-документации для «веб».

# Вспомогательные конструкторы JSON Schema.
открой слово схема_строка(описание = "", пример = ничего)
    измени s = {"type": "string"}
    если описание != ""
        s["description"] = описание
    конец
    если пример != ничего
        s["example"] = пример
    конец
    аминь s
конец

открой слово схема_целое(описание = "", пример = ничего)
    измени s = {"type": "integer"}
    если описание != ""
        s["description"] = описание
    конец
    если пример != ничего
        s["example"] = пример
    конец
    аминь s
конец

открой слово схема_число(описание = "")
    измени s = {"type": "number"}
    если описание != ""
        s["description"] = описание
    конец
    аминь s
конец

открой слово схема_булево(описание = "")
    измени s = {"type": "boolean"}
    если описание != ""
        s["description"] = описание
    конец
    аминь s
конец

открой слово схема_массив(элемент)
    аминь {"type": "array", "items": элемент}
конец

открой слово схема_объект(свойства, обязательные = ничего)
    измени s = {"type": "object", "properties": свойства}
    если обязательные != ничего и длина(обязательные) > 0
        s["required"] = обязательные
    конец
    аминь s
конец

открой слово ссылка(имяСхемы)
    аминь {"$ref": "#/components/schemas/" + имяСхемы}
конец

# Преобразует путь вида "/users/:id" в OpenAPI-формат "/users/{id}".
слово путь_в_openapi(путьМаршрута)
    пусть части = разделить(путьМаршрута, "/")
    измени итог = []
    для ч в части
        если начинается_с(ч, ":")
            добавить(итог, '{' + подстрока(ч, 1, длина(ч)) + '}')
        иначе
            добавить(итог, ч)
        конец
    конец
    аминь соединить(итог, "/")
конец

# Конструктор документа OpenAPI 3.0.3.
открой образ Спецификация
    слово создать(название, версия = "1.0.0", описание = "")
        это.название = название
        это.версия = версия
        это.описание = описание
        это.серверы = []
        это.пути = {}
        это.схемы = {}
        это.теги = []
    конец

    слово сервер(url, описание = "")
        добавить(это.серверы, {"url": url, "description": описание})
        аминь это
    конец

    слово тег(имя, описание = "")
        добавить(это.теги, {"name": имя, "description": описание})
        аминь это
    конец

    слово схема(имя, описаниеСхемы)
        это.схемы[имя] = описаниеСхемы
        аминь это
    конец

    # Регистрирует операцию OpenAPI.
    # опции: {сводка, описание, теги, параметры, тело, ответы}
    слово маршрут(метод, путьМаршрута, опции = ничего)
        пусть оп = опции ?? {}
        пусть нормПуть = путь_в_openapi(путьМаршрута)
        пусть м = нижний(метод)

        если получить(это.пути, нормПуть, ничего) == ничего
            это.пути[нормПуть] = {}
        конец

        измени операция = {
            "summary": получить(оп, "сводка", ""),
            "description": получить(оп, "описание", ""),
            "responses": {},
        }

        пусть теги = получить(оп, "теги", [])
        если длина(теги) > 0
            операция["tags"] = теги
        конец

        пусть парам = получить(оп, "параметры", [])
        если длина(парам) > 0
            измени списокПар = []
            для п в парам
                добавить(списокПар, {
                    "name": п["имя"],
                    "in": получить(п, "где", "query"),
                    "required": получить(п, "обязательный", получить(п, "где", "query") == "path"),
                    "description": получить(п, "описание", ""),
                    "schema": получить(п, "схема", схема_строка()),
                })
            конец
            операция["parameters"] = списокПар
        конец

        пусть тело = получить(оп, "тело", ничего)
        если тело != ничего
            операция["requestBody"] = {
                "required": истина,
                "content": {
                    "application/json": {"schema": тело},
                },
            }
        конец

        пусть ответы = получить(оп, "ответы", {"200": {"описание": "Успешный ответ"}})
        для код в ключи(ответы)
            пусть отв = ответы[код]
            измени запОтв = {"description": получить(отв, "описание", "Ответ " + код)}
            если получить(отв, "схема", ничего) != ничего
                запОтв["content"] = {"application/json": {"schema": отв["схема"]}}
            конец
            операция["responses"][строка(код)] = запОтв
        конец

        это.пути[нормПуть][м] = операция
        аминь это
    конец

    # Возвращает итоговый словарь OpenAPI 3.0.3.
    слово собрать()
        измени док = {
            "openapi": "3.0.3",
            "info": {
                "title": это.название,
                "version": это.версия,
                "description": это.описание,
            },
            "paths": это.пути,
        }
        если длина(это.серверы) > 0
            док["servers"] = это.серверы
        конец
        если длина(это.теги) > 0
            док["tags"] = это.теги
        конец
        если длина(ключи(это.схемы)) > 0
            док["components"] = {"schemas": это.схемы}
        конец
        аминь док
    конец

    слово в_json()
        аминь json.создать(это.собрать())
    конец

    # Генерирует этоодостаточную HTML-страницу документации без внешних CDN.
    слово в_html()
        измени строки = [
            "<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\"><title>" + шаблон.экранировать(это.название) + "</title>",
            "<style>body{font-family:system-ui,sans-serif;max-width:900px;margin:2rem auto;padding:0 1rem;color:#111}h1{margin-bottom:.25rem}.meta{color:#555;margin-bottom:1.5rem}.op{border:1px solid #ddd;border-radius:6px;padding:.75rem 1rem;margin:.75rem 0}.m{display:inline-block;font-weight:700;padding:.15rem .5rem;border-radius:4px;background:#1f2937;color:#fff;margin-right:.5rem;font-size:.8rem}code{background:#f3f4f6;padding:.1rem .3rem;border-radius:3px}</style>",
            "</head><body>",
            "<h1>" + шаблон.экранировать(это.название) + " <small>v" + шаблон.экранировать(это.версия) + "</small></h1>",
            "<p class=\"meta\">" + шаблон.экранировать(это.описание) + "</p>",
        ]
        для п в ключи(это.пути)
            пусть методы = это.пути[п]
            для м в ключи(методы)
                пусть оп = методы[м]
                добавить(строки, "<div class=\"op\"><span class=\"m\">" + верхний(м) + "</span><code>" + шаблон.экранировать(п) + "</code> — " + шаблон.экранировать(оп["summary"]) + "</div>")
            конец
        конец
        добавить(строки, "</body></html>")
        аминь соединить(строки, "\n")
    конец

    # Подключает маршруты /openapi.json и /docs к веб.приложение().
    слово подключить(app, путьJson = "/openapi.json", путьDocs = "/docs")
        пусть спека = это
        app.получить(путьJson, слово(запрос): веб.json(спека.собрать()))
        app.получить(путьDocs, слово(запрос): веб.html(спека.в_html()))
        аминь app
    конец
конец

открой слово создать(название, версия = "1.0.0", описание = "")
    аминь Спецификация(название, версия, описание)
конец

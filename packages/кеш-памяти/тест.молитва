приими кеш из "./главный.молитва"

тест "LRU вытеснение, обновление порядка и TTL"
    измени тик = 100
    пусть к = кеш.создать({"макс_размер": 2, "ttl": 60, "часы": слово(): тик})

    к.установить("a", 1)
    к.установить("b", 2)
    # Обращение к "a" делает "b" самым старым
    проверить(к.получить("a") == 1)
    к.установить("c", 3)

    проверить(к.есть("b") == ложь)
    проверить(к.получить("a") == 1)
    проверить(к.получить("c") == 3)

    тик = 200
    проверить(к.получить("a", -1) == -1)
    проверить(к.очистить_просроченные() == 1)
    проверить(к.размер() == 0)
конец

тест "получить_или и статистика"
    пусть к = кеш.создать({"макс_размер": 10})
    измени вызовов = 0
    пусть фаб = слово()
        вызовов = вызовов + 1
        аминь "результат"
    конец
    проверить(к.получить_или("x", фаб) == "результат")
    проверить(к.получить_или("x", фаб) == "результат")
    проверить(вызовов == 1)
    проверить(к.статистика()["попадания"] == 1)
конец

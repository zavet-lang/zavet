# Пакет «кеш-памяти» — LRU + TTL кеш в оперативной памяти с ограничением числа записей.

открой образ Кеш
    слово создать(опции = ничего)
        пусть оп = опции ?? {}
        это.макс_размер = получить(оп, "макс_размер", 500)
        это.ttl_умолч = получить(оп, "ttl", 0)
        это._часы = получить(оп, "часы", слово(): время.сейчас())
        это._данные = {}
        это._порядок = []
        это._попадания = 0
        это._промахи = 0
    конец

    слово _убрать_из_порядка(ключ)
        измени новСписок = []
        для к в это._порядок
            если к != ключ
                добавить(новСписок, к)
            конец
        конец
        это._порядок = новСписок
    конец

    слово _поднять(ключ)
        это._убрать_из_порядка(ключ)
        добавить(это._порядок, ключ)
    конец

    слово установить(ключ, значение, ttl = ничего)
        пусть к = строка(ключ)
        пусть срок = если ttl != ничего: ttl иначе: это.ttl_умолч
        пусть истекает = если срок > 0: это._часы() + срок иначе: 0

        это._данные[к] = {"значение": значение, "истекает": истекает}
        это._поднять(к)

        # Вытеснение самых давно не использовавшихся (LRU)
        доколе длина(это._порядок) > это.макс_размер
            пусть старый = это._порядок[0]
            удалить(это._порядок, 0)
            это._данные[старый] = ничего
        конец
        аминь это
    конец

    слово получить(ключ, умолч = ничего)
        пусть к = строка(ключ)
        пусть зап = получить(это._данные, к, ничего)
        если зап == ничего
            это._промахи = это._промахи + 1
            аминь умолч
        конец
        если зап["истекает"] > 0 и зап["истекает"] <= это._часы()
            это.удалить(к)
            это._промахи = это._промахи + 1
            аминь умолч
        конец
        это._поднять(к)
        это._попадания = это._попадания + 1
        аминь зап["значение"]
    конец

    слово есть(ключ)
        пусть к = строка(ключ)
        пусть зап = получить(это._данные, к, ничего)
        если зап == ничего
            аминь ложь
        конец
        если зап["истекает"] > 0 и зап["истекает"] <= это._часы()
            это.удалить(к)
            аминь ложь
        конец
        аминь истина
    конец

    # Возвращает значение из кеша или вычисляет через фабрику и сохраняет.
    слово получить_или(ключ, фабрика, ttl = ничего)
        если это.есть(ключ)
            аминь это.получить(ключ)
        конец
        пусть зн = фабрика()
        это.установить(ключ, зн, ttl)
        аминь зн
    конец

    слово удалить(ключ)
        пусть к = строка(ключ)
        это._данные[к] = ничего
        это._убрать_из_порядка(к)
    конец

    слово очистить_просроченные()
        пусть сейчас = это._часы()
        измени удалено = 0
        измени живые = []
        для к в это._порядок
            пусть зап = получить(это._данные, к, ничего)
            если зап == ничего
                продолжи
            конец
            если зап["истекает"] > 0 и зап["истекает"] <= сейчас
                это._данные[к] = ничего
                удалено = удалено + 1
            иначе
                добавить(живые, к)
            конец
        конец
        это._порядок = живые
        аминь удалено
    конец

    слово очистить()
        это._данные = {}
        это._порядок = []
    конец

    слово размер()
        аминь длина(это._порядок)
    конец

    слово статистика()
        пусть всего = это._попадания + это._промахи
        пусть доля = если всего > 0: (это._попадания * 1.0) / (всего * 1.0) иначе: 0.0
        аминь {
            "размер": это.размер(),
            "макс_размер": это.макс_размер,
            "попадания": это._попадания,
            "промахи": это._промахи,
            "доля_попаданий": доля,
        }
    конец
конец

открой слово создать(опции = ничего)
    аминь Кеш(опции)
конец

# Многоуровневое наследование, «родитель» в обычных методах, «новый» с наследованием.

образ Существо
    слово создать(имя, возраст = 1)
        это.имя = имя
        это.возраст = возраст
    конец
    слово кто(): "Существо {это.имя}"
    слово дышит(): "дышит"
конец

образ Зверь наследует Существо
    слово кто(): "Зверь>" + родитель.кто()
конец

образ Пёс наследует Зверь
    слово создать(имя)
        родитель.создать(имя, 5)
        это.порода = "дворняга"
    конец
    слово кто(): "Пёс>" + родитель.кто()
конец

пусть з = Зверь("Мурзик")
возгласи(з.кто())
возгласи(з.возраст)

пусть п = Пёс("Бобик")
возгласи(п.кто())
возгласи(п.дышит())
возгласи(п.возраст)
возгласи(п.порода)

пусть н = новый Пёс("Шарик")
возгласи(н.кто())

образ Пустой
конец
пусть пу = новый Пустой()
возгласи(тип(пу))

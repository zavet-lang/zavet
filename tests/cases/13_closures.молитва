# Замыкание: внутренняя слово помнит измениенную внешней
слово счётчик_от(начало)
    измени n = начало
    слово следующий()
        n = n + 1
        аминь n
    конец
    аминь следующий
конец

пусть f = счётчик_от(10)
возгласи(f())
возгласи(f())
возгласи(f())


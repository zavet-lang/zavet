# Тест: stack trace при ошибках в вложенных вызовах.
# Stack trace должен показывать цепочку вызовов от ошибки до точки входа.

слово инверсия(x): 1 / x

слово обработать_число(n)
    аминь инверсия(n)
конец

слово обработать_список(числа)
    пусть результаты = []
    для x в числа
        добавить(результаты, обработать_число(x))
    конец
    аминь результаты
конец

# Ошибка возникнет при делении 1/0 в функции "инверсия".

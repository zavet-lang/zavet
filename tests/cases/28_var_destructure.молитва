# «измени» с деструктуризацией и множественным объявлением — изменяемые связи.

измени а, б = [1, 2]
а += 10
б = 20
возгласи(а)
возгласи(б)

измени [п, ...остальные] = [1, 2, 3]
п = 100
возгласи(п)
возгласи(остальные)

# «пусть» остаётся неизменяемым.
попытка
    пусть [м, н] = [1, 2]
    м = 5
поймать e
    возгласи("пусть неизменяем")
конец

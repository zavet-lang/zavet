# YAML
пусть y = '
имя: Завет
версия: 1
активен: true
теги:
  - русский
  - быстрый
'
пусть конфиг = yaml.разобрать(y)
возгласи(конфиг["имя"], конфиг["версия"], конфиг["активен"], длина(конфиг["теги"]))
пусть обратно = yaml.разобрать(yaml.создать({"a": 10, "b": [1, 2]}))
возгласи(обратно["a"], обратно["b"][1])

# Сжатие (gzip и zlib)
пусть текст = "В начале было Слово, и Слово было у Бога."
пусть gz = сжатие.gzip_сжать(текст)
возгласи(сжатие.gzip_распаковать(gz) == текст)
пусть zl = сжатие.zlib_сжать(текст)
возгласи(сжатие.zlib_распаковать(zl) == текст)

# Почта
возгласи(почта.проверить_адрес("ivan@example.com"))
возгласи(почта.проверить_адрес("плохой-адрес"))
пусть письмо = почта.собрать("a@b.ru", "c@d.ru", "Привет", "Мир вам")
возгласи(содержит(письмо, "Subject: Привет"))

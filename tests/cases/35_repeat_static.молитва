# прерви и продолжи внутри повтори
измени шаг = 0
измени пройдено = 0
повтори 6 раз
    шаг += 1
    если шаг == 2: продолжи
    если шаг == 5: прерви
    пройдено += шаг
конец
возгласи(пройдено)

# Статические методы и поля в образе
образ Счётчик
    статичная пусть ТИП = "Базовый"
    статичная измени всего: целое = 0

    статичная слово прибавить(n: целое) -> целое
        Счётчик.всего += n
        аминь Счётчик.всего
    конец

    статичная слово удвоить(x): x * 2

    слово создать(имя)
        это.имя = имя
        Счётчик.прибавить(1)
    конец

    слово кто()
        аминь "{это.имя}:{Счётчик.ТИП}"
    конец
конец

образ ОсобыйСчётчик наследует Счётчик
    слово создать(имя, метка)
        родитель.создать(имя)
        это.метка = метка
    конец
конец

возгласи(Счётчик.ТИП)
возгласи(Счётчик.всего)
возгласи(Счётчик.удвоить(7))

пусть а = Счётчик("А")
пусть б = ОсобыйСчётчик("Б", "vip")
возгласи(Счётчик.всего)
возгласи(а.кто())
возгласи(б.кто())
возгласи(ОсобыйСчётчик.ТИП)
возгласи(ОсобыйСчётчик.удвоить(9))

Счётчик.прибавить(10)
возгласи(Счётчик.всего)

# Защита статичная пусть от перезаписи

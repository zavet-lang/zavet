# Тернарник — краткая форма для коротких случаев
пусть x = 5
возгласи(x > 0 ? "+" : "-")

# В выражении
слово знак(n): n > 0 ? "плюс" : (n < 0 ? "минус" : "ноль")
возгласи(знак(7))
возгласи(знак(-3))
возгласи(знак(0))

# Эквивалентность с inline-если
пусть a = 10
пусть через_тернарник = a >= 18 ? "взрослый" : "ребёнок"
пусть через_если = если a >= 18: "взрослый" иначе: "ребёнок"
возгласи(через_тернарник)
возгласи(через_если)
возгласи(через_тернарник == через_если)

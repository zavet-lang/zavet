# Порядок ключей сохраняется как в исходнике
пусть человек = {
    "имя": "Иван",
    "возраст": 30,
    "город": "Казань",
    "профессия": "врач",
    "хобби": "шахматы",
}

возгласи(человек)
возгласи(ключи(человек))
возгласи(значения(человек))
возгласи(json.создать(человек))

# Итерация for-in идёт в порядке вставки
для значение в человек: возгласи(значение)

# Добавление новых ключей сохраняет порядок
измени словарь = {"первый": 1, "второй": 2}
словарь["третий"] = 3
словарь["четвёртый"] = 4
возгласи(ключи(словарь))

# Обновление существующего ключа НЕ меняет порядок
словарь["первый"] = 100
возгласи(ключи(словарь))
возгласи(значения(словарь))

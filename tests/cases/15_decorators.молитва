слово логировать(f)
    слово обёртка(x)
        возгласи("вход: " + строка(x))
        пусть результат = f(x)
        возгласи("выход: " + строка(результат))
        аминь результат
    конец
    аминь обёртка
конец

@логировать
слово квадрат(x): x * x

возгласи(квадрат(5))
возгласи(квадрат(3))

# Декораторы складываются
слово дважды(f)
    слово обёртка(x)
        аминь f(f(x))
    конец
    аминь обёртка
конец

@дважды
слово плюс_один(x): x + 1

возгласи(плюс_один(10))

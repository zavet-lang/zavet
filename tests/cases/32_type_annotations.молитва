пусть x: целое = 42
измени имя: строка = "Иван"
пусть опц: строка? = ничего

слово сложить(a: целое, b: целое) -> целое
    аминь a + b
конец

слово привет(кого: строка?) -> строка
    если кого == ничего: аминь "Мир!"
    аминь "Мир, {кого}!"
конец

образ Точка
    слово создать(x: число, y: число)
        это.x = x
        это.y = y
    конец
конец

слово описать(p: Точка) -> строка
    аминь "{p.x}:{p.y}"
конец

возгласи(x, имя, опц)
возгласи(сложить(10, 20))
возгласи(привет(ничего))
возгласи(привет("Петр"))
возгласи(описать(Точка(3, 4.5)))

попытка
    пусть плохо: целое = "не число"
поймать e
    возгласи("поймано_перем")
конец

попытка
    сложить("а", 2)
поймать e
    возгласи("поймано_парам")
конец

слово сломанная() -> целое
    аминь "строка"
конец

попытка
    сломанная()
поймать e
    возгласи("поймано_возврат")
конец

образ Точка
    слово создать(x, y)
        это.x = x
        это.y = y
    конец

    слово длина()
        аминь корень(это.x * это.x + это.y * это.y)
    конец
конец

пусть p = Точка(3, 4)
возгласи(p.x)
возгласи(p.y)
возгласи(p.длина())

образ Животное
    слово создать(имя)
        это.имя = имя
    конец

    слово голос()
        аминь "{это.имя}: звук"
    конец
конец

образ Кот наследует Животное
    слово голос()
        аминь "{это.имя}: мяу"
    конец
конец

образ Собака наследует Животное
    слово создать(имя, порода)
        родитель.создать(имя)
        это.порода = порода
    конец

    слово голос()
        аминь "{это.имя} ({это.порода}): гав"
    конец
конец

пусть барсик = Кот("Барсик")
пусть бобик = Собака("Бобик", "Овчарка")
возгласи(барсик.голос())
возгласи(бобик.голос())

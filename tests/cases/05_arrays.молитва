пусть числа = [1, 2, 3, 4, 5]
возгласи(длина(числа))
возгласи(сумма(числа))
возгласи(числа[0])
возгласи(числа[-1])
возгласи(числа[1:4])
возгласи(числа[:2])
возгласи(числа[3:])

пусть чётные = фильтр(числа, x => x % 2 == 0)
возгласи(чётные)

пусть квадраты = преобразовать(числа, x => x * x)
возгласи(квадраты)

возгласи(все(числа, x => x > 0))
возгласи(любой(числа, x => x > 4))

пусть уник = уникальные([1, 2, 2, 3, 3, 3, 4])
возгласи(уник)

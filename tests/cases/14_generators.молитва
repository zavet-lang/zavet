# Простой генератор
слово числа()
    выдать 1
    выдать 2
    выдать 3
конец

# Через for-in
для x в числа(): возгласи(x)

# Через взять()
возгласи(взять(числа(), 2))

# Бесконечный генератор + взять
слово натуральные()
    измени n = 0
    доколе истина
        n += 1
        выдать n
    конец
конец
возгласи(взять(натуральные(), 5))

# Фибоначчи
слово фиб()
    измени a = 0
    измени b = 1
    доколе истина
        выдать a
        пусть t = a + b
        a = b
        b = t
    конец
конец
возгласи(взять(фиб(), 8))

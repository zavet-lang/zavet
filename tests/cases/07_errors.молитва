слово делить(a, b)
    если b == 0: бросить "деление на ноль"
    аминь a / b
конец

попытка
    возгласи(делить(10, 2))
поймать e
    возгласи("ошибка: {e}")
конец

попытка
    возгласи(делить(10, 0))
поймать e
    возгласи("поймал: {e}")
конец

измени порядок = []
попытка
    добавить(порядок, "a")
    бросить "x"
поймать _

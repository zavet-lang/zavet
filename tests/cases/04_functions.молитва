слово плюс(a, b)
    аминь a + b
конец
возгласи(плюс(2, 3))

слово факториал(n)
    если n <= 1: аминь 1
    аминь n * факториал(n - 1)
конец
возгласи(факториал(5))

слово степень(основание, показатель = 2): основание * основание
возгласи(степень(7))
возгласи(степень(3, 5))

пусть удвоить = x => x * 2
возгласи(удвоить(21))

слово применить(f, x)
    аминь f(x)
конец
возгласи(применить(удвоить, 10))

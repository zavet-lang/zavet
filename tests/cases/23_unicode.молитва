пусть фраза = "Завет"
# длина считает символы Юникода, а не байты
возгласи(длина(фраза))
возгласи(длина("Привет"))

# Перебор символов: for-in идёт правильно по UTF-8
для буква в "Завет"
    возгласи(буква)
конец

# Конкатенация и интерполяция с кириллицей
пусть имя = "Аня"
пусть возраст = 25
возгласи("{имя}, {возраст} лет")

# Регистр для кириллицы
возгласи(верхний("привет"))
возгласи(нижний("МИР"))

# Содержит для кириллицы
возгласи(содержит("программирование", "грамм"))
возгласи(содержит("Завет язык", "З"))

# Реверс работает по символам
возгласи(длина("ёлочка"))

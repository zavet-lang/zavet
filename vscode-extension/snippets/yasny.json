{
  "слово": {
    "prefix": "слово",
    "body": [
      "слово ${1:имя}(${2:параметры})",
      "\t${3}",
      "\tаминь ${4:результат}",
      "конец"
    ],
    "description": "Объявление слова (функции)"
  },
  "слово-короткое": {
    "prefix": "словок",
    "body": [
      "слово ${1:имя}(${2:параметры}): ${3:выражение}"
    ],
    "description": "Короткая форма слова"
  },
  "лямбда": {
    "prefix": "лямбда",
    "body": [
      "${1:параметр} => ${2:выражение}"
    ],
    "description": "Лямбда"
  },
  "пусть": {
    "prefix": "пусть",
    "body": [
      "пусть ${1:имя} = ${2:значение}"
    ],
    "description": "Неизменяемое связывание"
  },
  "измени": {
    "prefix": "измени",
    "body": [
      "измени ${1:имя} = ${2:значение}"
    ],
    "description": "Изменяемое связывание"
  },
  "если": {
    "prefix": "если",
    "body": [
      "если ${1:условие}",
      "\t${2}",
      "конец"
    ],
    "description": "Условие"
  },
  "если-иначе": {
    "prefix": "иначе",
    "body": [
      "если ${1:условие}",
      "\t${2}",
      "иначе",
      "\t${3}",
      "конец"
    ],
    "description": "Условие с иначе"
  },
  "для-в": {
    "prefix": "длв",
    "body": [
      "для ${1:элемент} в ${2:коллекция}",
      "\t${3}",
      "конец"
    ],
    "description": "Цикл по коллекции"
  },
  "для-от-до": {
    "prefix": "длото",
    "body": [
      "для ${1:i} от ${2:1} до ${3:10}",
      "\t${4}",
      "конец"
    ],
    "description": "Цикл со счётчиком"
  },
  "доколе": {
    "prefix": "доколе",
    "body": [
      "доколе ${1:условие}",
      "\t${2}",
      "конец"
    ],
    "description": "Цикл доколе"
  },
  "образ": {
    "prefix": "образ",
    "body": [
      "образ ${1:Имя}",
      "\tслово создать(${2:параметры})",
      "\t\tэто.${3:поле} = ${3}",
      "\tконец",
      "конец"
    ],
    "description": "Образ (класс)"
  },
  "разбери": {
    "prefix": "разбери",
    "body": [
      "разбери ${1:значение}",
      "\tкогда ${2:вариант}: ${3}",
      "\tиначе: ${4}",
      "конец"
    ],
    "description": "Сопоставление"
  },
  "попытка": {
    "prefix": "попытка",
    "body": [
      "попытка",
      "\t${1}",
      "поймать ${2:ошибка}",
      "\t${3}",
      "конец"
    ],
    "description": "Обработка ошибок"
  },
  "приими": {
    "prefix": "приими",
    "body": [
      "приими ${1:имя} из \"${2:путь.молитва}\""
    ],
    "description": "Приим модуля"
  },
  "стих": {
    "prefix": "стих",
    "body": [
      "возгласи(стих(\"${1:Ин}\", ${2:1}, ${3:1}))"
    ],
    "description": "Стих Синодального перевода"
  },
  "возгласи": {
    "prefix": "возгласи",
    "body": [
      "возгласи(\"${1:текст}\")"
    ],
    "description": "Вывод"
  }
}

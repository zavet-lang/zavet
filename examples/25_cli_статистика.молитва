# Пример 25. CLI-утилита подсчёта статистики текстового файла.
# Использование:
#   zavet examples/25_cli_статистика.молитва <файл> [--json]
#   zavet examples/25_cli_статистика.молитва --помощь

слово подсчитать_статистику(текст: строка)
    пусть строки = разделить(текст, "\n")
    измени непустых = 0
    измени слов = 0
    измени частоты = {}

    для стр в строки
        если обрезать(стр) != ""
            непустых += 1
        конец
        пусть куски = регвыр.найти(стр, '[\p{L}\p{N}]+(?:[-_][\p{L}\p{N}]+)*')
        для сл в куски
            пусть с = нижний(сл)
            если с != ""
                слов += 1
                пусть старое = частоты[с]
                если старое == ничего
                    частоты[с] = 1
                иначе
                    частоты[с] = старое + 1
                конец
            конец
        конец
    конец

    # Выбираем топ-3 самых частых слова
    пусть топ = []
    измени использовано = {}
    повтори 3 раз
        измени лучшееСлово = ""
        измени лучшееЗнач = 0
        для к в ключи(частоты)
            если использовано[к] == истина: продолжи
            пусть ч = частоты[к]
            если ч > лучшееЗнач
                лучшееЗнач = ч
                лучшееСлово = к
            конец
        конец
        если лучшееСлово == "": прерви
        использовано[лучшееСлово] = истина
        добавить(топ, {"слово": лучшееСлово, "раз": лучшееЗнач})
    конец

    измени строкКолво = 0
    если текст != ""
        строкКолво = длина(строки)
    конец
    аминь {
        "строк": строкКолво,
        "непустых": непустых,
        "слов": слов,
        "символов": длина(текст),
        "топ": топ,
    }
конец

слово напечатать_отчёт(путьКФайлу: строка, стат, какJson: булево)
    если какJson
        возгласи(json.создать({
            "файл": путьКФайлу,
            "статистика": стат,
        }))
        аминь ничего
    конец
    пусть кСтрок = стат["строк"]
    пусть кНепуст = стат["непустых"]
    пусть кСлов = стат["слов"]
    пусть кСимв = стат["символов"]
    пусть топСлова = стат["топ"]
    возгласи("Файл:       {путьКФайлу}")
    возгласи("Строк:      {кСтрок} (непустых: {кНепуст})")
    возгласи("Слов:       {кСлов}")
    возгласи("Символов:   {кСимв}")
    если длина(топСлова) > 0
        возгласи("Частые слова:")
        для п в топСлова
            пусть сл = п["слово"]
            пусть рз = п["раз"]
            возгласи("  - {сл}: {рз}")
        конец
    конец
конец

# Возвращает {"cli": булево, "арги": массив}: cli=истина при запуске скрипта через zavet файл.молитва
слово разбор_вызова()
    пусть все = ос.аргументы()
    измени idx = -1
    для i, а в все
        если заканчивается_на(а, ".молитва")
            idx = i
            прерви
        конец
    конец
    если idx < 0
        аминь {"cli": ложь, "арги": []}
    конец
    пусть хвост = []
    для i, а в все
        если i > idx
            добавить(хвост, а)
        конец
    конец
    аминь {"cli": истина, "арги": хвост}
конец

пусть вызов = разбор_вызова()
измени толькоCli = ложь
если вызов["cli"]
    если длина(вызов["арги"]) > 0
        толькоCli = истина
    конец
конец

если не толькоCli
    тест "подсчёт строк, слов, символов и топ-слов"
        пусть образец = "Слово стало плотью.\nСлово в начале,\n\nслово свет."
        пусть с = подсчитать_статистику(образец)
        проверить с["строк"] == 4
        проверить с["непустых"] == 3
        проверить с["слов"] == 8
        проверить длина(с["топ"]) >= 1
        проверить с["топ"][0]["слово"] == "слово"
        проверить с["топ"][0]["раз"] == 3
    конец

    тест "пустая строка даёт нули"
        пусть с = подсчитать_статистику("")
        проверить с["строк"] == 0
        проверить с["слов"] == 0
        проверить с["символов"] == 0
    конец
конец

если вызов["cli"]
    пусть арги = вызов["арги"]
    если длина(арги) == 0
        возгласи("Использование: zavet examples/25_cli_статистика.молитва <файл> [--json]")
        ос.выход(0)
    конец

    измени путьКФайлу = ""
    измени форматJson = ложь
    измени помощь = ложь
    для а в арги
        если а == "--помощь" или а == "-h"
            помощь = истина
        иначеесли а == "--json"
            форматJson = истина
        иначе
            путьКФайлу = а
        конец
    конец

    если помощь
        возгласи("Статистика текста — CLI-утилита на Завете")
        возгласи("Использование: zavet examples/25_cli_статистика.молитва <файл> [--json]")
        ос.выход(0)
    конец

    если путьКФайлу == ""
        возгласи("Ошибка: укажите путь к файлу")
        ос.выход(1)
    конец

    если не файлы.существует(путьКФайлу)
        возгласи("Ошибка: файл «{путьКФайлу}» не найден")
        ос.выход(1)
    конец

    попытка
        пусть содержимое = файлы.читать(путьКФайлу)
        пусть стат = подсчитать_статистику(содержимое)
        напечатать_отчёт(путьКФайлу, стат, форматJson)
        ос.выход(0)
    поймать о
        возгласи("Ошибка чтения «{путьКФайлу}»: {о}")
        ос.выход(1)
    конец
конец

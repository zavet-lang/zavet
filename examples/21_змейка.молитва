# Змейка с окном (модуль «окно»).
# Управление: стрелки или WASD, P — пауза, R / пробел — заново, Esc — выход.

пусть КОЛ = 24
пусть РЯД = 18
пусть КЛЕТКА = 28
пусть ПОЛЕ_X = 0
пусть ПОЛЕ_Y = 40
пусть ШИР = КОЛ * КЛЕТКА
пусть ВЫС = ПОЛЕ_Y + РЯД * КЛЕТКА

окно.создать(ШИР, ВЫС, "Змейка — Завет")

слово клетка(x, y, r, g, b)
    окно.прямоугольник(ПОЛЕ_X + x * КЛЕТКА + 1, ПОЛЕ_Y + y * КЛЕТКА + 1, КЛЕТКА - 2, КЛЕТКА - 2, r, g, b)
конец

слово на_змее(тело, x, y)
    для с в тело
        если с[0] == x и с[1] == y
            аминь истина
        конец
    конец
    аминь ложь
конец

слово новая_еда(тело)
    доколе истина
        пусть x = случайное.целое(0, КОЛ - 1)
        пусть y = случайное.целое(0, РЯД - 1)
        если не на_змее(тело, x, y)
            аминь [x, y]
        конец
    конец
конец

слово сброс()
    пусть тело = [[6, 9], [5, 9], [4, 9]]
    аминь {
        "тело": тело,
        "еда": новая_еда(тело),
        "дx": 1,
        "дy": 0,
        "ожид_дx": 1,
        "ожид_дy": 0,
        "счёт": 0,
        "рекорд": 0,
        "живо": истина,
        "пауза": ложь,
        "пауза_клавиша": ложь,
        "шаг_мс": 120,
        "след_ход": время.метка(),
    }
конец

измени игра = сброс()
измени рекорд = 0

слово читать_ввод()
    если окно.клавиша("escape")
        окно.закрыть()
        аминь ничего
    конец

    если не игра["живо"]
        если окно.клавиша("пробел") или окно.клавиша("r")
            пусть р = рекорд
            игра = сброс()
            игра["рекорд"] = р
        конец
        аминь ничего
    конец

    если окно.клавиша("p") или окно.клавиша("з")
        # переключение паузы по удержанию сгладим таймером внутри кадра — простой toggle-гард
        если не игра["пауза_клавиша"]
            игра["пауза"] = не игра["пауза"]
            игра["пауза_клавиша"] = истина
        конец
    иначе
        игра["пауза_клавиша"] = ложь
    конец

    измени нx = игра["ожид_дx"]
    измени нy = игра["ожид_дy"]
    пусть тx = игра["дx"]
    пусть тy = игра["дy"]

    если окно.клавиша("влево") или окно.клавиша("a")
        если тx != 1
            нx = -1
            нy = 0
        конец
    конец
    если окно.клавиша("вправо") или окно.клавиша("d")
        если тx != -1
            нx = 1
            нy = 0
        конец
    конец
    если окно.клавиша("вверх") или окно.клавиша("w")
        если тy != 1
            нx = 0
            нy = -1
        конец
    конец
    если окно.клавиша("вниз") или окно.клавиша("s")
        если тy != -1
            нx = 0
            нy = 1
        конец
    конец

    игра["ожид_дx"] = нx
    игра["ожид_дy"] = нy
конец

слово ход()
    если не игра["живо"] или игра["пауза"]
        аминь ничего
    конец

    игра["дx"] = игра["ожид_дx"]
    игра["дy"] = игра["ожид_дy"]

    пусть тело = игра["тело"]
    пусть голова = тело[0]
    пусть nx = голова[0] + игра["дx"]
    пусть ny = голова[1] + игра["дy"]

    если nx < 0 или ny < 0 или nx >= КОЛ или ny >= РЯД или на_змее(тело, nx, ny)
        игра["живо"] = ложь
        если игра["счёт"] > рекорд
            рекорд = игра["счёт"]
            игра["рекорд"] = рекорд
        конец
        аминь ничего
    конец

    вставить(тело, 0, [nx, ny])

    пусть еда = игра["еда"]
    если nx == еда[0] и ny == еда[1]
        игра["счёт"] = игра["счёт"] + 1
        игра["еда"] = новая_еда(тело)
        если игра["шаг_мс"] > 55
            игра["шаг_мс"] = игра["шаг_мс"] - 3
        конец
    иначе
        удалить(тело, длина(тело) - 1)
    конец
конец

слово рисовать()
    окно.очистить(18, 22, 28)

    # панель сверху
    окно.прямоугольник(0, 0, ШИР, ПОЛЕ_Y, 28, 34, 44)
    пусть счёт = игра["счёт"]
    пусть р = рекорд
    окно.текст(12, 10, "Счёт: {счёт}    Рекорд: {р}", 230, 230, 235)

    # поле
    окно.прямоугольник(ПОЛЕ_X, ПОЛЕ_Y, ШИР, РЯД * КЛЕТКА, 24, 30, 38)
    # рамка поля
    окно.прямоугольник(ПОЛЕ_X, ПОЛЕ_Y, ШИР, 2, 40, 50, 64)
    окно.прямоугольник(ПОЛЕ_X, ВЫС - 2, ШИР, 2, 40, 50, 64)
    окно.прямоугольник(ПОЛЕ_X, ПОЛЕ_Y, 2, РЯД * КЛЕТКА, 40, 50, 64)
    окно.прямоугольник(ШИР - 2, ПОЛЕ_Y, 2, РЯД * КЛЕТКА, 40, 50, 64)

    # еда
    пусть е = игра["еда"]
    клетка(е[0], е[1], 220, 70, 70)
    # блик на еде
    окно.прямоугольник(ПОЛЕ_X + е[0] * КЛЕТКА + 8, ПОЛЕ_Y + е[1] * КЛЕТКА + 8, 6, 6, 255, 160, 160)

    # змея
    пусть тело = игра["тело"]
    измени i = 0
    для с в тело
        если i == 0
            клетка(с[0], с[1], 80, 200, 120)
            окно.прямоугольник(ПОЛЕ_X + с[0] * КЛЕТКА + 8, ПОЛЕ_Y + с[1] * КЛЕТКА + 8, 5, 5, 20, 40, 30)
        иначе
            измени t = 90 + (i * 4)
            если t > 160
                t = 160
            конец
            клетка(с[0], с[1], 50, t, 90)
        конец
        i = i + 1
    конец

    если игра["пауза"] и игра["живо"]
        окно.текст(ШИР / 2 - 40, ВЫС / 2 - 10, "ПАУЗА", 240, 220, 100)
        окно.текст(ШИР / 2 - 90, ВЫС / 2 + 18, "P — продолжить", 200, 200, 210)
    конец

    если не игра["живо"]
        окно.прямоугольник(ШИР / 2 - 140, ВЫС / 2 - 50, 280, 100, 12, 14, 18)
        окно.текст(ШИР / 2 - 70, ВЫС / 2 - 30, "Игра окончена", 240, 120, 120)
        окно.текст(ШИР / 2 - 110, ВЫС / 2, "Пробел или R — снова", 210, 210, 220)
        окно.текст(ШИР / 2 - 50, ВЫС / 2 + 26, "Esc — выход", 160, 160, 170)
    конец
конец

# Главный цикл
доколе окно.кадр()
    читать_ввод()

    пусть сейчас = время.метка()
    если сейчас >= игра["след_ход"]
        ход()
        игра["след_ход"] = сейчас + игра["шаг_мс"]
    конец

    рисовать()
    окно.задержка(12)
конец

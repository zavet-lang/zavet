# Одна функция на разных типах значений.

слово макс_из_двух(а, б)
    если а > б
        аминь а
    иначе
        аминь б
    конец
конец

пусть м1 = макс_из_двух(3, 7)
пусть м2 = макс_из_двух(2.5, 1.5)
пусть м3 = макс_из_двух("а", "я")
возгласи("макс(3, 7) = {м1}")
возгласи("макс(2.5, 1.5) = {м2}")
возгласи("макс(а, я) = {м3}")

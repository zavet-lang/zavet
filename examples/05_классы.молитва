# Классы и наследование.

образ Животное
    слово создать(имя)
        это.имя = имя
    конец

    слово говорить()
        аминь "{это.имя} издаёт звук"
    конец
конец

образ Собака наследует Животное
    слово создать(имя, порода)
        родитель.создать(имя)
        это.порода = порода
    конец

    слово говорить()
        аминь "{это.имя} ({это.порода}) лает"
    конец
конец

образ Кот наследует Животное
    # Конструктор не объявлен — берётся от родителя
    слово говорить()
        аминь "{это.имя} мяукает"
    конец
конец

пусть бобик = Собака("Бобик", "Овчарка")
пусть барсик = Кот("Барсик")

возгласи(бобик.говорить())
возгласи(барсик.говорить())

# Обращение к полю
возгласи("Порода Бобика: {бобик.порода}")

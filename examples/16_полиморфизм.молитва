# Общий метод у разных образов + вызов через параметр (bound methods).

образ Кот
    слово создать()
    конец

    слово напечатать()
        аминь "Мяу"
    конец
конец

образ Собака
    слово создать()
    конец

    слово напечатать()
        аминь "Гав"
    конец
конец

слово озвучить(существо)
    возгласи(существо.напечатать())
конец

озвучить(Кот())
озвучить(Собака())

# Функции и рекурсия.

слово приветствовать(имя)
    аминь "Привет, {имя}!"
конец

возгласи(приветствовать("Маша"))

# Параметр по умолчанию
слово степень(основание, показатель = 2)
    аминь основание * основание
конец

возгласи(степень(5))
возгласи(степень(3, 3))

# Рекурсия
слово факториал(n)
    если n <= 1: аминь 1
    аминь n * факториал(n - 1)
конец

возгласи(факториал(5))

# Inline-слово: одно выражение, возвращает автоматически
слово квадрат(x): x * x
возгласи(квадрат(7))

# Лямбда
пусть удвоить = x => x * 2
возгласи(удвоить(21))

# Функция как значение
слово применить(f, x)
    аминь f(x)
конец
возгласи(применить(квадрат, 6))

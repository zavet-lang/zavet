# Работа со стандартными модулями: мат, время, json, регвыр.

# Математика
возгласи("Число пи: {мат.пи}")
возгласи("sin(пи/2) = {мат.sin(мат.пи / 2)}")
возгласи("Корень из 16: {корень(16)}")

# Время
пусть метка = время.сейчас()
возгласи("Сейчас {время.строка()}")
возгласи("Год: {время.год()}, день: {время.день()}")
возгласи("Метка: {метка}")

# JSON
пусть пользователь = {
    "имя": "Олег",
    "возраст": 33,
    "увлечения": ["шахматы", "велосипед"],
}

пусть текст = json.создать(пользователь)
возгласи(текст)

пусть обратно = json.разобрать(текст)
возгласи(обратно["имя"])

# Регулярные выражения
пусть письма = "Свяжитесь: a@x.ru, b@y.com, c@z.org"
возгласи(регвыр.найти(письма, "[a-z]+@[a-z]+\\.[a-z]+"))
возгласи(регвыр.совпадает("12345", "^[0-9]+$"))

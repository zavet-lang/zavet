# Ошибки и попытки.

# Простая обработка ошибки
слово делить(a, b)
    если b == 0
        бросить "деление на ноль"
    конец
    аминь a / b
конец

попытка
    возгласи(делить(10, 2))
    возгласи(делить(10, 0))
поймать ошибка
    возгласи("Не получилось: {ошибка}")
конец

# Блок "всегда" выполняется в любом случае
попытка
    возгласи("Пробуем")
    бросить "что-то пошло не так"
поймать e
    возгласи("Поймали: {e}")
всегда
    возгласи("Этот блок выполнится в любом случае")
конец

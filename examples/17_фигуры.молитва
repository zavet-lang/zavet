# Список фигур с общей площадью и названием.

образ Квадрат
    слово создать(сторона)
        это.сторона = сторона
    конец

    слово площадь()
        аминь это.сторона * это.сторона
    конец

    слово название()
        аминь "квадрат"
    конец
конец

образ Прямоугольник
    слово создать(ширина, высота)
        это.ширина = ширина
        это.высота = высота
    конец

    слово площадь()
        аминь это.ширина * это.высота
    конец

    слово название()
        аминь "прямоугольник"
    конец
конец

пусть фигуры = [Квадрат(3), Прямоугольник(2, 5)]

измени всего = 0
для ф в фигуры
    возгласи("{ф.название()}: {ф.площадь()}")
    всего = всего + ф.площадь()
конец
возгласи("Общая площадь: {всего}")

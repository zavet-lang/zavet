# Условия и циклы.

пусть возраст = 18

если возраст >= 18
    возгласи("Взрослый")
иначеесли возраст >= 14
    возгласи("Подросток")
иначе
    возгласи("Ребёнок")
конец

# Короткая запись через двоеточие
если возраст >= 18: возгласи("Можно голосовать")

# Цикл со счётчиком
для i от 1 до 5
    возгласи("Шаг {i}")
конец

# Цикл с шагом
для i от 0 до 10 по 2
    возгласи(i)
конец

# Цикл по массиву
пусть числа = [10, 20, 30]
для n в числа
    возгласи(n)
конец

# Цикл с условием
измени сумма = 0
измени k = 1
доколе k <= 100
    сумма += k
    k += 1
конец
возгласи("Сумма от 1 до 100: {сумма}")

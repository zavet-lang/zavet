# Пример 23. Telegram-бот на чистом Завете (http.получить / http.пост).
# Токен берётся строго из переменной окружения TELEGRAM_BOT_TOKEN.
# Без токена программа автоматически выполняет самопроверку и демо на тестовых обновлениях.

образ ТгБот
    слово создать(токен: строка)
        это.токен = токен
        это.база = "https://api.telegram.org/bot{токен}"
        это.смещение = 0
        это.обработано = 0
    конец

    слово урл(метод: строка) -> строка
        аминь "{это.база}/{метод}"
    конец

    # Вызов Telegram Bot API: GET (без тела) или POST JSON
    слово запрос_апи(метод: строка, тело = ничего)
        пусть адрес = это.урл(метод)
        измени ответ = ничего
        если тело == ничего
            ответ = http.получить(адрес)
        иначе
            ответ = http.пост(адрес, тело)
        конец
        пусть статус = ответ["статус"]
        пусть телоОтвета = ответ["тело"]
        если статус < 200 или статус >= 300
            бросить "HTTP {статус}: {телоОтвета}"
        конец
        пусть разобрано = json.разобрать(телоОтвета)
        если разобрано["ok"] != истина
            бросить "Telegram API ошибка: {телоОтвета}"
        конец
        аминь разобрано["result"]
    конец

    слово себя()
        аминь это.запрос_апи("getMe")
    конец

    слово обновления(таймаут = 20)
        пусть урлЗапроса = "getUpdates?offset={это.смещение}&limit=20&timeout={таймаут}"
        аминь это.запрос_апи(урлЗапроса)
    конец

    слово отправить(чатИд, текст: строка)
        пусть нагрузка = {
            "chat_id": чатИд,
            "text": текст,
        }
        аминь это.запрос_апи("sendMessage", нагрузка)
    конец

    слово сформировать_ответ(текст: строка, имяАвтора: строка) -> строка
        пусть очищено = обрезать(текст)
        если очищено == "/start" или начинается_с(очищено, "/start ")
            аминь "Привет, {имяАвтора}! Я бот на языке Завет.\nКоманды: /help, /echo <текст>, /stat"
        конец
        если очищено == "/help"
            аминь "Доступные команды:\n/start — приветствие\n/echo <текст> — повтор текста\n/stat — число обработанных сообщений"
        конец
        если очищено == "/stat"
            аминь "Обработано сообщений за сеанс: {это.обработано}"
        конец
        если очищено == "/echo"
            аминь "Использование: /echo ваш текст"
        конец
        если начинается_с(очищено, "/echo ")
            пусть арг = обрезать(подстрока(очищено, 6, длина(очищено)))
            если арг == ""
                аминь "Использование: /echo ваш текст"
            конец
            аминь арг
        конец
        аминь "Вы написали: {очищено}"
    конец

    # Обрабатывает одно обновление из getUpdates и возвращает описание ответа (или ничего)
    слово разобрать_обновление(обновление)
        если обновление == ничего: аминь ничего
        пусть апдИд = обновление["update_id"]
        если апдИд != ничего
            это.смещение = апдИд + 1
        конец
        пусть сообщение = обновление["message"]
        если сообщение == ничего: аминь ничего
        пусть текст = сообщение["text"]
        если текст == ничего: аминь ничего
        пусть чат = сообщение["chat"]
        если чат == ничего: аминь ничего

        измени имя = "гость"
        пусть автор = сообщение["from"]
        если автор != ничего
            пусть имяПоле = автор["first_name"]
            если имяПоле != ничего: имя = имяПоле
        конец

        это.обработано += 1
        пусть текстОтвета = это.сформировать_ответ(текст, имя)
        аминь {
            "chat_id": чат["id"],
            "text": текстОтвета,
        }
    конец
конец

слово цикл_поллинга(бот, максШагов = 0)
    пусть инфо = бот.себя()
    пусть имяБота = инфо["username"]
    возгласи("Бот @{имяБота} запущен. Ожидание сообщений...")
    измени шаг = 0
    доколе истина
        попытка
            пусть список = бот.обновления(5)
            для обн в список
                пусть ответ = бот.разобрать_обновление(обн)
                если ответ != ничего
                    бот.отправить(ответ["chat_id"], ответ["text"])
                конец
            конец
        поймать о
            возгласи("Ошибка опроса: {о}")
            время.спать(2000)
        конец
        шаг += 1
        если максШагов > 0 и шаг >= максШагов
            прерви
        конец
        время.спать(300)
    конец
конец

слово запустить_бота()
    пусть токен = ос.переменная("TELEGRAM_BOT_TOKEN")
    если токен != ничего
        пусть чистыйТокен = обрезать(токен)
        если чистыйТокен != ""
            пусть бот = ТгБот(чистыйТокен)
            пусть лимитСтр = ос.переменная("ZAVET_TG_MAX_POLLS")
            измени лимит = 0
            если лимитСтр != ничего
                пусть чЛимит = обрезать(лимитСтр)
                если чЛимит != ""
                    лимит = число(чЛимит)
                конец
            конец
            цикл_поллинга(бот, лимит)
            аминь истина
        конец
    конец

    возгласи("TELEGRAM_BOT_TOKEN не задан — запуск в демонстрационном режиме.")
    пусть демо = ТгБот("DEMO_TOKEN")
    пусть пробныйАпдейт = {
        "update_id": 100,
        "message": {
            "chat": {"id": 777},
            "from": {"first_name": "Алиса"},
            "text": "/echo Мир!",
        },
    }
    пусть реплика = демо.разобрать_обновление(пробныйАпдейт)
    пусть чатИд = реплика["chat_id"]
    пусть ответТекст = реплика["text"]
    возгласи("Демо-ответ для chat_id={чатИд}: {ответТекст}")
    аминь ложь
конец

тест "формирование URL Bot API"
    пусть б = ТгБот("123:ABC")
    проверить б.урл("getUpdates") == "https://api.telegram.org/bot123:ABC/getUpdates"
конец

тест "обработка команд и обновление offset"
    пусть б = ТгБот("123:ABC")
    пусть обн1 = {
        "update_id": 10,
        "message": {
            "chat": {"id": 42},
            "from": {"first_name": "Иван"},
            "text": "/start",
        },
    }
    пусть отв1 = б.разобрать_обновление(обн1)
    проверить отв1 != ничего
    проверить отв1["chat_id"] == 42
    проверить содержит(отв1["text"], "Привет, Иван!")
    проверить б.смещение == 11

    пусть обн2 = {
        "update_id": 11,
        "message": {
            "chat": {"id": 42},
            "text": "/echo тест Завета",
        },
    }
    пусть отв2 = б.разобрать_обновление(обн2)
    проверить отв2["text"] == "тест Завета"

    пусть обн3 = {
        "update_id": 12,
        "message": {"chat": {"id": 42}, "text": "/stat"},
    }
    пусть отв3 = б.разобрать_обновление(обн3)
    проверить содержит(отв3["text"], "3")
    проверить б.смещение == 13

    пусть обн4 = {
        "update_id": 13,
        "message": {"chat": {"id": 42}, "text": "/help"},
    }
    пусть отв4 = б.разобрать_обновление(обн4)
    проверить содержит(отв4["text"], "Доступные команды")

    пусть обн5 = {
        "update_id": 14,
        "message": {"chat": {"id": 42}, "text": "обычный текст"},
    }
    пусть отв5 = б.разобрать_обновление(обн5)
    проверить отв5["text"] == "Вы написали: обычный текст"
    проверить содержит(б.сформировать_ответ("/echo ", "Гость"), "Использование: /echo")
конец

тест "обновление без текста безопасно игнорируется"
    пусть б = ТгБот("123:ABC")
    пусть стикер = {"update_id": 55, "message": {"chat": {"id": 1}}}
    проверить б.разобрать_обновление(стикер) == ничего
    проверить б.смещение == 56
конец

запустить_бота()

# Перебор словаря в порядке вставки через ключи()/значения().

пусть возрасты = {
    "Аня": 25,
    "Борис": 31,
    "Вера": 40,
}

измени сумма = 0
для имя в ключи(возрасты)
    пусть возраст = возрасты[имя]
    возгласи("{имя}: {возраст}")
    сумма = сумма + возраст
конец
возгласи("Сумма: {сумма}")

пусть названия = {
    1: "один",
    2: "два",
}
возгласи("{ключи(названия)[1]} -> {значения(названия)[1]}")

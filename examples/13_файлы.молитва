# Создание папки, запись, переименование, чтение, удаление.

файлы.создать_дир("папка_тест")
файлы.записать("папка_тест/файл.txt", "привет")

пусть есть = файлы.существует("папка_тест/файл.txt")
возгласи("существует: {есть}")

файлы.переименовать("папка_тест/файл.txt", "папка_тест/другой.txt")
пусть текст = файлы.читать("папка_тест/другой.txt")
возгласи(текст)

файлы.удалить("папка_тест/другой.txt")
пусть ещё_есть = файлы.существует("папка_тест/другой.txt")
возгласи("удалён, существует: {ещё_есть}")

файлы.удалить_дир("папка_тест")
пусть папка_есть = файлы.существует("папка_тест")
возгласи("папка удалена: {не папка_есть}")


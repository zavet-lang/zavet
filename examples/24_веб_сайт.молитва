# Пример 24. Веб-приложение (HTML-шаблоны + JSON API) на модуле «веб».
# По умолчанию проверяет все маршруты через прил.обработать().
# Для запуска реального HTTP-сервера: zavet examples/24_веб_сайт.молитва --сервер

пусть ХТМЛ_ШАБЛОН = '<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>{{заголовок}}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 680px; margin: 2rem auto; padding: 0 1rem; }
    article { border: 1px solid #ddd; border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 0.75rem; }
  </style>
</head>
<body>
  <h1>{{заголовок}}</h1>
  <p>Всего заметок: {{всего}}</p>
  {{если пусто}}
    <p>Пока заметок нет.</p>
  {{иначе}}
    {{для з в заметки}}
      <article>
        <h3>{{з.заголовок}}</h3>
        <p>{{з.текст}}</p>
      </article>
    {{конец}}
  {{конец}}
</body>
</html>'

слово создать_приложение()
    пусть app = веб.приложение()
    app.использовать(веб.cors("*"))

    измени заметки = [
        {"id": 1, "заголовок": "Старт", "текст": "Первая заметка на языке Завет"},
        {"id": 2, "заголовок": "План", "текст": "HTML-шаблоны и JSON API в одном файле"},
    ]
    измени следИд = 3

    слово отрендерить_главную() -> строка
        пусть безопасные = []
        для з в заметки
            добавить(безопасные, {
                "id": з["id"],
                "заголовок": шаблон.экранировать(з["заголовок"]),
                "текст": шаблон.экранировать(з["текст"]),
            })
        конец
        пусть html = шаблон.рендер(ХТМЛ_ШАБЛОН, {
            "заголовок": "Доска заметок — Завет",
            "всего": длина(безопасные),
            "пусто": длина(безопасные) == 0,
            "заметки": безопасные,
        })
        аминь html
    конец

    app.получить("/", слово(запрос)
        аминь веб.html(отрендерить_главную())
    конец)

    app.получить("/health", слово(запрос)
        аминь веб.json({"статус": "ok", "заметок": длина(заметки)})
    конец)

    пусть api = app.группа("/api")

    api.получить("/заметки", слово(запрос)
        аминь веб.json({"заметки": заметки, "всего": длина(заметки)})
    конец)

    api.получить("/заметки/:id", слово(запрос)
        пусть идСтр = запрос.парам("id")
        для з в заметки
            если строка(з["id"]) == идСтр
                аминь веб.json(з)
            конец
        конец
        аминь веб.ошибка(404, "Заметка #{идСтр} не найдена")
    конец)

    api.пост("/заметки", слово(запрос)
        пусть тело = запрос.json
        если тело == ничего
            аминь веб.ошибка(400, "Ожидался корректный JSON")
        конец
        пусть заг = тело["заголовок"]
        пусть ткст = тело["текст"]
        если заг == ничего или ткст == ничего
            аминь веб.ошибка(400, "Поля «заголовок» и «текст» обязательны")
        конец
        если обрезать(строка(заг)) == "" или обрезать(строка(ткст)) == ""
            аминь веб.ошибка(400, "Заголовок и текст не должны быть пустыми")
        конец
        пусть новая = {
            "id": следИд,
            "заголовок": обрезать(строка(заг)),
            "текст": обрезать(строка(ткст)),
        }
        следИд += 1
        добавить(заметки, новая)
        аминь веб.json(новая, 201)
    конец)

    app.при_ошибке(слово(ош, запрос)
        аминь веб.ошибка(500, "Внутренняя ошибка сервера: {ош}")
    конец)

    аминь app
конец

тест "главная страница рендерит HTML-шаблон и экранирует заметки"
    пусть app = создать_приложение()
    пусть r = app.обработать("GET", "/")
    проверить r["статус"] == 200
    проверить содержит(r["заголовки"]["Content-Type"], "text/html")
    проверить содержит(r["тело"], "Доска заметок")
    проверить содержит(r["тело"], "Первая заметка на языке Завет")
конец

тест "JSON API: список, получение по id, добавление и 404/400"
    пусть app = создать_приложение()

    пусть rHealth = app.обработать("GET", "/health")
    проверить rHealth["статус"] == 200
    пусть h = json.разобрать(rHealth["тело"])
    проверить h["статус"] == "ok"
    проверить h["заметок"] == 2

    пусть rPost = app.обработать("POST", "/api/заметки", '{"заголовок":"Релиз","текст":"Добавлен <script>тег</script>"}')
    проверить rPost["статус"] == 201
    пусть создан = json.разобрать(rPost["тело"])
    проверить создан["id"] == 3

    пусть rGet = app.обработать("GET", "/api/заметки/3")
    проверить rGet["статус"] == 200
    пусть один = json.разобрать(rGet["тело"])
    проверить один["заголовок"] == "Релиз"

    # Проверка XSS-экранирования на HTML-странице после POST
    пусть rHome = app.обработать("GET", "/")
    проверить содержит(rHome["тело"], "&lt;script&gt;")

    пусть rBad = app.обработать("POST", "/api/заметки", '{"заголовок":""}')
    проверить rBad["статус"] == 400

    пусть rMissing = app.обработать("GET", "/api/заметки/999")
    проверить rMissing["статус"] == 404
конец

пусть арги = ос.аргументы()
измени нуженСервер = ложь
для а в арги
    если а == "--сервер"
        нуженСервер = истина
    конец
конец

если нуженСервер
    пусть прил = создать_приложение()
    пусть портСтр = ос.переменная("PORT")
    измени порт = 8080
    если портСтр != ничего и обрезать(портСтр) != ""
        порт = число(обрезать(портСтр))
    конец
    возгласи("Сервер запущен на http://127.0.0.1:{порт}/")
    прил.запустить(порт)
иначе
    пусть прил = создать_приложение()
    пусть отв = прил.обработать("GET", "/health")
    пусть ст = отв["статус"]
    пусть тл = отв["тело"]
    возгласи("Проверка маршрута /health -> статус {ст}, тело: {тл}")
конец

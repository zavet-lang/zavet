# Массивы и словари.

пусть числа = [1, 2, 3, 4, 5]
возгласи("Длина: {длина(числа)}")
возгласи("Первый: {числа[0]}, последний: {числа[-1]}")

# Срезы
возгласи(числа[1:4])
возгласи(числа[:3])
возгласи(числа[2:])

# Функции высшего порядка
пусть чётные = фильтр(числа, x => x % 2 == 0)
возгласи(чётные)

пусть квадраты = преобразовать(числа, x => x * x)
возгласи(квадраты)

возгласи(сумма(числа))

# Словари
пусть человек = {
    "имя": "Иван",
    "возраст": 30,
    "город": "Казань",
}

возгласи(человек["имя"])
возгласи(ключи(человек))
возгласи(значения(человек))

# Вложенные структуры
пусть команда = {
    "название": "Альфа",
    "участники": [
        {"имя": "Аня", "возраст": 22},
        {"имя": "Боря", "возраст": 25},
    ],
}

для участник в команда["участники"]
    возгласи("{участник["имя"]}: {участник["возраст"]}")
конец

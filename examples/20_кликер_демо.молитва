# Кликер без ввода: клики, улучшение, сохранение и загрузка.

пусть путь = "кликер_сохранение.txt"

слово сохранить_игру(очки, за_клик)
    файлы.записать(путь, json.создать({"очки": очки, "за_клик": за_клик}))
конец

слово загрузить_игру()
    если не файлы.существует(путь)
        аминь {"очки": 0, "за_клик": 1}
    конец
    аминь json.разобрать(файлы.читать(путь))
конец

пусть с = загрузить_игру()
измени очки = с["очки"]
измени за_клик = с["за_клик"]

для i от 1 до 3
    очки = очки + за_клик
конец
возгласи("После кликов: {очки} (по {за_клик} за клик)")

если очки >= 2
    очки = очки - 2
    за_клик = за_клик + 1
    возгласи("Куплено улучшение. Теперь {за_клик} за клик, очки: {очки}")
конец

сохранить_игру(очки, за_клик)
пусть снова = загрузить_игру()
пусть о2 = снова["очки"]
пусть з2 = снова["за_клик"]
возгласи("Из файла: очки={о2}, за_клик={з2}")

файлы.удалить(путь)

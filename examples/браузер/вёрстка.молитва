# LibWeb layout → paint list + hit-test (упрощённый BFC).

открой слово сверстать(блоки, шир, сим_w, строка_h)
    измени y = 8
    измени out = []
    измени links = []
    пусть x0 = 16
    для б в блоки
        если б["вид"] == "br"
            y = y + строка_h / 2
        иначеесли б["вид"] == "hr"
            добавить(out, {"вид": "hr", "x": x0, "y": y, "w": шир - 32, "h": 2})
            y = y + 12
        иначеесли б["вид"] == "img"
            добавить(out, {"вид": "img", "x": x0, "y": y, "w": 220, "h": 48, "текст": б["текст"]})
            если б["href"] != ""
                добавить(links, {"x": x0, "y": y, "w": 220, "h": 48, "href": б["href"]})
            конец
            y = y + 56
        иначе
            пусть цвет = б["цвет"]
            пусть h = строка_h
            если цвет == "заголовок"
                h = 24
            конец
            добавить(out, {
                "вид": "текст",
                "x": x0,
                "y": y,
                "текст": б["текст"],
                "цвет": цвет,
                "h": h,
            })
            если б["href"] != "" и б["href"] != ничего
                пусть tw = длина(б["текст"]) * сим_w
                добавить(links, {"x": x0, "y": y, "w": tw, "h": h, "href": б["href"]})
            конец
            y = y + h
        конец
    конец
    аминь {"элементы": out, "ссылки": links, "высота": y + 16}
конец

открой слово цвет_текста(имя)
    если имя == "ссылка"
        аминь [26, 115, 232]
    иначеесли имя == "заголовок"
        аминь [32, 33, 36]
    конец
    аминь [60, 64, 67]
конец

открой слово ссылка_в(ссылки, mx, my, scroll, контент_y)
    для л в ссылки
        пусть ly = контент_y + л["y"] - scroll
        если mx >= л["x"] и mx < л["x"] + л["w"] и my >= ly и my < ly + л["h"]
            аминь л["href"]
        конец
    конец
    аминь ""
конец

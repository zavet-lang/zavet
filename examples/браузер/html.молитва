# LibWeb — HTML tokenization/parse → блоки (упрощённо).
# См. Ladybird Documentation/LibWebFromLoadingToPainting.md

приими стр из "./строки.молитва"
приими url из "./url.молитва"

слово атрибут(тег, имя)
    измени ключ = имя + "=\""
    измени p = стр.найти_с(нижний(тег), ключ, 0)
    если p < 0
        ключ = имя + "='"
        p = стр.найти_с(нижний(тег), ключ, 0)
        если p < 0
            аминь ""
        конец
        пусть q = стр.найти_с(тег, "'", p + длина(ключ))
        если q < 0
            аминь ""
        конец
        аминь стр.вырезать(тег, p + длина(ключ), q)
    конец
    пусть q = стр.найти_с(тег, "\"", p + длина(ключ))
    если q < 0
        аминь ""
    конец
    аминь стр.вырезать(тег, p + длина(ключ), q)
конец

слово имя_тега(тег)
    измени s = обрезать(тег)
    если начинается_с(s, "</")
        s = стр.вырезать(s, 2, длина(s))
    иначеесли начинается_с(s, "<")
        s = стр.вырезать(s, 1, длина(s))
    конец
    измени i = 0
    доколе i < длина(s)
        пусть c = подстрока(s, i, i + 1)
        если c == " " или c == ">" или c == "/" или c == "\n" или c == "\t"
            аминь нижний(стр.вырезать(s, 0, i))
        конец
        i = i + 1
    конец
    аминь нижний(s)
конец

слово обрезать_html(html)
    пусть лимит = 120000
    если длина(html) > лимит
        аминь стр.вырезать(html, 0, лимит) + "<!-- обрезано -->"
    конец
    аминь html
конец

# разобрать(html, база, шир_сим) → {title, блоки}
открой слово разобрать(html, база, шир_сим)
    html = обрезать_html(html)

    # title до вырезания <head> (иначе теряется)
    измени title = "Без названия"
    пусть low0 = нижний(html)
    пусть tp = стр.найти_с(low0, "<title", 0)
    если tp >= 0
        пусть ts = стр.найти_с(html, ">", tp)
        пусть te = стр.найти_с(low0, "</title>", ts)
        если ts >= 0 и te > ts
            title = стр.сущности(стр.вырезать(html, ts + 1, te))
        конец
    конец

    html = регвыр.заменить(html, "(?is)<script[^>]*>.*?</script>", "")
    html = регвыр.заменить(html, "(?is)<style[^>]*>.*?</style>", "")
    html = регвыр.заменить(html, "(?is)<!--.*?-->", "")
    html = регвыр.заменить(html, "(?is)<head[^>]*>.*?</head>", "")

    измени блоки = []
    измени i = 0
    измени href = ""
    измени в_а = ложь
    измени буфер = ""
    пусть n = длина(html)

    слово сброс_текста(размер, цвет)
        пусть txt = стр.сущности(буфер)
        буфер = ""
        если txt == ""
            аминь ничего
        конец
        пусть строки = стр.перенос(txt, шир_сим)
        для ст в строки
            добавить(блоки, {
                "вид": "текст",
                "текст": ст,
                "размер": размер,
                "цвет": цвет,
                "href": href,
            })
        конец
    конец

    доколе i < n
        если подстрока(html, i, i + 1) == "<"
            сброс_текста(1, "текст")
            пусть gt = стр.найти_с(html, ">", i)
            если gt < 0
                прерви
            конец
            пусть тег = стр.вырезать(html, i, gt + 1)
            пусть nm = имя_тега(тег)
            пусть закрыт = начинается_с(обрезать(тег), "</")

            если nm == "br"
                добавить(блоки, {"вид": "br"})
            иначеесли nm == "hr"
                добавить(блоки, {"вид": "hr"})
            иначеесли nm == "li" и не закрыт
                буфер = буфер + "• "
            иначеесли nm == "p" или nm == "div" или nm == "tr" или nm == "section" или nm == "article"
                если закрыт
                    добавить(блоки, {"вид": "br"})
                конец
            иначеесли nm == "h1" или nm == "h2" или nm == "h3"
                добавить(блоки, {"вид": "br"})
            иначеесли nm == "a"
                если закрыт
                    сброс_текста(1, "ссылка")
                    в_а = ложь
                    href = ""
                иначе
                    в_а = истина
                    href = url.резолв(база, атрибут(тег, "href"))
                конец
            иначеесли nm == "img"
                измени alt = атрибут(тег, "alt")
                если alt == ""
                    alt = "[изображение]"
                конец
                пусть src = url.резолв(база, атрибут(тег, "src"))
                добавить(блоки, {"вид": "img", "текст": alt, "href": src})
            конец
            i = gt + 1
        иначе
            буфер = буфер + подстрока(html, i, i + 1)
            i = i + 1
        конец
    конец
    сброс_текста(1, "текст")
    аминь {"title": title, "блоки": блоки}
конец

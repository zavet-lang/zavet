# UI process — вкладки, тулбар, омнибокс, закладки (Font Awesome).

приими стр из "./строки.молитва"
приими вёрстка из "./вёрстка.молитва"

слово плитка(x, y, w, h, r, g, b)
    окно.прямоугольник(x, y, w, h, r, g, b)
    окно.прямоугольник(x, y, w, 1, мин(255, r + 18), мин(255, g + 18), мин(255, b + 18))
конец

слово кнопка_иконка(x, y, имя, разм)
    плитка(x, y, разм, разм, 255, 255, 255)
    окно.иконка(x + 8, y + 7, имя, 95, 99, 104)
конец

открой слово нарисовать(s, метр)
    пусть ШИР = метр["шир"]
    пусть ВЫС = метр["выс"]
    пусть ВКЛАДКИ_H = метр["вкладки_h"]
    пусть ПАНЕЛЬ_H = метр["панель_h"]
    пусть ЗАКЛАДКИ_H = метр["закладки_h"]
    пусть КОНТЕНТ_Y = метр["контент_y"]
    пусть КОНТЕНТ_H = метр["контент_h"]
    пусть СТАТУС_H = метр["статус_h"]
    пусть СИМ_W = метр["сим_w"]
    пусть ШИР_ВКЛАДКИ = метр["шир_вкладки"]
    пусть КН_Y = метр["кн_y"]
    пусть КН_РАЗМ = метр["кн_разм"]
    пусть ОМНИ_X = метр["омни_x"]
    пусть ОМНИ_Y = метр["омни_y"]
    пусть ОМНИ_H = метр["омни_h"]

    # вкладки
    окно.прямоугольник(0, 0, ШИР, ВКЛАДКИ_H, 222, 225, 230)
    измени i = 0
    доколе i < длина(s["вкладки"])
        пусть x = 8 + i * (ШИР_ВКЛАДКИ + 4)
        пусть заг = стр.обрезать_строку(s["вкладки"][i]["title"], 18)
        если i == s["акт"]
            окно.прямоугольник(x, 6, ШИР_ВКЛАДКИ, ВКЛАДКИ_H - 6, 255, 255, 255)
            окно.прямоугольник(x, 6, 3, ВКЛАДКИ_H - 6, 26, 115, 232)
            окно.иконка(x + 12, 12, "globe", 26, 115, 232)
            окно.текст(x + 34, 14, заг, 32, 33, 36)
        иначе
            плитка(x, 10, ШИР_ВКЛАДКИ, ВКЛАДКИ_H - 12, 198, 202, 208)
            окно.иконка(x + 12, 14, "globe", 154, 160, 166)
            окно.текст(x + 34, 16, заг, 95, 99, 104)
        конец
        i = i + 1
    конец
    пусть px = 8 + длина(s["вкладки"]) * (ШИР_ВКЛАДКИ + 4) + 6
    плитка(px, 10, 28, 24, 241, 243, 244)
    окно.иконка(px + 7, 12, "plus", 95, 99, 104)

    # тулбар
    окно.прямоугольник(0, ВКЛАДКИ_H, ШИР, ПАНЕЛЬ_H, 255, 255, 255)
    окно.прямоугольник(0, ВКЛАДКИ_H + ПАНЕЛЬ_H - 1, ШИР, 1, 218, 220, 224)
    кнопка_иконка(12, КН_Y, "arrow-left", КН_РАЗМ)
    кнопка_иконка(48, КН_Y, "arrow-right", КН_РАЗМ)
    кнопка_иконка(84, КН_Y, "arrows-rotate", КН_РАЗМ)

    пусть aw = ШИР - ОМНИ_X - 56
    если s["фокус_адреса"]
        окно.прямоугольник(ОМНИ_X - 2, ОМНИ_Y - 2, aw + 4, ОМНИ_H + 4, 26, 115, 232)
        окно.прямоугольник(ОМНИ_X, ОМНИ_Y, aw, ОМНИ_H, 255, 255, 255)
        окно.текст(ОМНИ_X + 14, ОМНИ_Y + 7, стр.обрезать_строку(s["адрес_черновик"] + "|", aw / СИМ_W - 4), 32, 33, 36)
    иначе
        плитка(ОМНИ_X, ОМНИ_Y, aw, ОМНИ_H, 241, 243, 244)
        окно.иконка(ОМНИ_X + 10, ОМНИ_Y + 7, "lock", 154, 160, 166)
        окно.текст(ОМНИ_X + 32, ОМНИ_Y + 7, стр.обрезать_строку(s["адрес"], aw / СИМ_W - 6), 60, 64, 67)
    конец
    окно.прямоугольник(ШИР - 40, КН_Y + 2, 28, 28, 26, 115, 232)
    окно.иконка(ШИР - 32, КН_Y + 8, "user", 255, 255, 255)

    # закладки
    пусть by = ВКЛАДКИ_H + ПАНЕЛЬ_H
    окно.прямоугольник(0, by, ШИР, ЗАКЛАДКИ_H, 255, 255, 255)
    окно.прямоугольник(0, by + ЗАКЛАДКИ_H - 1, ШИР, 1, 232, 234, 237)
    измени bx = 12
    для з в s["закладки"]
        пусть tw = длина(з[0]) * СИМ_W + 36
        плитка(bx, by + 6, tw, 22, 241, 243, 244)
        окно.иконка(bx + 6, by + 8, з[2], 95, 99, 104)
        окно.текст(bx + 24, by + 9, з[0], 60, 64, 67)
        bx = bx + tw + 8
    конец

    # контент
    окно.прямоугольник(0, КОНТЕНТ_Y, ШИР, КОНТЕНТ_H, 255, 255, 255)
    пусть вкл = s["вкладки"][s["акт"]]
    пусть sc = вкл["scroll"]
    для э в вкл["элементы"]
        пусть dy = э["y"] - sc
        если dy + 30 < 0 или dy > КОНТЕНТ_H
            продолжи
        конец
        пусть sy = КОНТЕНТ_Y + dy
        если э["вид"] == "hr"
            окно.прямоугольник(э["x"], sy, э["w"], 1, 218, 220, 224)
        иначеесли э["вид"] == "img"
            окно.прямоугольник(э["x"], sy, э["w"], э["h"], 241, 243, 244)
            окно.иконка(э["x"] + 8, sy + 16, "image", 154, 160, 166)
            окно.текст(э["x"] + 32, sy + 16, стр.обрезать_строку(э["текст"], 28), 95, 99, 104)
        иначе
            пусть rgb = вёрстка.цвет_текста(э["цвет"])
            окно.текст(э["x"], sy, э["текст"], rgb[0], rgb[1], rgb[2])
        конец
    конец

    # статус
    окно.прямоугольник(0, ВЫС - СТАТУС_H, ШИР, СТАТУС_H, 241, 243, 244)
    измени msg = s["status_flash"]
    если msg == ""
        msg = вкл["сообщение"]
    конец
    окно.текст(12, ВЫС - СТАТУС_H + 5, стр.обрезать_строку(msg, 110), 95, 99, 104)
конец

открой слово в_прямоугольнике(mx, my, x, y, w, h)
    аминь mx >= x и mx < x + w и my >= y и my < y + h
конец

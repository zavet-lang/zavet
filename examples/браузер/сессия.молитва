# Hub — вкладки, история, адресная строка (состояние сессии).

приими html из "./html.молитва"
приими вёрстка из "./вёрстка.молитва"

открой слово новая_вкладка(url)
    аминь {
        "url": url,
        "title": "Новая",
        "история": [url],
        "ист_i": 0,
        "html": "",
        "элементы": [],
        "ссылки": [],
        "высота": 0,
        "scroll": 0,
        "статус": 0,
        "сообщение": "Готово",
        "загрузка": ложь,
    }
конец

открой слово создать(домашний)
    аминь {
        "вкладки": [новая_вкладка(домашний)],
        "акт": 0,
        "адрес": домашний,
        "фокус_адреса": ложь,
        "адрес_черновик": домашний,
        "status_flash": "",
        "макс_вкладок": 5,
        "закладки": [
            ["Дом", "about:home", "house"],
            ["Example", "about:example", "globe"],
            ["Wiki", "https://www.wikipedia.org", "book"],
            ["HN", "https://news.ycombinator.com", "newspaper"],
            ["CERN", "https://info.cern.ch", "atom"],
        ],
    }
конец

открой слово вкладка(s)
    аминь s["вкладки"][s["акт"]]
конец

слово записать_историю(вкл, url)
    пусть ист = []
    измени j = 0
    доколе j <= вкл["ист_i"]
        добавить(ист, вкл["история"][j])
        j = j + 1
    конец
    добавить(ист, url)
    вкл["история"] = ист
    вкл["ист_i"] = длина(ист) - 1
конец

# шир / сим_w / строка_h — параметры layout (viewport)
открой слово применить_документ(s, url, raw_html, код, сообщ, в_историю, шир, сим_w, строка_h)
    пусть вкл = вкладка(s)
    если в_историю
        записать_историю(вкл, url)
    конец
    пусть док = html.разобрать(raw_html, url, (шир - 32) / сим_w)
    пусть lay = вёрстка.сверстать(док["блоки"], шир, сим_w, строка_h)
    вкл["url"] = url
    вкл["title"] = док["title"]
    вкл["html"] = raw_html
    вкл["элементы"] = lay["элементы"]
    вкл["ссылки"] = lay["ссылки"]
    вкл["высота"] = lay["высота"]
    вкл["scroll"] = 0
    вкл["статус"] = код
    вкл["сообщение"] = сообщ
    вкл["загрузка"] = ложь
    s["адрес"] = url
    s["адрес_черновик"] = url
    s["status_flash"] = сообщ
    # заголовок окна выставляет UI (приложение), не Hub
конец

открой слово добавить_вкладку(s, url)
    если длина(s["вкладки"]) >= s["макс_вкладок"]
        s["status_flash"] = "Максимум вкладок"
        аминь ложь
    конец
    добавить(s["вкладки"], новая_вкладка(url))
    s["акт"] = длина(s["вкладки"]) - 1
    аминь истина
конец

открой слово закрыть_вкладку(s)
    если длина(s["вкладки"]) <= 1
        аминь "закрыть_окно"
    конец
    пусть нов = []
    измени i = 0
    доколе i < длина(s["вкладки"])
        если i != s["акт"]
            добавить(нов, s["вкладки"][i])
        конец
        i = i + 1
    конец
    s["вкладки"] = нов
    если s["акт"] >= длина(нов)
        s["акт"] = длина(нов) - 1
    конец
    пусть вкл = вкладка(s)
    s["адрес"] = вкл["url"]
    s["адрес_черновик"] = вкл["url"]
    аминь "ок"
конец

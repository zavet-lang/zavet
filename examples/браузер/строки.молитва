# Вспомогательные строки (общие для LibWeb / UI).

открой слово найти_с(s, иголка, с)
    пусть n = длина(иголка)
    пусть lim = длина(s) - n
    доколе с <= lim
        если подстрока(s, с, с + n) == иголка
            аминь с
        конец
        с = с + 1
    конец
    аминь -1
конец

открой слово вырезать(s, a, b)
    измени нач = a
    измени кон = b
    если нач < 0
        нач = 0
    конец
    если кон > длина(s)
        кон = длина(s)
    конец
    если нач >= кон
        аминь ""
    конец
    аминь подстрока(s, нач, кон)
конец

открой слово сущности(t)
    измени s = t
    s = заменить(s, "&nbsp;", " ")
    s = заменить(s, "&amp;", "&")
    s = заменить(s, "&lt;", "<")
    s = заменить(s, "&gt;", ">")
    s = заменить(s, "&quot;", "\"")
    s = заменить(s, "&#39;", "'")
    s = регвыр.заменить(s, "&#([0-9]+);", "")
    s = регвыр.заменить(s, "\\s+", " ")
    аминь обрезать(s)
конец

открой слово обрезать_строку(t, макс)
    если длина(t) <= макс
        аминь t
    конец
    аминь вырезать(t, 0, макс - 1) + "…"
конец

открой слово перенос(текст, шир_сим)
    пусть строки = []
    текст = сущности(текст)
    если текст == ""
        аминь строки
    конец
    пусть слова = разделить(текст, " ")
    измени строка = ""
    для сл в слова
        если сл == ""
            продолжи
        конец
        если строка == ""
            строка = сл
        иначеесли длина(строка) + 1 + длина(сл) <= шир_сим
            строка = строка + " " + сл
        иначе
            добавить(строки, строка)
            строка = сл
        конец
    конец
    если строка != ""
        добавить(строки, строка)
    конец
    аминь строки
конец

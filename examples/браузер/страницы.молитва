# Встроенные документы about: (офлайн).

открой слово дом()
    аминь """
<html><head><title>Дом — Завет</title></head><body>
<h1>Браузер Завета</h1>
<p>Модульный GUI-браузер по схеме Ladybird: UI, Hub, RequestServer, LibWeb, композитор.</p>
<hr>
<h2>Закладки</h2>
<ul>
<li><a href="about:example">example.com (офлайн)</a></li>
<li><a href="https://example.com">example.com (сеть)</a></li>
<li><a href="https://www.wikipedia.org">wikipedia.org</a></li>
<li><a href="https://news.ycombinator.com">Hacker News</a></li>
<li><a href="https://info.cern.ch">Первый сайт (CERN)</a></li>
<li><a href="about:blank">about:blank</a></li>
</ul>
<h2>Клавиши</h2>
<p>Ctrl+L · Enter · F5 · Esc · стрелки / колесо · Ctrl+T</p>
<p><b>Без JS и CSS.</b> Картинки — рамка с alt. Иконки — Font Awesome Solid.</p>
</body></html>
"""
конец

открой слово пустая()
    аминь "<html><head><title>Пусто</title></head><body><h1>about:blank</h1><p>Пустая вкладка.</p><p><a href=\"about:home\">На дом</a></p></body></html>"
конец

открой слово пример()
    аминь """
<html><head><title>Example Domain</title></head><body>
<h1>Example Domain</h1>
<p>This domain is for use in illustrative examples in documents.</p>
<p><a href="https://www.iana.org/domains/example">More information...</a></p>
<p><a href="about:home">На дом</a></p>
</body></html>
"""
конец

открой слово ошибка(url, сообщ)
    аминь "<html><head><title>Ошибка</title></head><body><h1>Не удалось открыть</h1><p>" + url + "</p><p>" + сообщ + "</p><p><a href=\"about:home\">На дом</a></p></body></html>"
конец

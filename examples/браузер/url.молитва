# LibURL — разбор и резолв ссылок (как Ladybird LibURL).

приими стр из "./строки.молитва"

открой слово база_url(url)
    пусть p = стр.найти_с(url, "://", 0)
    если p < 0
        аминь url
    конец
    измени last = -1
    измени i = 0
    доколе i < длина(url)
        если подстрока(url, i, i + 1) == "/"
            last = i
        конец
        i = i + 1
    конец
    если last < p + 3
        аминь url + "/"
    конец
    аминь стр.вырезать(url, 0, last + 1)
конец

открой слово корень_url(url)
    пусть p = стр.найти_с(url, "://", 0)
    если p < 0
        аминь url
    конец
    пусть rest = стр.вырезать(url, p + 3, длина(url))
    пусть slash = стр.найти_с(rest, "/", 0)
    если slash < 0
        аминь url
    конец
    аминь стр.вырезать(url, 0, p + 3 + slash)
конец

открой слово резолв(база, href)
    href = обрезать(href)
    если href == "" или начинается_с(href, "#") или начинается_с(href, "javascript:")
        аминь ""
    конец
    если начинается_с(href, "http://") или начинается_с(href, "https://") или начинается_с(href, "about:")
        аминь href
    конец
    если начинается_с(href, "//")
        если начинается_с(база, "https")
            аминь "https:" + href
        конец
        аминь "http:" + href
    конец
    если начинается_с(href, "/")
        аминь корень_url(база) + стр.вырезать(href, 1, длина(href))
    конец
    аминь база_url(база) + href
конец

открой слово нормализовать(url)
    url = обрезать(url)
    если url == ""
        аминь ""
    конец
    если начинается_с(url, "http://") или начинается_с(url, "https://") или начинается_с(url, "about:")
        аминь url
    конец
    если содержит(url, ".")
        аминь "https://" + url
    конец
    аминь "https://duckduckgo.com/?q=" + url
конец

# Compositor + UI event loop (процесс «UI» в схеме Ladybird).

приими сессия из "./сессия.молитва"
приими сеть из "./сеть.молитва"
приими хром из "./хром.молитва"
приими вёрстка из "./вёрстка.молитва"

слово метрика(шир, выс)
    пусть вкладки_h = 38
    пусть панель_h = 52
    пусть закладки_h = 34
    пусть статус_h = 24
    пусть контент_y = вкладки_h + панель_h + закладки_h
    аминь {
        "шир": шир,
        "выс": выс,
        "вкладки_h": вкладки_h,
        "панель_h": панель_h,
        "закладки_h": закладки_h,
        "статус_h": статус_h,
        "контент_y": контент_y,
        "контент_h": выс - контент_y - статус_h,
        "сим_w": 8,
        "строка_h": 20,
        "шир_вкладки": 200,
        "кн_y": вкладки_h + 10,
        "кн_разм": 32,
        "омни_x": 128,
        "омни_y": вкладки_h + 10,
        "омни_h": 32,
    }
конец

слово перейти(s, net, raw, в_историю, м)
    пусть вкл = сессия.вкладка(s)
    вкл["загрузка"] = истина
    вкл["сообщение"] = "Загрузка…"
    s["status_flash"] = "Загрузка…"
    пусть r = сеть.начать(net, raw, в_историю)
    если r["занято"]
        s["status_flash"] = "Уже загружается…"
        аминь ничего
    конец
    если r["пусто"]
        аминь ничего
    конец
    если r["сейчас"]
        сессия.применить_документ(s, r["url"], r["html"], r["код"], r["сообщ"], r["в_историю"], м["шир"], м["сим_w"], м["строка_h"])
    иначе
        s["status_flash"] = "Загрузка " + r["url"]
    конец
конец

слово проверить_сеть(s, net, м)
    пусть док = сеть.опрос(net)
    если док == ничего
        аминь ничего
    конец
    сессия.применить_документ(s, док["url"], док["html"], док["код"], док["сообщ"], док["в_историю"], м["шир"], м["сим_w"], м["строка_h"])
конец

слово назад(s, net, м)
    пусть вкл = сессия.вкладка(s)
    если вкл["ист_i"] > 0
        вкл["ист_i"] = вкл["ист_i"] - 1
        перейти(s, net, вкл["история"][вкл["ист_i"]], ложь, м)
    конец
конец

слово вперёд(s, net, м)
    пусть вкл = сессия.вкладка(s)
    если вкл["ист_i"] < длина(вкл["история"]) - 1
        вкл["ист_i"] = вкл["ист_i"] + 1
        перейти(s, net, вкл["история"][вкл["ист_i"]], ложь, м)
    конец
конец

слово клик_хрома(s, net, м, mx, my)
    пусть КН_Y = м["кн_y"]
    пусть КН_РАЗМ = м["кн_разм"]
    пусть ВКЛАДКИ_H = м["вкладки_h"]
    пусть ПАНЕЛЬ_H = м["панель_h"]
    пусть ЗАКЛАДКИ_H = м["закладки_h"]
    пусть ШИР_ВКЛАДКИ = м["шир_вкладки"]
    пусть ОМНИ_X = м["омни_x"]
    пусть ОМНИ_Y = м["омни_y"]
    пусть ОМНИ_H = м["омни_h"]
    пусть ШИР = м["шир"]

    если my < ВКЛАДКИ_H
        измени i = 0
        доколе i < длина(s["вкладки"])
            пусть x = 8 + i * (ШИР_ВКЛАДКИ + 4)
            если хром.в_прямоугольнике(mx, my, x, 6, ШИР_ВКЛАДКИ, ВКЛАДКИ_H - 6)
                s["акт"] = i
                пусть вкл = сессия.вкладка(s)
                s["адрес"] = вкл["url"]
                s["адрес_черновик"] = вкл["url"]
                аминь истина
            конец
            i = i + 1
        конец
        пусть px = 8 + длина(s["вкладки"]) * (ШИР_ВКЛАДКИ + 4) + 6
        если хром.в_прямоугольнике(mx, my, px, 10, 28, 24)
            если сессия.добавить_вкладку(s, "about:home")
                перейти(s, net, "about:home", истина, м)
            конец
            аминь истина
        конец
        аминь ложь
    конец

    если хром.в_прямоугольнике(mx, my, 12, КН_Y, КН_РАЗМ, КН_РАЗМ)
        назад(s, net, м)
        аминь истина
    конец
    если хром.в_прямоугольнике(mx, my, 48, КН_Y, КН_РАЗМ, КН_РАЗМ)
        вперёд(s, net, м)
        аминь истина
    конец
    если хром.в_прямоугольнике(mx, my, 84, КН_Y, КН_РАЗМ, КН_РАЗМ)
        перейти(s, net, сессия.вкладка(s)["url"], ложь, м)
        аминь истина
    конец

    пусть aw = ШИР - ОМНИ_X - 56
    если хром.в_прямоугольнике(mx, my, ОМНИ_X, ОМНИ_Y, aw, ОМНИ_H)
        s["фокус_адреса"] = истина
        s["адрес_черновик"] = s["адрес"]
        аминь истина
    конец

    пусть by = ВКЛАДКИ_H + ПАНЕЛЬ_H
    если my >= by и my < by + ЗАКЛАДКИ_H
        измени bx = 12
        для з в s["закладки"]
            пусть tw = длина(з[0]) * м["сим_w"] + 36
            если хром.в_прямоугольнике(mx, my, bx, by + 6, tw, 22)
                s["фокус_адреса"] = ложь
                перейти(s, net, з[1], истина, м)
                аминь истина
            конец
            bx = bx + tw + 8
        конец
    конец
    аминь ложь
конец

слово обработка_ввода(s, net, м, prev)
    пусть mx = окно.мышь_x()
    пусть my = окно.мышь_y()

    если s["фокус_адреса"]
        пусть sym = окно.символ()
        измени i = 0
        доколе i < длина(sym)
            пусть c = подстрока(sym, i, i + 1)
            если c == "\b"
                если длина(s["адрес_черновик"]) > 0
                    s["адрес_черновик"] = подстрока(s["адрес_черновик"], 0, длина(s["адрес_черновик"]) - 1)
                конец
            иначе
                s["адрес_черновик"] = s["адрес_черновик"] + c
            конец
            i = i + 1
        конец
    конец

    пусть wh = окно.колесо()
    если wh != 0
        пусть вкл = сессия.вкладка(s)
        вкл["scroll"] = макс(0, мин(вкл["высота"], вкл["scroll"] - wh * 40))
    конец

    пусть ctrl = окно.клавиша("ctrl")
    пусть cl = ctrl и окно.клавиша("l")
    если cl и не prev["ctrl_l"]
        s["фокус_адреса"] = истина
        s["адрес_черновик"] = s["адрес"]
    конец
    prev["ctrl_l"] = cl

    пусть ct = ctrl и окно.клавиша("t")
    если ct и не prev["ctrl_t"]
        если сессия.добавить_вкладку(s, "about:home")
            перейти(s, net, "about:home", истина, м)
        конец
    конец
    prev["ctrl_t"] = ct

    пусть f5 = окно.клавиша("f5")
    если f5 и не prev["f5"]
        перейти(s, net, сессия.вкладка(s)["url"], ложь, м)
    конец
    prev["f5"] = f5

    пусть ent = окно.клавиша("enter")
    если ent и не prev["enter"] и s["фокус_адреса"]
        s["фокус_адреса"] = ложь
        перейти(s, net, s["адрес_черновик"], истина, м)
    конец
    prev["enter"] = ent

    пусть esc = окно.клавиша("escape")
    если esc и не prev["esc"]
        если s["фокус_адреса"]
            s["фокус_адреса"] = ложь
            s["адрес_черновик"] = s["адрес"]
        иначе
            окно.закрыть()
        конец
    конец
    prev["esc"] = esc

    если окно.клик("лево")
        если клик_хрома(s, net, м, mx, my)
            аминь ничего
        конец
        если my >= м["контент_y"] и my < м["выс"] - м["статус_h"]
            s["фокус_адреса"] = ложь
            пусть href = вёрстка.ссылка_в(сессия.вкладка(s)["ссылки"], mx, my, сессия.вкладка(s)["scroll"], м["контент_y"])
            если href != ""
                перейти(s, net, href, истина, м)
            конец
        конец
    конец
конец

# лимит_кадров: 0 = бесконечно (обычный GUI), >0 = smoke-тест.
открой слово запустить(шир, выс, заголовок, лимит_кадров)
    окно.создать(шир, выс, заголовок)
    пусть м = метрика(шир, выс)
    пусть s = сессия.создать("about:home")
    пусть net = сеть.создать()
    пусть prev = {"enter": ложь, "f5": ложь, "ctrl_l": ложь, "ctrl_t": ложь, "esc": ложь}

    пусть r0 = сеть.начать(net, "about:home", истина)
    если r0["сейчас"]
        сессия.применить_документ(s, r0["url"], r0["html"], r0["код"], r0["сообщ"], r0["в_историю"], м["шир"], м["сим_w"], м["строка_h"])
    конец

    измени кадр_n = 0
    доколе окно.кадр()
        проверить_сеть(s, net, м)
        обработка_ввода(s, net, м, prev)
        окно.очистить(222, 225, 230)
        хром.нарисовать(s, м)
        кадр_n = кадр_n + 1
        если лимит_кадров > 0 и кадр_n >= лимит_кадров
            окно.закрыть()
        конец
        окно.задержка(16)
    конец
    аминь кадр_n
конец

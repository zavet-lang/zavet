# RequestServer / LibHTTP — загрузка ресурсов (async).
# Ladybird: UI не блокируется на сети; ответ приходит отдельно.

приими страницы из "./страницы.молитва"
приими url из "./url.молитва"

открой слово создать()
    аминь {
        "жду": ложь,
        "future": ничего,
        "url": "",
        "в_историю": ложь,
    }
конец

# Старт загрузки. Для about: сразу возвращает готовый документ.
# Для http: ставит future. → {"сейчас": истина/ложь, "url", "html", "код", "сообщ", "в_историю"}
открой слово начать(состояние, raw_url, в_историю)
    если состояние["жду"]
        аминь {"сейчас": ложь, "занято": истина}
    конец
    пусть u = url.нормализовать(raw_url)
    если u == ""
        аминь {"сейчас": ложь, "пусто": истина}
    конец

    если u == "about:home" или u == "about://"
        аминь {"сейчас": истина, "url": "about:home", "html": страницы.дом(), "код": 200, "сообщ": "Домашняя", "в_историю": в_историю}
    конец
    если u == "about:blank"
        аминь {"сейчас": истина, "url": "about:blank", "html": страницы.пустая(), "код": 200, "сообщ": "Пусто", "в_историю": в_историю}
    конец
    если u == "about:example"
        аминь {"сейчас": истина, "url": "about:example", "html": страницы.пример(), "код": 200, "сообщ": "Офлайн", "в_историю": в_историю}
    конец

    состояние["жду"] = истина
    состояние["url"] = u
    состояние["в_историю"] = в_историю
    состояние["future"] = асинх http.получить(u)
    аминь {"сейчас": ложь, "сеть": истина, "url": u}
конец

# Опрос готовности. → ничего или документ {url, html, код, сообщ, в_историю}
открой слово опрос(состояние)
    если не состояние["жду"] или состояние["future"] == ничего
        аминь ничего
    конец
    если не готово(состояние["future"])
        аминь ничего
    конец
    пусть отв = ждать состояние["future"]
    измени u = состояние["url"]
    измени в_историю = состояние["в_историю"]
    измени html = ""
    измени код = 0
    измени сообщ = "Сеть: ошибка"
    попытка
        если тип(отв) == "ERROR" или тип(отв) == "ERROR_VALUE"
            html = страницы.ошибка(u, "" + отв)
        иначе
            код = отв["статус"]
            html = отв["тело"]
            если отв["url"] != ничего и отв["url"] != ""
                u = отв["url"]
            конец
            сообщ = "HTTP " + код
            если код >= 400
                html = страницы.ошибка(u, "Код ответа " + код)
            конец
        конец
    поймать e
        html = страницы.ошибка(u, "" + e)
        сообщ = "Сеть: ошибка"
    конец
    состояние["жду"] = ложь
    состояние["future"] = ничего
    аминь {"url": u, "html": html, "код": код, "сообщ": сообщ, "в_историю": в_историю}
конец
